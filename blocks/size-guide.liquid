{% doc %}
  Renders a "Size guide" link on the product page that opens a side drawer
  with a built-in ring size chart, a page's content and / or custom text.

  @example
  {% content_for 'block', type: 'size-guide', id: 'size-guide' %}
{% enddoc %}

{%- liquid
  assign drawer_id = 'SizeGuide-' | append: block.id
  assign title_id = 'SizeGuideTitle-' | append: block.id
  assign guide_page = block.settings.page

  # Only show on products sold in sizes (a "Size" / "Ring size" option), unless disabled
  assign show_guide = true
  if block.settings.only_sized_products and request.design_mode == false
    assign option_names = closest.product.options | join: ',' | downcase
    unless option_names contains 'size' or option_names contains 'מידה'
      assign show_guide = false
    endunless
  endif

  # US size, UK size, inside diameter (mm), inside circumference / EU size (mm)
  assign ring_sizes = '4|H|14.9|46.8,5|J½|15.7|49.3,6|L½|16.5|51.9,7|O|17.3|54.4,8|Q|18.1|57.0,9|S|18.9|59.5,10|U|19.8|62.1,11|W|20.6|64.6' | split: ','
-%}

{%- if show_guide -%}
<div class="size-guide" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="size-guide__trigger"
    data-drawer-open="{{ drawer_id }}"
    aria-haspopup="dialog"
    aria-controls="{{ drawer_id }}"
  >
    <svg class="icon size-guide__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M2.5 7.5h15v5h-15z M5.5 7.5v2.5 M8.5 7.5v1.5 M11.5 7.5v2.5 M14.5 7.5v1.5" />
    </svg>
    <span>{{ block.settings.label | escape }}</span>
  </button>

  <side-drawer id="{{ drawer_id }}">
    <dialog class="side-drawer size-guide__drawer" aria-labelledby="{{ title_id }}" scroll-lock>
      <div class="side-drawer__inner">
        <div class="side-drawer__header">
          <h2 id="{{ title_id }}" class="side-drawer__title">{{ block.settings.label | escape }}</h2>
          <button type="button" class="side-drawer__close" data-drawer-close>
            {% render 'icon', name: 'close' %}
            <span class="visually-hidden">{{ 'product.size_guide.close' | t }}</span>
          </button>
        </div>

        <div class="side-drawer__body size-guide__body">
          {%- if block.settings.show_ring_chart -%}
            <section class="size-guide__section" aria-labelledby="{{ title_id }}-rings">
              <h3 id="{{ title_id }}-rings" class="size-guide__heading">{{ 'product.size_guide.rings_title' | t }}</h3>
              <div class="size-guide__table-wrap">
                <table class="size-guide__table">
                  <thead>
                    <tr>
                      <th scope="col">{{ 'product.size_guide.us' | t }}</th>
                      <th scope="col">{{ 'product.size_guide.uk' | t }}</th>
                      <th scope="col">{{ 'product.size_guide.eu' | t }}</th>
                      <th scope="col">{{ 'product.size_guide.diameter' | t }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {%- for row in ring_sizes -%}
                      {%- assign cells = row | split: '|' -%}
                      <tr>
                        <th scope="row">{{ cells[0] }}</th>
                        <td>{{ cells[1] }}</td>
                        <td>{{ cells[3] | round }}</td>
                        <td>{{ cells[2] }}</td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
              </div>

              <ol class="size-guide__steps">
                <li>{{ 'product.size_guide.step_1' | t }}</li>
                <li>{{ 'product.size_guide.step_2' | t }}</li>
                <li>{{ 'product.size_guide.step_3' | t }}</li>
              </ol>
            </section>
          {%- endif -%}

          {%- if block.settings.content != blank -%}
            <div class="rte size-guide__section">{{ block.settings.content }}</div>
          {%- endif -%}

          {%- if guide_page != blank -%}
            <div class="rte size-guide__section">{{ guide_page.content }}</div>
          {%- endif -%}
        </div>
      </div>
    </dialog>
  </side-drawer>
</div>
{%- endif -%}

{% stylesheet %}
  .size-guide__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentcolor 35%, transparent);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .size-guide__trigger:hover {
    text-decoration-color: var(--color-accent);
  }

  .size-guide__trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .size-guide__icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .size-guide__drawer {
    width: min(34rem, 100vw);
  }

  .size-guide__body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-block: 1.5rem 2rem;
  }

  .size-guide__section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .size-guide__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    font-weight: var(--font-heading--weight);
  }

  .size-guide__table-wrap {
    overflow-x: auto;
  }

  .size-guide__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .size-guide__table :is(th, td) {
    padding: 0.625rem 0.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    text-align: center;
  }

  .size-guide__table thead th {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .size-guide__table tbody th {
    font-weight: 500;
  }

  .size-guide__table tbody tr:nth-child(odd) {
    background-color: color-mix(in srgb, var(--color-foreground) 3%, transparent);
  }

  .size-guide__steps {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-inline-start: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.6;
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.size_guide.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.link_label",
      "default": "Size guide"
    },
    {
      "type": "checkbox",
      "id": "only_sized_products",
      "label": "t:blocks.size_guide.only_sized_products",
      "info": "t:blocks.size_guide.only_sized_products_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ring_chart",
      "label": "t:blocks.size_guide.show_ring_chart",
      "default": true
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:labels.text"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:general.page",
      "info": "t:blocks.size_guide.page_info"
    }
  ],
  "presets": [{ "name": "t:blocks.size_guide.name" }]
}
{% endschema %}
