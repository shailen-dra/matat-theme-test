{% doc %}
  Renders a product details table (metal, stones, weight, dimensions…) from
  nested rows. Each row's value can be connected to a product metafield.

  @example
  {% content_for 'block', type: 'product-specs', id: 'specs' %}
{% enddoc %}

{%- capture rows -%}{% content_for 'blocks' %}{%- endcapture -%}

{%- if rows != blank -%}
  <div class="specs {{ block.settings.style }}" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="specs__heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}
    <dl class="specs__list">{{ rows }}</dl>
  </div>
{%- elsif request.design_mode -%}
  <div class="specs" {{ block.shopify_attributes }}></div>
{%- endif -%}

{% stylesheet %}
  .specs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .specs__heading {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  [dir='rtl'] .specs__heading {
    letter-spacing: 0;
  }

  .specs__list {
    margin: 0;
  }

  .specs__row {
    display: grid;
    grid-template-columns: minmax(7rem, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    font-size: 0.9375rem;
  }

  .specs__row:first-child {
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .specs__label {
    opacity: 0.65;
  }

  .specs__value {
    margin: 0;
  }

  /* Boxed style: a tinted card with no outer rules */
  .specs--boxed {
    padding: 1.25rem 1.5rem;
    border-radius: var(--style-border-radius-buttons);
    background-color: color-mix(in srgb, var(--color-foreground) 4%, var(--color-background));
  }

  .specs--boxed .specs__row:first-child {
    border-top: 0;
  }

  .specs--boxed .specs__row:last-child {
    border-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.product_specs.name",
  "blocks": [{ "type": "_spec-row" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Details"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:labels.style",
      "options": [
        { "value": "specs--lines", "label": "t:blocks.product_specs.style_lines" },
        { "value": "specs--boxed", "label": "t:blocks.product_specs.style_boxed" }
      ],
      "default": "specs--lines"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_specs.name",
      "blocks": [
        { "type": "_spec-row", "settings": { "label": "Metal", "value": "14k recycled gold" } },
        { "type": "_spec-row", "settings": { "label": "Stone", "value": "Conflict-free diamond" } },
        { "type": "_spec-row", "settings": { "label": "Weight", "value": "2.1 g" } },
        { "type": "_spec-row", "settings": { "label": "Made in", "value": "Our studio, by hand" } }
      ]
    }
  ]
}
{% endschema %}
