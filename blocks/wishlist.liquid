{% doc %}
  Renders an "Add to wishlist" button for the closest product, for the
  product page and featured product sections.

  @example
  {% content_for 'block', type: 'wishlist', id: 'wishlist' %}
{% enddoc %}

{%- assign product = closest.product -%}

{%- if product != blank -%}
  <div class="wishlist-block" {{ block.shopify_attributes }}>
    {% render 'wishlist-button', product: product, style: 'button' %}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.wishlist.name",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:blocks.wishlist.name",
      "category": "t:general.product"
    }
  ]
}
{% endschema %}
