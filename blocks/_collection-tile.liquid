{% doc %}
  Renders one tile of the Collection tiles section: an image (or a metal-style
  swatch) with a label, linking to a collection.

  Falls back to the collection's image, then to demo photography picked from
  the tile title, so the section looks finished before images are uploaded.
{% enddoc %}

{%- liquid
  assign collection = block.settings.collection
  assign placeholder_title = 'sections.collection_tiles.placeholder_title' | t
  assign title = block.settings.title | default: collection.title | default: placeholder_title
  assign url = block.settings.link | default: collection.url | default: routes.all_products_collection_url
  assign image = block.settings.image | default: collection.featured_image
  assign swatch = block.settings.swatch
  assign image_style = 'object-position: ' | append: image.presentation.focal_point

  # Shopify's collection placeholders (collection-1 to collection-6) until an image is picked
  assign placeholder_number = section.blocks | find_index: 'id', block.id | default: 0 | modulo: 6 | plus: 1
  assign placeholder = 'collection-' | append: placeholder_number
-%}

<a href="{{ url }}" class="tile" {{ block.shopify_attributes }}>
  <span class="tile__media"{% if swatch != blank %} style="--tile-swatch: {{ swatch }};"{% endif %}>
    {%- if swatch != blank -%}
      <span class="tile__swatch" aria-hidden="true"></span>
    {%- elsif image != blank -%}
      {{
        image
        | image_url: width: 900
        | image_tag:
          widths: '240, 360, 480, 600, 750, 900',
          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 45vw',
          loading: 'lazy',
          class: 'tile__image',
          style: image_style,
          alt: ''
      }}
    {%- else -%}
      {{ placeholder | placeholder_svg_tag: 'tile__image placeholder-svg' }}
    {%- endif -%}
  </span>
  <span class="tile__label">
    <span class="tile__title">{{ title }}</span>
    {%- if block.settings.caption != blank -%}
      <span class="tile__caption">{{ block.settings.caption }}</span>
    {%- endif -%}
  </span>
</a>

{% schema %}
{
  "name": "t:blocks.collection_tile.name",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:labels.heading",
      "info": "t:blocks.collection_tile.title_info"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:blocks.collection_tile.caption"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link",
      "info": "t:blocks.collection_tile.link_info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:blocks.collection_tile.image_info"
    },
    {
      "type": "color_background",
      "id": "swatch",
      "label": "t:blocks.collection_tile.swatch",
      "info": "t:blocks.collection_tile.swatch_info"
    }
  ],
  "presets": [{ "name": "t:blocks.collection_tile.name" }]
}
{% endschema %}
