{% doc %}
  Renders a rich text block: paragraphs, links, bold/italic and lists.

  @example
  {% content_for 'block', type: 'text', id: 'text' %}
{% enddoc %}

<div
  class="rte text {{ block.settings.size }}{% if block.settings.muted %} text--muted{% endif %}"
  style="
    --text-align: {{ block.settings.alignment }};
    --text-max-width: {% if block.settings.max_width > 0 %}{{ block.settings.max_width }}ch{% else %}none{% endif %};
  "
  {{ block.shopify_attributes }}
>
  {{ block.settings.text }}
</div>

{% stylesheet %}
  .text {
    max-width: var(--text-max-width);
    color: var(--color-foreground);
    text-align: var(--text-align);
    line-height: 1.7;
  }

  .text--small {
    font-size: 0.875rem;
  }

  .text--body {
    font-size: 1rem;
  }

  .text--large {
    font-size: 1.125rem;
  }

  .text--muted {
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Share a short story about your brand, a product, or a promise to your customers.</p>"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:labels.size",
      "options": [
        { "value": "text--small", "label": "t:options.size.small" },
        { "value": "text--body", "label": "t:options.size.medium" },
        { "value": "text--large", "label": "t:options.size.large" }
      ],
      "default": "text--body"
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "t:blocks.text.muted",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "options": [
        { "value": "inherit", "label": "t:options.alignment.inherit" },
        { "value": "start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "end", "label": "t:options.alignment.right" }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:labels.max_width",
      "info": "t:blocks.heading.max_width_info",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "ch",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.text",
      "category": "t:general.text"
    }
  ]
}
{% endschema %}
