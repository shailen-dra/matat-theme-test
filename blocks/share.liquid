{% doc %}
  Renders a "Share" button for the current product (or page). Opens the
  device's share sheet where supported, and otherwise copies the link and
  confirms it.

  @example
  {% content_for 'block', type: 'share', id: 'share' %}
{% enddoc %}

{%- liquid
  assign product = closest.product
  if product != blank
    assign share_url = shop.url | append: product.url
    assign share_title = product.title
  else
    assign share_url = canonical_url
    assign share_title = page_title
  endif
-%}

<share-button
  class="share"
  data-url="{{ share_url }}"
  data-title="{{ share_title | escape }}"
  {{ block.shopify_attributes }}
>
  <button type="button" class="share__button" data-share>
    <svg class="icon share__icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path d="M10 2.5v10M6.5 6L10 2.5 13.5 6M4.5 10v6.5h11V10" />
    </svg>
    <span>{{ block.settings.label | escape }}</span>
  </button>
  <span class="share__status" role="status" data-share-status data-copied="{{ 'general.share.copied' | t | escape }}"></span>
</share-button>

{% stylesheet %}
  .share {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .share__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .share__button:hover span {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
  }

  .share__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .share__icon {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .share__status {
    font-size: 0.8125rem;
    color: var(--color-accent);
  }
{% endstylesheet %}

{% javascript %}
  /* Share button: native share sheet, or copy the link as a fallback */
  class ShareButton extends HTMLElement {
    connectedCallback() {
      this.querySelector('[data-share]')?.addEventListener('click', this.onClick);
      this.status = this.querySelector('[data-share-status]');
    }

    onClick = async () => {
      const data = { title: this.dataset.title, url: this.dataset.url };
      if (navigator.share && (!navigator.canShare || navigator.canShare(data))) {
        try {
          await navigator.share(data);
          return;
        } catch (error) {
          if (error.name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(data.url);
        this.status.textContent = this.status.dataset.copied;
        clearTimeout(this.timer);
        this.timer = setTimeout(() => (this.status.textContent = ''), 3000);
      } catch {
        window.prompt('', data.url);
      }
    };
  }

  if (!customElements.get('share-button')) {
    customElements.define('share-button', ShareButton);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:blocks.share.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:labels.label",
      "default": "Share"
    }
  ],
  "presets": [{ "name": "t:blocks.share.name" }]
}
{% endschema %}
