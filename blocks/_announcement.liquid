{% doc %}
  Renders one message of the announcement bar, optionally linked.

  @example
  {% content_for 'block', type: '_announcement', id: 'announcement-1' %}
{% enddoc %}

<div class="announcement" data-announcement {{ block.shopify_attributes }}>
  {%- if block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" class="announcement__text announcement__link">{{ block.settings.text }}</a>
  {%- else -%}
    <p class="announcement__text">{{ block.settings.text }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.announcement_bar.announcement",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "Free insured shipping on orders over $150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [{ "name": "t:sections.announcement_bar.announcement" }]
}
{% endschema %}
