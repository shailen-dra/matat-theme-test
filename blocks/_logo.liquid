{% doc %}
  Renders one logo of the press logos section, optionally linked. Without
  an image it shows the publication name as a text wordmark.

  @example
  {% content_for 'block', type: '_logo', id: 'logo-1' %}
{% enddoc %}

{%- liquid
  assign name = block.settings.name | escape
  if block.settings.link != blank
    assign tag = 'a'
  else
    assign tag = 'div'
  endif
-%}

<{{ tag }}
  class="press-logo"
  {% if block.settings.link != blank %}
    href="{{ block.settings.link }}"
    target="_blank"
    rel="noopener"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image != blank -%}
    {{
      block.settings.image
      | image_url: width: 480
      | image_tag: widths: '160, 240, 320, 480', sizes: '160px', loading: 'lazy', class: 'press-logo__image', alt: name
    }}
  {%- else -%}
    <span class="press-logo__wordmark">{{ name }}</span>
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .press-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    color: inherit;
    text-decoration: none;
    opacity: 0.55;
    transition: opacity 0.25s ease;
  }

  a.press-logo:hover,
  a.press-logo:focus-visible {
    opacity: 1;
  }

  a.press-logo:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .press-logo__image {
    width: auto;
    max-width: 100%;
    height: var(--press-logo-height, 32px);
    object-fit: contain;
    filter: grayscale(1);
  }

  .press-logo__wordmark {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-style: italic;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.press_logos.logo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:sections.press_logos.image_info"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:sections.press_logos.publication",
      "info": "t:sections.press_logos.publication_info",
      "default": "Publication"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [{ "name": "t:sections.press_logos.logo" }]
}
{% endschema %}
