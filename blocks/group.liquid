{% doc %}
  Renders a group of blocks with configurable layout direction, gap and
  alignment.

  All settings apply to only one dimension to reduce configuration complexity.

  This component is a wrapper concerned only with rendering its children in
  the specified layout direction with appropriate padding and alignment.
  Rows wrap on small screens, so it doubles as a button / tag row.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

<div
  class="group {{ block.settings.layout_direction }}"
  style="
    --padding: {{ block.settings.padding }}px;
    --group-gap: {{ block.settings.gap }}px;
    {% if block.settings.alignment != 'auto' %}--group-alignment: {{ block.settings.alignment }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .group {
    --alignment: var(--group-alignment, var(--content-justify, flex-start));

    display: flex;
    gap: var(--group-gap);
    width: 100%;
  }

  .group--horizontal {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: var(--alignment);
    align-items: center;
    padding: 0 var(--padding);
  }

  .group--vertical {
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: var(--alignment);
    padding: var(--padding) 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.group",
  "tag": null,
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "t:labels.layout_direction",
      "default": "group--vertical",
      "options": [
        { "value": "group--horizontal", "label": "t:options.direction.horizontal" },
        { "value": "group--vertical", "label": "t:options.direction.vertical" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "t:options.alignment.inherit" },
        { "value": "flex-start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "flex-end", "label": "t:options.alignment.right" },
        { "value": "space-between", "label": "t:options.alignment.space_between" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:labels.gap",
      "default": 16,
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:labels.padding",
      "default": 0,
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:general.column",
      "category": "t:general.layout",
      "settings": {
        "layout_direction": "group--vertical",
        "padding": 0
      }
    },
    {
      "name": "t:general.row",
      "category": "t:general.layout",
      "settings": {
        "layout_direction": "group--horizontal",
        "padding": 0
      }
    },
    {
      "name": "t:blocks.group.presets.buttons",
      "category": "t:general.links",
      "settings": {
        "layout_direction": "group--horizontal",
        "gap": 12
      },
      "blocks": [
        { "type": "button", "settings": { "label": "Shop the collection", "style": "primary" } },
        { "type": "button", "settings": { "label": "Our story", "style": "link" } }
      ]
    }
  ]
}
{% endschema %}
