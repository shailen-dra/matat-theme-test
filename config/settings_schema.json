[
  {
    "name": "theme_info",
    "theme_name": "Matat",
    "theme_version": "1.0.0",
    "theme_author": "Matat",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:settings.favicon.group",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.favicon.label",
        "info": "t:settings.favicon.info"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "jost_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_n5",
        "label": "t:labels.heading_font"
      },
      {
        "type": "header",
        "content": "t:general.hebrew_fonts",
        "info": "t:general.hebrew_fonts_info"
      },
      {
        "type": "select",
        "id": "hebrew_heading_font",
        "label": "t:labels.heading_font",
        "default": "Frank Ruhl Libre",
        "options": [
          {
            "value": "Frank Ruhl Libre",
            "label": "Frank Ruhl Libre"
          },
          {
            "value": "David Libre",
            "label": "David Libre"
          },
          {
            "value": "Noto Serif Hebrew",
            "label": "Noto Serif Hebrew"
          },
          {
            "value": "Assistant",
            "label": "Assistant"
          }
        ]
      },
      {
        "type": "select",
        "id": "hebrew_body_font",
        "label": "t:labels.body_font",
        "default": "Assistant",
        "options": [
          {
            "value": "Assistant",
            "label": "Assistant"
          },
          {
            "value": "Heebo",
            "label": "Heebo"
          },
          {
            "value": "Rubik",
            "label": "Rubik"
          },
          {
            "value": "Noto Sans Hebrew",
            "label": "Noto Sans Hebrew"
          }
        ]
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "checkbox",
        "id": "back_to_top",
        "label": "t:settings.layout.back_to_top",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:labels.background",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings.colors.background_gradient",
            "info": "t:settings.colors.background_gradient_info"
          },
          {
            "type": "color",
            "id": "foreground",
            "label": "t:labels.foreground",
            "default": "#333333"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "t:labels.accent",
            "default": "#83673D"
          }
        ],
        "role": {
          "text": "foreground",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "accent",
          "icons": "accent",
          "primary_button": "foreground",
          "on_primary_button": "background",
          "primary_button_border": "foreground",
          "secondary_button": "background",
          "on_secondary_button": "foreground",
          "secondary_button_border": "foreground"
        }
      },
      {
        "type": "color_scheme",
        "id": "body_color_scheme",
        "label": "t:settings.colors.body_scheme",
        "info": "t:settings.colors.body_scheme_info",
        "default": "scheme-1"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:settings.animations.group",
    "settings": [
      {
        "type": "checkbox",
        "id": "reveal_on_scroll",
        "label": "t:settings.animations.reveal_on_scroll",
        "info": "t:settings.animations.reveal_on_scroll_info",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.buttons",
    "settings": [
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.product_cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_quick_add",
        "label": "t:settings.product_cards.enable_quick_add",
        "info": "t:settings.product_cards.enable_quick_add_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_swatches",
        "label": "t:settings.product_cards.card_swatches",
        "info": "t:settings.product_cards.card_swatches_info",
        "default": true
      },
      {
        "type": "header",
        "content": "t:settings.product_cards.badges"
      },
      {
        "type": "range",
        "id": "new_badge_days",
        "label": "t:settings.product_cards.new_badge_days",
        "info": "t:settings.product_cards.new_badge_days_info",
        "min": 0,
        "max": 90,
        "step": 5,
        "unit": "d",
        "default": 30
      },
      {
        "type": "paragraph",
        "content": "t:settings.product_cards.custom_badges_info"
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart.cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:settings.cart.drawer"
          },
          {
            "value": "page",
            "label": "t:settings.cart.page"
          }
        ],
        "default": "drawer",
        "info": "t:settings.cart.cart_type_info"
      },
      {
        "type": "checkbox",
        "id": "show_discount_code",
        "label": "t:settings.cart.show_discount_code",
        "info": "t:settings.cart.show_discount_code_info",
        "default": true
      },
      {
        "type": "header",
        "content": "t:settings.cart.free_shipping"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "t:settings.cart.free_shipping_threshold",
        "info": "t:settings.cart.free_shipping_threshold_info",
        "default": 150
      },
      {
        "type": "header",
        "content": "t:settings.cart.upsell"
      },
      {
        "type": "checkbox",
        "id": "cart_upsell",
        "label": "t:settings.cart.upsell_enable",
        "info": "t:settings.cart.upsell_info",
        "default": true
      },
      {
        "type": "header",
        "content": "t:settings.cart.gift_wrap"
      },
      {
        "type": "product",
        "id": "gift_wrap_product",
        "label": "t:settings.cart.gift_wrap_product",
        "info": "t:settings.cart.gift_wrap_product_info"
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "t:general.social.instagram"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "t:general.social.facebook"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "t:general.social.pinterest"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "t:general.social.tiktok"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "t:general.social.youtube"
      },
      {
        "type": "text",
        "id": "social_whatsapp_link",
        "label": "t:general.social.whatsapp"
      },
      {
        "type": "text",
        "id": "social_x_link",
        "label": "t:general.social.x"
      }
    ]
  }
]
