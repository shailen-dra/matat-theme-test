[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "jost_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_n5",
        "label": "t:labels.heading_font"
      },
      {
        "type": "header",
        "content": "t:general.hebrew_fonts",
        "info": "t:general.hebrew_fonts_info"
      },
      {
        "type": "select",
        "id": "hebrew_heading_font",
        "label": "t:labels.heading_font",
        "default": "Frank Ruhl Libre",
        "options": [
          {
            "value": "Frank Ruhl Libre",
            "label": "Frank Ruhl Libre"
          },
          {
            "value": "David Libre",
            "label": "David Libre"
          },
          {
            "value": "Noto Serif Hebrew",
            "label": "Noto Serif Hebrew"
          },
          {
            "value": "Assistant",
            "label": "Assistant"
          }
        ]
      },
      {
        "type": "select",
        "id": "hebrew_body_font",
        "label": "t:labels.body_font",
        "default": "Assistant",
        "options": [
          {
            "value": "Assistant",
            "label": "Assistant"
          },
          {
            "value": "Heebo",
            "label": "Heebo"
          },
          {
            "value": "Rubik",
            "label": "Rubik"
          },
          {
            "value": "Noto Sans Hebrew",
            "label": "Noto Sans Hebrew"
          }
        ]
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#B08D57",
        "label": "t:labels.accent"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.buttons",
    "settings": [
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 0
      }
    ]
  }
]
