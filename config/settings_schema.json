[
  {
    "name": "theme_info",
    "theme_name": "Matat",
    "theme_version": "1.0.0",
    "theme_author": "Matat",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:settings.favicon.group",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.favicon.label",
        "info": "t:settings.favicon.info"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "jost_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_n5",
        "label": "t:labels.heading_font"
      },
      {
        "type": "header",
        "content": "t:general.hebrew_fonts",
        "info": "t:general.hebrew_fonts_info"
      },
      {
        "type": "select",
        "id": "hebrew_heading_font",
        "label": "t:labels.heading_font",
        "default": "Frank Ruhl Libre",
        "options": [
          {
            "value": "Frank Ruhl Libre",
            "label": "Frank Ruhl Libre"
          },
          {
            "value": "David Libre",
            "label": "David Libre"
          },
          {
            "value": "Noto Serif Hebrew",
            "label": "Noto Serif Hebrew"
          },
          {
            "value": "Assistant",
            "label": "Assistant"
          }
        ]
      },
      {
        "type": "select",
        "id": "hebrew_body_font",
        "label": "t:labels.body_font",
        "default": "Assistant",
        "options": [
          {
            "value": "Assistant",
            "label": "Assistant"
          },
          {
            "value": "Heebo",
            "label": "Heebo"
          },
          {
            "value": "Rubik",
            "label": "Rubik"
          },
          {
            "value": "Noto Sans Hebrew",
            "label": "Noto Sans Hebrew"
          }
        ]
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#886B40",
        "label": "t:labels.accent"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.buttons",
    "settings": [
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "t:general.product_cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_quick_add",
        "label": "t:settings.product_cards.enable_quick_add",
        "info": "t:settings.product_cards.enable_quick_add_info",
        "default": true
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart.cart_type",
        "options": [
          {
            "value": "drawer",
            "label": "t:settings.cart.drawer"
          },
          {
            "value": "page",
            "label": "t:settings.cart.page"
          }
        ],
        "default": "drawer",
        "info": "t:settings.cart.cart_type_info"
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "t:general.social.instagram",
        "placeholder": "https://instagram.com/"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "t:general.social.facebook",
        "placeholder": "https://facebook.com/"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "t:general.social.pinterest",
        "placeholder": "https://pinterest.com/"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "t:general.social.tiktok",
        "placeholder": "https://tiktok.com/@"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "t:general.social.youtube",
        "placeholder": "https://youtube.com/@"
      },
      {
        "type": "text",
        "id": "social_whatsapp_link",
        "label": "t:general.social.whatsapp",
        "placeholder": "https://wa.me/972"
      },
      {
        "type": "text",
        "id": "social_x_link",
        "label": "t:general.social.x",
        "placeholder": "https://x.com/"
      }
    ]
  }
]
