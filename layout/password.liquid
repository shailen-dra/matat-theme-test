<!doctype html>
{%- liquid
  assign rtl_locales = 'he,ar,fa,ur' | split: ','
  assign text_direction = 'ltr'
  if rtl_locales contains request.locale.iso_code
    assign text_direction = 'rtl'
  endif
-%}
<html lang="{{ request.locale.iso_code }}" dir="{{ text_direction }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}
    {% render 'hebrew-fonts' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {{ content_for_layout }}
  </body>
</html>
