{% doc %}
  Renders the wishlist drawer once per page. Opens from the header heart
  (`data-drawer-open="WishlistDrawer"`) and lists the saved products, loaded
  on open as `wishlist-drawer-item` sections, with quick add and a heart to
  remove each one. Uses the `.side-drawer` styles from the cart drawer.

  @param {string} [wishlist_url] - URL of the full wishlist page

  @example
  {% render 'wishlist-drawer', wishlist_url: '/pages/wishlist' %}
{% enddoc %}

<side-drawer id="WishlistDrawer">
  <dialog class="side-drawer" aria-labelledby="WishlistDrawerTitle" scroll-lock>
    <wishlist-drawer class="side-drawer__inner">
      <div class="side-drawer__header">
        <h2 id="WishlistDrawerTitle" class="side-drawer__title">
          {{- 'wishlist.title' | t -}}
          <span class="side-drawer__count" data-wishlist-drawer-count></span>
        </h2>
        <button type="button" class="side-drawer__close" data-drawer-close>
          {% render 'icon', name: 'close' %}
          <span class="visually-hidden">{{ 'wishlist.close' | t }}</span>
        </button>
      </div>

      <ul class="side-drawer__body drawer-items wishlist-drawer__list" role="list" data-wishlist-drawer-items></ul>

      <div class="side-drawer__body side-drawer__empty" data-wishlist-drawer-empty hidden>
        <span class="side-drawer__empty-icon">{% render 'icon', name: 'heart' %}</span>
        <p class="heading heading--h3">{{ 'wishlist.empty_title' | t }}</p>
        <p class="side-drawer__empty-text">{{ 'wishlist.empty_text' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
          {{- 'wishlist.empty_button' | t -}}
        </a>
      </div>

      <div class="side-drawer__body side-drawer__empty" data-wishlist-drawer-loading hidden>
        <span class="wishlist-drawer__spinner" aria-hidden="true"></span>
        <span class="visually-hidden">{{ 'product.quick_view.loading' | t }}</span>
      </div>

      <div class="side-drawer__footer" data-wishlist-drawer-footer hidden>
        <a href="{{ wishlist_url }}" class="button button--outline button--full">
          {{- 'wishlist.view_all' | t -}}
        </a>
      </div>
    </wishlist-drawer>
  </dialog>
</side-drawer>

{% stylesheet %}
  .wishlist-drawer__list:empty,
  [data-wishlist-drawer-empty][hidden],
  [data-wishlist-drawer-loading][hidden],
  [data-wishlist-drawer-footer][hidden] {
    display: none;
  }

  /* The heart sits next to the title; keep it compact */
  .drawer-item .wishlist-button--icon .wishlist-button__toggle {
    width: 2rem;
    height: 2rem;
    margin-block-start: -0.25rem;
    margin-inline-end: -0.375rem;
    background: none;
    backdrop-filter: none;
  }

  /* Quick add as a small outlined button with its label, also on touch screens */
  .drawer-item .quick-add__button {
    width: auto;
    height: auto;
    padding: 0.625rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 30%, transparent);
    border-radius: var(--style-border-radius-buttons);
    background: none;
    backdrop-filter: none;
    font-size: 0.6875rem;
  }

  .drawer-item .quick-add__button:hover,
  .drawer-item .quick-add__button.is-added {
    border-color: var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .drawer-item .quick-add__text {
    position: static;
    width: auto;
    height: auto;
    overflow: visible;
    clip: auto;
  }

  .drawer-item .quick-add__icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .wishlist-drawer__spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
    border-top-color: var(--color-accent);
    border-radius: 50%;
    animation: quick-view-spin 0.8s linear infinite;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Lists the saved products in the wishlist drawer. Rows are fetched when
   * the drawer opens (and cached), and removed in place when a heart is
   * toggled off.
   */
  class WishlistDrawer extends HTMLElement {
    connectedCallback() {
      this.list = this.querySelector('[data-wishlist-drawer-items]');
      this.empty = this.querySelector('[data-wishlist-drawer-empty]');
      this.loading = this.querySelector('[data-wishlist-drawer-loading]');
      this.footer = this.querySelector('[data-wishlist-drawer-footer]');
      this.count = this.querySelector('[data-wishlist-drawer-count]');
      this.cache = new Map();

      this.closest('side-drawer')?.addEventListener('drawer:open', this.render);
      document.addEventListener('wishlist:change', this.onChange);
    }

    disconnectedCallback() {
      document.removeEventListener('wishlist:change', this.onChange);
    }

    get isOpen() {
      return this.closest('dialog')?.open;
    }

    onChange = () => {
      if (!this.isOpen) return;
      const handles = window.Wishlist.get();
      const shown = [...this.list.querySelectorAll('[data-wishlist-item]')];
      if (handles.some((handle) => !shown.some((row) => row.dataset.wishlistItem === handle))) {
        this.render();
        return;
      }
      shown
        .filter((row) => !handles.includes(row.dataset.wishlistItem))
        .forEach((row) => {
          row.classList.add('is-removing');
          setTimeout(() => {
            row.remove();
            this.updateState();
          }, 300);
        });
    };

    render = async () => {
      const handles = window.Wishlist.get();
      const uncached = handles.filter((handle) => !this.cache.has(handle));
      if (uncached.length) {
        this.list.replaceChildren();
        this.empty.hidden = true;
        this.footer.hidden = true;
        this.loading.hidden = false;
      }

      const root = window.Shopify?.routes?.root ?? '/';
      await Promise.all(
        uncached.map(async (handle) => {
          try {
            const response = await fetch(`${root}products/${encodeURIComponent(handle)}?section_id=wishlist-drawer-item`);
            if (response.status === 404) {
              this.cache.set(handle, null);
              return;
            }
            if (!response.ok) return;
            const html = new DOMParser().parseFromString(await response.text(), 'text/html');
            const row = html.querySelector('[data-wishlist-item]');
            if (row) this.cache.set(handle, row.outerHTML);
          } catch (error) {
            console.error(error);
          }
        })
      );

      // Forget products that no longer exist
      const missing = handles.filter((handle) => this.cache.get(handle) === null);
      if (missing.length) window.Wishlist.set(handles.filter((handle) => !missing.includes(handle)));

      const template = document.createElement('template');
      template.innerHTML = window.Wishlist.get()
        .map((handle) => this.cache.get(handle))
        .filter(Boolean)
        .join('');
      this.list.replaceChildren(template.content);
      this.loading.hidden = true;
      this.updateState();
    };

    updateState() {
      const count = this.list.querySelectorAll('[data-wishlist-item]').length;
      this.empty.hidden = count > 0;
      this.footer.hidden = count === 0;
      this.count.textContent = count > 0 ? `(${count})` : '';
    }
  }

  if (!customElements.get('wishlist-drawer')) {
    customElements.define('wishlist-drawer', WishlistDrawer);
  }
{% endjavascript %}
