{% doc %}
  Renders the intro above a content section: eyebrow, title, subtitle and an
  optional "view all" link. Reuses the heading and button styles so every
  section intro matches the Heading block.

  With `alignment: 'split'` the title sits at the start and the link at the
  end of the same row (stacks on mobile).

  Theme settings → Style → Section headings set to Chapter overrides the
  alignment: each heading opens with a full-width rule and a running number
  (01, 02 …) counted down the page, beside the eyebrow.

  @param {string} [eyebrow] - Small uppercase line above the title
  @param {string} [title] - Section title (inline rich text)
  @param {string} [subtitle] - Supporting line below the title
  @param {string} [link_label] - Label of the "view all" link
  @param {string} [link_url] - Destination of the "view all" link
  @param {string} [alignment] - `start`, `center` (default) or `split`
  @param {string} [title_style] - Heading style class (default `heading--h2`)
  @param {string} [title_tag] - Heading element, `h1` when it's the page title (default `h2`)

  @example
  {% render 'section-heading',
    eyebrow: section.settings.eyebrow,
    title: section.settings.title,
    subtitle: section.settings.subtitle,
    link_label: section.settings.link_label,
    link_url: section.settings.link_url,
    alignment: section.settings.heading_alignment
  %}
{% enddoc %}

{%- liquid
  assign alignment = alignment | default: 'center'
  assign title_style = title_style | default: 'heading--h2'
  assign title_tag = title_tag | default: 'h2'
  assign has_link = false
  if link_label != blank and link_url != blank
    assign has_link = true
  endif
-%}

{%- if eyebrow != blank or title != blank or subtitle != blank or has_link -%}
  <header class="section-heading section-heading--{{ alignment }} {{ settings.section_heading_style }}">
    <div class="section-heading__text">
      {%- if eyebrow != blank -%}
        <p class="heading heading--eyebrow heading--accent">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if title != blank -%}
        <{{ title_tag }} class="heading {{ title_style }}">{{ title }}</{{ title_tag }}>
      {%- endif -%}
      {%- if subtitle != blank -%}
        <p class="heading heading--subtitle section-heading__subtitle">{{ subtitle }}</p>
      {%- endif -%}
    </div>
    {%- if has_link -%}
      {% render 'button', label: link_label, url: link_url, style: 'link', class: 'section-heading__link' %}
    {%- endif -%}
  </header>
{%- endif -%}

{% stylesheet %}
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .section-heading__text {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-heading__subtitle {
    max-width: 52ch;
  }

  .section-heading--center {
    align-items: center;
    text-align: center;
  }

  .section-heading--center .section-heading__text {
    align-items: center;
  }

  .section-heading--start {
    align-items: flex-start;
    text-align: start;
  }

  .section-heading--split {
    text-align: start;
  }

  /* Chapter: a ruled, numbered opening, like a chapter in a printed catalogue */
  #MainContent {
    counter-reset: chapter;
  }

  .section-heading--chapter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 1rem 2rem;
    padding-block-start: 0.875rem;
    border-block-start: 1px solid var(--color-foreground);
    text-align: start;
    counter-increment: chapter;
  }

  .section-heading--chapter .section-heading__text {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.75rem;
  }

  .section-heading--chapter .section-heading__text::before {
    content: counter(chapter, decimal-leading-zero);
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .section-heading--chapter .section-heading__text > * {
    grid-column: 1 / -1;
  }

  .section-heading--chapter .section-heading__text > .heading--eyebrow {
    grid-column: 2;
    grid-row: 1;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
  }

  .section-heading--chapter .heading {
    text-align: start;
  }

  .section-heading--chapter .section-heading__text > .heading:not(.heading--eyebrow, .section-heading__subtitle) {
    margin-block-start: 0.5rem;
  }

  .section-heading--chapter .section-heading__link {
    align-self: end;
  }

  @media (max-width: 749px) {
    .section-heading--chapter {
      grid-template-columns: minmax(0, 1fr);
    }

    .section-heading--chapter .section-heading__link {
      justify-self: start;
    }
  }

  @media (min-width: 750px) {
    .section-heading--split {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 2rem;
    }
  }
{% endstylesheet %}
