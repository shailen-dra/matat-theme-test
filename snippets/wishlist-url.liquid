{% doc %}
  Outputs the URL of the wishlist page: the page picked in Theme settings →
  Product cards, or `/pages/wishlist` in the current language.

  @example
  {% capture wishlist_url %}{% render 'wishlist-url' %}{% endcapture %}
{% enddoc %}

{%- liquid
  if settings.wishlist_page != blank
    echo settings.wishlist_page.url
  elsif routes.root_url == '/'
    echo '/pages/wishlist'
  else
    echo routes.root_url | append: '/pages/wishlist'
  endif
-%}
