{% doc %}
  Renders a heart button that adds a product to, or removes it from, the
  wishlist. The wishlist is a list of product handles kept in the shopper's
  browser (localStorage), so it works without an app or a customer account.
  Every wishlist button and counter on the page stays in sync.

  @param {product} product - The product to save
  @param {string} [style] - `icon` (default, a round icon button for cards) or `button` (full-width outlined button)

  @example
  {% render 'wishlist-button', product: product %}
  {% render 'wishlist-button', product: product, style: 'button' %}
{% enddoc %}

{%- liquid
  assign style = style | default: 'icon'
  assign product_title = product.title | escape
  assign label_add = 'wishlist.add' | t: title: product_title
  assign label_remove = 'wishlist.remove' | t: title: product_title
-%}

{%- if product != blank -%}
  <wishlist-button class="wishlist-button wishlist-button--{{ style }}">
    <button
      type="button"
      class="wishlist-button__toggle"
      aria-pressed="false"
      data-handle="{{ product.handle }}"
      data-label-add="{{ label_add }}"
      data-label-remove="{{ label_remove }}"
      {% if style == 'icon' %}
        aria-label="{{ label_add }}"
      {% endif %}
    >
      {% render 'icon', name: 'heart', class: 'wishlist-button__icon' %}
      {%- if style == 'button' -%}
        <span data-wishlist-text data-text-add="{{ 'wishlist.add_short' | t }}" data-text-remove="{{ 'wishlist.saved' | t }}">
          {{- 'wishlist.add_short' | t -}}
        </span>
      {%- endif -%}
    </button>
  </wishlist-button>
{%- endif -%}

{% stylesheet %}
  .wishlist-button__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-foreground);
    font: inherit;
    cursor: pointer;
  }

  .wishlist-button__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .wishlist-button__icon {
    width: 1.125rem;
    height: 1.125rem;
    transition: fill 0.2s ease, color 0.2s ease, transform 0.25s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .wishlist-button__toggle[aria-pressed='true'] .wishlist-button__icon {
    color: var(--color-accent);
    fill: currentColor;
  }

  .wishlist-button__toggle.is-popping .wishlist-button__icon {
    transform: scale(1.25);
  }

  /* Round icon button on product cards */
  .wishlist-button--icon .wishlist-button__toggle {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(6px);
  }

  .wishlist-button--icon .wishlist-button__toggle:hover .wishlist-button__icon {
    color: var(--color-accent);
  }

  /* Full-width outlined button on the product page */
  .wishlist-button--button .wishlist-button__toggle {
    width: 100%;
    padding: 0.875rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 30%, transparent);
    border-radius: var(--style-border-radius-buttons);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 0.2s ease;
  }

  .wishlist-button--button .wishlist-button__toggle:hover {
    border-color: var(--color-foreground);
  }

  [dir='rtl'] .wishlist-button--button .wishlist-button__toggle {
    letter-spacing: 0;
  }

  /* Counter badges set their own display; keep them hidden while empty */
  wishlist-count[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .wishlist-button__icon {
      transition: none;
    }
  }
{% endstylesheet %}
