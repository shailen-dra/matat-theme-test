{% doc %}
  Renders an inline SVG icon from the theme's line-icon set. Icons inherit
  `currentColor`, scale with `--icon-size` and use `--icon-stroke-width`.

  @param {string} name - Icon name: `menu`, `close`, `search`, `cart`, `account`, `chevron-down`, `chevron-left`, `chevron-right`,
    `arrow`, `plus`, `minus`, `check`, `zoom`,
    trust badges: `diamond`, `certificate`, `truck`, `returns`, `shield`, `gift`, `sparkle`, `hallmark`,
    or a social network: `instagram`, `facebook`, `pinterest`, `tiktok`, `youtube`, `whatsapp`, `x`
  @param {string} [class] - Extra classes for the `<svg>`

  @example
  {% render 'icon', name: 'search' %}
  {% render 'icon', name: 'chevron-down', class: 'menu__chevron' %}
{% enddoc %}

<svg
  class="icon icon--{{ name }} {{ class }}"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'menu' -%}
      <path d="M3 6.5h14M3 13.5h14"/>
    {%- when 'close' -%}
      <path d="M5 5l10 10M15 5L5 15"/>
    {%- when 'search' -%}
      <circle cx="8.75" cy="8.75" r="5.25"/><path d="M12.5 12.5L16.5 16.5"/>
    {%- when 'cart' -%}
      <path d="M3.392 6.875h13.216v8.016c0 .567-.224 1.112-.624 1.513-.4.402-.941.627-1.506.627H5.522a2.13 2.13 0 0 1-1.506-.627 2.15 2.15 0 0 1-.624-1.513zM8.818 2.969h2.333c.618 0 1.211.247 1.649.686a2.35 2.35 0 0 1 .683 1.658v1.562H6.486V5.313c0-.622.246-1.218.683-1.658a2.33 2.33 0 0 1 1.65-.686"/>
    {%- when 'account' -%}
      <circle cx="10" cy="6.5" r="2.75"/><path d="m5.172 14.591-.437.786a.588.588 0 0 0 .514.873h9.502a.588.588 0 0 0 .514-.873l-.437-.786a5.523 5.523 0 0 0-9.656 0"/>
    {%- when 'chevron-down' -%}
      <path d="M6 8l4 4 4-4"/>
    {%- when 'arrow' -%}
      <path d="M4 10h12M12 6l4 4-4 4"/>
    {%- when 'chevron-left' -%}
      <path d="M12 6l-4 4 4 4"/>
    {%- when 'chevron-right' -%}
      <path d="M8 6l4 4-4 4"/>
    {%- when 'plus' -%}
      <path d="M10 4.5v11M4.5 10h11"/>
    {%- when 'minus' -%}
      <path d="M4.5 10h11"/>
    {%- when 'check' -%}
      <path d="M4.5 10.5l3.5 3.5 7.5-8"/>
    {%- when 'zoom' -%}
      <circle cx="8.75" cy="8.75" r="5.25"/><path d="M12.5 12.5L16.5 16.5M8.75 6.75v4M6.75 8.75h4"/>
    {%- when 'diamond' -%}
      <path d="M5.5 3.5h9l3 4-7.5 9-7.5-9zM2.5 7.5h15M8 3.5l-1.25 4L10 16.5l3.25-9-1.25-4"/>
    {%- when 'certificate' -%}
      <circle cx="10" cy="8" r="4.75"/><circle cx="10" cy="8" r="2"/><path d="M7 11.75L5.75 17.5 8 16.25 10 17.5M13 11.75l1.25 5.75L12 16.25"/>
    {%- when 'truck' -%}
      <path d="M2.5 5h9.5v8.5H2.5zM12 8h3l2.5 2.75v2.75H12"/><circle cx="5.75" cy="14.5" r="1.5" fill="var(--color-background, #fff)"/><circle cx="14.5" cy="14.5" r="1.5" fill="var(--color-background, #fff)"/>
    {%- when 'returns' -%}
      <path d="M4 8.5h8.25a4 4 0 0 1 0 8H8M7 5.5l-3 3 3 3"/>
    {%- when 'shield' -%}
      <path d="M10 2.75l6 2.25v4.5c0 3.75-2.5 6.5-6 7.75-3.5-1.25-6-4-6-7.75V5z"/><path d="M7.25 10l2 2 3.5-4"/>
    {%- when 'gift' -%}
      <path d="M3.5 7.5h13v3h-13zM4.5 10.5h11v6h-11zM10 7.5v9M10 7.5C9 5 6.5 3.5 6 5.25S8 7.5 10 7.5c2 0 4.5-.5 4-2.25S11 5 10 7.5"/>
    {%- when 'sparkle' -%}
      <path d="M10 2.5c.5 3.75 1.75 5 5.5 5.5-3.75.5-5 1.75-5.5 5.5-.5-3.75-1.75-5-5.5-5.5 3.75-.5 5-1.75 5.5-5.5zM15.25 13c.25 1.5.75 2 2.25 2.25-1.5.25-2 .75-2.25 2.25-.25-1.5-.75-2-2.25-2.25 1.5-.25 2-.75 2.25-2.25z"/>
    {%- when 'hallmark' -%}
      <rect x="3" y="5.5" width="14" height="9" rx="1.5"/><path d="M6.5 12.25V7.75l1.75 2.5L10 7.75v4.5M12.5 7.75h1.25a1.25 1.25 0 0 1 0 2.5H12.5v2"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="14" height="14" rx="4"/><circle cx="10" cy="10" r="3.25"/><circle cx="14.25" cy="5.75" r=".5" fill="currentColor" stroke="none"/>
    {%- when 'facebook' -%}
      <path d="M11.5 17.5v-6.75h2.25l.375-2.75H11.5V6.5c0-.8.25-1.35 1.4-1.35h1.35V2.7A18 18 0 0 0 12.3 2.6c-1.95 0-3.3 1.2-3.3 3.4v2h-2.2v2.75H9v6.75"/>
    {%- when 'pinterest' -%}
      <circle cx="10" cy="10" r="7.25"/><path d="M8.6 17.1l1.6-6.4M10.2 10.7c-.5-1.9.4-3.6 2-3.6 1.3 0 2 .9 2 2.2 0 1.9-1 3.7-2.6 3.7-.9 0-1.5-.6-1.4-1.4"/>
    {%- when 'tiktok' -%}
      <path d="M11.5 3v9.25a2.75 2.75 0 1 1-2.75-2.75M11.5 3c.25 2 1.75 3.5 3.75 3.75"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="4.75" width="15" height="10.5" rx="3"/><path d="M8.5 7.75v4.5l3.75-2.25z" fill="currentColor" stroke="none"/>
    {%- when 'whatsapp' -%}
      <path d="M3.5 16.5l1-3.25A7 7 0 1 1 7 15.7z"/><path d="M7.6 7.4c.2-.4.6-.4.8 0l.5 1.1c.1.2 0 .5-.2.7l-.4.4c.4.9 1.2 1.7 2.1 2.1l.4-.4c.2-.2.5-.3.7-.2l1.1.5c.4.2.4.6 0 .8-.5.5-1.3.7-2 .4-1.6-.6-2.8-1.8-3.4-3.4-.3-.7-.1-1.5.4-2z" fill="currentColor" stroke="none"/>
    {%- when 'x' -%}
      <path d="M3.75 3.75h3.5l9 12.5h-3.5zM16 3.75l-5.3 5.9M4 16.25l5.3-5.9"/>
  {%- endcase -%}
</svg>

{% stylesheet %}
  .icon {
    display: block;
    flex-shrink: 0;
    width: var(--icon-size, 1.25rem);
    height: var(--icon-size, 1.25rem);
    stroke-width: var(--icon-stroke-width, 1.25);
  }

  [dir='rtl'] .icon--arrow {
    transform: scaleX(-1);
  }
{% endstylesheet %}
