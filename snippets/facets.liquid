{% doc %}
  Renders the storefront filters of a collection or search results as a GET
  form: checkbox lists (with swatches), boolean filters and a price range.
  Filters are configured by the merchant in the Search & Discovery app.

  @param {object} [results] - The `collection` or `search` object that has `filters` (without it, only the hidden fields render)
  @param {string} form_id - The id of the filter form (inputs elsewhere can join it with `form=`)
  @param {string} url - The form action, the results page URL
  @param {string} [sort_by] - The current sort order, kept when filtering
  @param {string} [terms] - The search terms, kept when filtering search results
  @param {string} [type] - The searched resource type (such as `product`), kept when filtering search results

  @example
  {% render 'facets', results: collection, form_id: 'FacetsForm', url: collection.url, sort_by: collection.sort_by %}
{% enddoc %}

<form id="{{ form_id }}" class="facets__form" action="{{ url }}" method="get" data-facets-form>
  {%- if sort_by != blank -%}
    <input type="hidden" name="sort_by" value="{{ sort_by }}">
  {%- endif -%}
  {%- if terms != blank -%}
    <input type="hidden" name="q" value="{{ terms | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
  {%- endif -%}
  {%- if type != blank -%}
    <input type="hidden" name="type" value="{{ type | escape }}">
  {%- endif -%}

  {%- for filter in results.filters -%}
    {%- liquid
      assign facet_id = form_id | append: '-' | append: filter.param_name | handleize
      assign active_count = filter.active_values.size
      if filter.type == 'price_range'
        assign active_count = 0
        if filter.min_value.value != null or filter.max_value.value != null
          assign active_count = 1
        endif
      endif
    -%}

    <details id="{{ facet_id }}" class="facet" open>
      <summary class="facet__summary">
        <span class="facet__label">
          {{- filter.label | escape -}}
          {%- if active_count > 0 and filter.type != 'price_range' -%}
            <span class="facet__count">{{ active_count }}</span>
          {%- endif -%}
        </span>
        {% render 'icon', name: 'chevron-down', class: 'facet__chevron' %}
      </summary>

      <div class="facet__body">
        {%- case filter.type -%}
          {%- when 'price_range' -%}
            {%- liquid
              assign range_max = filter.range_max | money_without_currency | replace: ',', ''
              assign min_value = filter.min_value.value | money_without_currency | replace: ',', ''
              assign max_value = filter.max_value.value | money_without_currency | replace: ',', ''
              assign slider_max = filter.range_max | divided_by: 100.0 | ceil
              assign slider_max_value = 1000
              if filter.max_value.value != null
                assign slider_max_value = 0
              endif
            -%}
            {%- comment -%}
              Handles move along a 0–1000 track on a cubic price scale, so the
              lower prices get most of the track; price-range sets their positions.
            {%- endcomment -%}
            <price-range class="facet__range" data-max-price="{{ slider_max }}">
            {%- if slider_max > 0 -%}
              <div class="facet__slider">
                <span class="facet__slider-track" aria-hidden="true">
                  <span class="facet__slider-fill" data-range-fill></span>
                </span>
                <input
                  type="range"
                  class="facet__slider-input"
                  min="0"
                  max="1000"
                  step="1"
                  value="0"
                  aria-label="{{ 'collections.filters.min_price' | t | escape }}"
                  data-range-min
                >
                <input
                  type="range"
                  class="facet__slider-input"
                  min="0"
                  max="1000"
                  step="1"
                  value="{{ slider_max_value }}"
                  aria-label="{{ 'collections.filters.max_price' | t | escape }}"
                  data-range-max
                >
              </div>
            {%- endif -%}
            <div class="facet__price">
              <label class="facet__price-field">
                <span class="facet__price-label">{{ 'collections.filters.from' | t }}</span>
                <span class="facet__price-input">
                  <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                  <input
                    type="number"
                    inputmode="decimal"
                    name="{{ filter.min_value.param_name }}"
                    id="{{ facet_id }}-min"
                    {% if filter.min_value.value != null %}
                      value="{{ min_value }}"
                    {% endif %}
                    placeholder="0"
                    min="0"
                    max="{{ range_max }}"
                    data-facets-price
                  >
                </span>
              </label>
              <span class="facet__price-dash" aria-hidden="true">–</span>
              <label class="facet__price-field">
                <span class="facet__price-label">{{ 'collections.filters.to' | t }}</span>
                <span class="facet__price-input">
                  <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                  <input
                    type="number"
                    inputmode="decimal"
                    name="{{ filter.max_value.param_name }}"
                    id="{{ facet_id }}-max"
                    {% if filter.max_value.value != null %}
                      value="{{ max_value }}"
                    {% endif %}
                    placeholder="{{ range_max }}"
                    min="0"
                    max="{{ range_max }}"
                    data-facets-price
                  >
                </span>
              </label>
            </div>
            </price-range>

          {%- else -%}
            <ul class="facet__list" role="list">
              {%- for value in filter.values -%}
                {%- liquid
                  assign input_id = facet_id | append: '-' | append: forloop.index
                  assign is_disabled = false
                  if value.count == 0 and value.active == false
                    assign is_disabled = true
                  endif
                -%}
                <li>
                  <label
                    class="facet__option{% if is_disabled %} facet__option--disabled{% endif %}"
                    for="{{ input_id }}"
                  >
                    <input
                      type="checkbox"
                      class="facet__checkbox"
                      id="{{ input_id }}"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}
                        checked
                      {% endif %}
                      {% if is_disabled %}
                        disabled
                      {% endif %}
                    >
                    {%- if value.swatch.color != blank -%}
                      <span
                        class="facet__swatch"
                        style="--swatch-color: {{ value.swatch.color }}"
                        aria-hidden="true"
                      ></span>
                    {%- else -%}
                      <span class="facet__box" aria-hidden="true">
                        {%- render 'icon', name: 'check', class: 'facet__tick' -%}
                      </span>
                    {%- endif -%}
                    <span class="facet__value">{{ value.label | escape }}</span>
                    <span class="facet__value-count">{{ value.count }}</span>
                  </label>
                </li>
              {%- endfor -%}
            </ul>
        {%- endcase -%}
      </div>
    </details>
  {%- endfor -%}

  <noscript>
    <button type="submit" class="button button--primary button--sm button--full">
      {{ 'collections.filters.apply' | t }}
    </button>
  </noscript>
</form>

{% stylesheet %}
  .facets__form {
    display: flex;
    flex-direction: column;
  }

  .facet {
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .facet__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.125rem;
    cursor: pointer;
    list-style: none;
  }

  .facet__summary::-webkit-details-marker {
    display: none;
  }

  .facet__summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .facet__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .facet__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.6875rem;
    letter-spacing: 0;
  }

  .facet__chevron {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .facet[open] .facet__chevron {
    transform: rotate(180deg);
  }

  .facet__body {
    padding-block-end: 1.25rem;
  }

  .facet__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facet__option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.375rem;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .facet__option--disabled {
    opacity: 0.4;
    cursor: default;
  }

  .facet__checkbox {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .facet__box,
  .facet__swatch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 40%, transparent);
    border-radius: calc(var(--style-border-radius-inputs) / 2);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .facet__swatch {
    border-radius: 50%;
    background-color: var(--swatch-color);
    box-shadow: inset 0 0 0 2px var(--color-background);
  }

  .facet__tick {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-background);
    opacity: 0;
  }

  .facet__checkbox:checked + .facet__box {
    border-color: var(--color-foreground);
    background-color: var(--color-foreground);
  }

  .facet__checkbox:checked + .facet__box .facet__tick {
    opacity: 1;
  }

  .facet__checkbox:checked + .facet__swatch {
    border-color: var(--color-foreground);
    outline: 1px solid var(--color-foreground);
    outline-offset: 1px;
  }

  .facet__checkbox:focus-visible + :is(.facet__box, .facet__swatch) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .facet__value {
    flex: 1;
  }

  .facet__value-count {
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .facet__price {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
  }

  .facet__price-field {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .facet__price-label {
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .facet__price-input {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 25%, transparent);
    border-radius: var(--style-border-radius-inputs);
    font-size: 0.9375rem;
  }

  .facet__price-input:focus-within {
    border-color: var(--color-foreground);
  }

  .facet__price-input input {
    width: 100%;
    min-width: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    -moz-appearance: textfield;
  }

  .facet__price-input input:focus {
    outline: none;
  }

  .facet__price-input input::-webkit-inner-spin-button,
  .facet__price-input input::-webkit-outer-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .facet__price-dash {
    padding-block-end: 0.75rem;
    opacity: 0.75;
  }

  [dir='rtl'] .facet__label {
    letter-spacing: 0;
  }

  /* Price range slider: two range inputs stacked on one track */
  .facet__range {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .facet__slider {
    --thumb-size: 1.5rem; /* 24px: minimum touch target */

    position: relative;
    height: var(--thumb-size);
    margin-inline: calc(var(--thumb-size) / 2);
  }

  .facet__slider-track {
    position: absolute;
    inset-inline: calc(var(--thumb-size) / -2);
    top: 50%;
    height: 2px;
    border-radius: 2px;
    background-color: color-mix(in srgb, var(--color-foreground) 18%, transparent);
    translate: 0 -50%;
  }

  .facet__slider-fill {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--thumb-size) / 2 + (100% - var(--thumb-size)) * var(--range-start, 0));
    inset-inline-end: calc(var(--thumb-size) / 2 + (100% - var(--thumb-size)) * (1 - var(--range-end, 1)));
    background-color: var(--color-foreground);
  }

  .facet__slider-input {
    position: absolute;
    inset-inline: calc(var(--thumb-size) / -2);
    top: 0;
    width: calc(100% + var(--thumb-size));
    height: var(--thumb-size);
    margin: 0;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .facet__slider-input::-webkit-slider-runnable-track {
    background: none;
  }

  .facet__slider-input::-moz-range-track {
    background: none;
  }

  .facet__slider-input::-webkit-slider-thumb {
    width: var(--thumb-size);
    height: var(--thumb-size);
    border: 2px solid var(--color-foreground);
    border-radius: 50%;
    background-color: var(--color-background);
    cursor: grab;
    pointer-events: auto;
    -webkit-appearance: none;
  }

  .facet__slider-input::-moz-range-thumb {
    width: var(--thumb-size);
    height: var(--thumb-size);
    box-sizing: border-box;
    border: 2px solid var(--color-foreground);
    border-radius: 50%;
    background-color: var(--color-background);
    cursor: grab;
    pointer-events: auto;
  }

  .facet__slider-input:active::-webkit-slider-thumb {
    cursor: grabbing;
  }

  .facet__slider-input:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .facet__slider-input:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Price range slider: keeps two range inputs in sync with the From/To price
   * fields. Moving a handle writes the price field and fires its `input`
   * event, so the collection filters re-render through the usual debounce.
   * Positions map to prices on a cubic curve so most of the track covers the
   * lower, more common prices; prices round to friendly steps.
   */
  class PriceRange extends HTMLElement {
    static STEPS = 1000;
    static CURVE = 3;

    connectedCallback() {
      this.minRange = this.querySelector('[data-range-min]');
      this.maxRange = this.querySelector('[data-range-max]');
      const fields = this.querySelectorAll('[data-facets-price]');
      this.minField = fields[0];
      this.maxField = fields[1];
      this.maxPrice = Number(this.dataset.maxPrice) || 0;
      if (!this.minRange || !this.maxRange || !this.minField || !this.maxField || !this.maxPrice) return;

      this.addEventListener('input', this.onInput);
      this.syncFromFields();
      // The filters controller may restore typed values after a re-render
      requestAnimationFrame(() => this.syncFromFields());
    }

    /** Slider position (0–STEPS) to a rounded price */
    toPrice(position) {
      const price = this.maxPrice * (position / PriceRange.STEPS) ** PriceRange.CURVE;
      const step = price < 100 ? 5 : price < 1000 ? 10 : 50;
      return Math.min(this.maxPrice, Math.round(price / step) * step);
    }

    /** Price to a slider position (0–STEPS) */
    toPosition(price) {
      const ratio = Math.min(Math.max(price / this.maxPrice, 0), 1);
      return Math.round(ratio ** (1 / PriceRange.CURVE) * PriceRange.STEPS);
    }

    onInput = (event) => {
      const target = event.target;
      if (target === this.minRange || target === this.maxRange) {
        let low = Number(this.minRange.value);
        let high = Number(this.maxRange.value);
        if (low > high) {
          if (target === this.minRange) low = high;
          else high = low;
          this.minRange.value = low;
          this.maxRange.value = high;
        }
        const lowPrice = this.toPrice(low);
        const highPrice = this.toPrice(high);
        this.minField.value = low > 0 ? lowPrice : '';
        this.maxField.value = high < PriceRange.STEPS ? highPrice : '';
        this.minRange.setAttribute('aria-valuetext', this.format(low > 0 ? lowPrice : 0));
        this.maxRange.setAttribute('aria-valuetext', this.format(highPrice));
        this.updateFill();
        // Let the filters controller pick up the change
        (target === this.minRange ? this.minField : this.maxField).dispatchEvent(
          new Event('input', { bubbles: true })
        );
      } else if (target === this.minField || target === this.maxField) {
        this.syncFromFields();
      }
    };

    syncFromFields() {
      const low = this.minField.value === '' ? 0 : Number(this.minField.value);
      const high = this.maxField.value === '' ? this.maxPrice : Number(this.maxField.value);
      this.minRange.value = this.toPosition(low);
      this.maxRange.value = this.toPosition(high);
      this.minRange.setAttribute('aria-valuetext', this.format(low));
      this.maxRange.setAttribute('aria-valuetext', this.format(Math.min(high, this.maxPrice)));
      this.updateFill();
    }

    format(price) {
      const symbol = this.querySelector('.facet__price-input [aria-hidden]')?.textContent.trim() ?? '';
      return `${symbol}${price}`;
    }

    updateFill() {
      this.style.setProperty('--range-start', Number(this.minRange.value) / PriceRange.STEPS);
      this.style.setProperty('--range-end', Number(this.maxRange.value) / PriceRange.STEPS);
    }
  }

  if (!customElements.get('price-range')) {
    customElements.define('price-range', PriceRange);
  }
{% endjavascript %}
