{% doc %}
  Renders the full-width mega menu panel content for a top-level menu link.

  Columns come from the menu structure: with three levels each child becomes
  a titled column; with two levels the children are listed in balanced
  columns. An optional `mega_menu` block from the header adds up to two
  featured image cards.

  @param {object} link - The top-level `link` from the menu
  @param {object} [promo_block] - The header's `mega_menu` block matched to this link
  @param {string} [context] - `desktop` (default) or `drawer`

  @example
  {% render 'mega-menu', link: link, promo_block: mega_block %}
  {% render 'mega-menu', link: link, promo_block: mega_block, context: 'drawer' %}
{% enddoc %}

{%- liquid
  assign context = context | default: 'desktop'
  assign promo_count = 0
  if promo_block
    if promo_block.settings.image_1 != blank or promo_block.settings.heading_1 != blank
      assign promo_count = promo_count | plus: 1
    endif
    if promo_block.settings.image_2 != blank or promo_block.settings.heading_2 != blank
      assign promo_count = promo_count | plus: 1
    endif
    assign ratio_class = promo_block.settings.image_ratio
  endif
-%}

{%- capture promos -%}
  {%- if promo_count > 0 -%}
    {%- for i in (1..2) -%}
      {%- liquid
        assign image_key = 'image_' | append: i
        assign heading_key = 'heading_' | append: i
        assign link_key = 'link_' | append: i
        assign promo_image = promo_block.settings[image_key]
        assign promo_heading = promo_block.settings[heading_key]
        assign promo_url = promo_block.settings[link_key] | default: link.url
      -%}
      {%- if promo_image != blank or promo_heading != blank -%}
        <a href="{{ promo_url }}" class="mega-promo {{ ratio_class }}">
          <span class="mega-promo__media">
            {%- if promo_image != blank -%}
              {{
                promo_image
                | image_url: width: 800
                | image_tag: widths: '300, 400, 600, 800', sizes: '(min-width: 990px) 16rem, 45vw', loading: 'lazy'
              }}
            {%- else -%}
              {%- liquid
                if i == 1
                  assign demo_image = 'demo-layered-necklaces.jpg'
                else
                  assign demo_image = 'demo-hoops.jpg'
                endif
              -%}
              <img
                src="{{ demo_image | asset_img_url: '800x' }}"
                srcset="{{ demo_image | asset_img_url: '400x' }} 400w, {{ demo_image | asset_img_url: '800x' }} 800w"
                sizes="(min-width: 990px) 16rem, 45vw"
                alt=""
                width="800"
                height="1200"
                loading="lazy"
              >
            {%- endif -%}
          </span>
          {%- if promo_heading != blank -%}
            <span class="mega-promo__heading">
              {{ promo_heading | escape }}
              {% render 'icon', name: 'arrow' %}
            </span>
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if context == 'drawer' -%}
  {%- if promo_count > 0 -%}
    <div class="mega-promos mega-promos--drawer">{{ promos }}</div>
  {%- endif -%}
{%- else -%}
  <div class="mega-menu" style="--promo-count: {{ promo_count }};">
    {%- if link.links != blank -%}
      <div class="mega-menu__columns{% if link.levels == 1 %} mega-menu__columns--flat{% endif %}">
        {%- if link.levels > 1 -%}
          {%- for child in link.links -%}
            <div class="mega-menu__column">
              <a
                href="{{ child.url }}"
                class="mega-menu__title"
                {% if child.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- child.title | escape -}}
              </a>
              {%- if child.links != blank -%}
                <ul class="menu__sublist" role="list">
                  {%- for grandchild in child.links -%}
                    <li>
                      <a
                        href="{{ grandchild.url }}"
                        class="menu__sublink"
                        {% if grandchild.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- grandchild.title | escape -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <ul class="menu__sublist" role="list">
            {%- for child in link.links -%}
              <li>
                <a
                  href="{{ child.url }}"
                  class="mega-menu__title"
                  {% if child.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- child.title | escape -}}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if promo_count > 0 -%}
      <div class="mega-promos">{{ promos }}</div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .mega-menu {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    width: var(--content-width);
    margin-inline: auto;
  }

  .mega-menu:has(.mega-menu__columns):has(.mega-promos) {
    grid-template-columns: 1fr auto;
  }

  .mega-menu__columns {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 2rem;
    align-content: start;
  }

  .mega-menu__columns--flat > .menu__sublist {
    display: block;
    columns: 3 10rem;
    column-gap: 2rem;
  }

  .mega-menu__columns--flat > .menu__sublist > li {
    margin-block-end: 0.875rem;
    break-inside: avoid;
  }

  .mega-menu__title {
    display: block;
    margin-block-end: 0.875rem;
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
    font-size: 1.25rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .mega-menu__columns--flat .mega-menu__title {
    margin-block-end: 0;
  }

  .mega-menu__title:hover,
  .mega-menu__title[aria-current='page'] {
    color: var(--color-accent);
  }

  .mega-promos {
    display: grid;
    grid-template-columns: repeat(var(--promo-count, 1), minmax(12rem, 16rem));
    gap: 1.5rem;
    justify-content: end;
  }

  .mega-menu:not(:has(.mega-menu__columns)) .mega-promos {
    justify-content: start;
  }

  .mega-promos--drawer {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    padding-block: 0.5rem 1.25rem;
  }

  .mega-promo {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .mega-promo__media {
    display: block;
    aspect-ratio: var(--promo-ratio, 4 / 5);
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }

  .mega-promo--square {
    --promo-ratio: 1;
  }

  .mega-promo--landscape {
    --promo-ratio: 4 / 3;
  }

  .mega-promo__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .mega-promo:hover .mega-promo__media img {
    transform: scale(1.04);
  }

  .mega-promo__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
  }

  .mega-promo__heading .icon {
    --icon-size: 1rem;
    transition: transform 0.25s ease;
  }

  .mega-promo:hover .mega-promo__heading .icon {
    transform: translateX(4px);
  }

  [dir='rtl'] .mega-promo:hover .mega-promo__heading .icon {
    transform: scaleX(-1) translateX(4px);
  }

  .mega-promos--drawer .mega-promo__heading {
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-promo__media img,
    .mega-promo__heading .icon {
      transition: none;
    }
  }
{% endstylesheet %}
