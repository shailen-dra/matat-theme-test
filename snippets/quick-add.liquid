{% doc %}
  Renders the quick add button of a product card. A product with a single
  variant goes straight into the cart; a product with options opens the
  quick view dialog (see `quick-view-dialog`) to choose them first.
  Renders nothing for sold out products.

  @param {product} product - The product to add

  @example
  {% render 'quick-add', product: product %}
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign product_title = product.title | escape
  assign adds_directly = false
  if product.has_only_default_variant
    assign adds_directly = true
  endif
-%}

{%- if product.available -%}
  <quick-add class="quick-add">
    {%- if adds_directly -%}
      <button
        type="button"
        class="quick-add__button"
        data-variant-id="{{ variant.id }}"
        data-added-label="{{ 'product.quick_add.added' | t }}"
        aria-label="{{ 'product.quick_add.add_label' | t: title: product_title }}"
      >
        {% render 'icon', name: 'plus', class: 'quick-add__icon' %}
        <span class="quick-add__text" data-quick-add-text>{{ 'product.quick_add.add' | t }}</span>
      </button>
    {%- else -%}
      <button
        type="button"
        class="quick-add__button"
        data-quick-view-url="{{ product.url }}"
        aria-haspopup="dialog"
        aria-label="{{ 'product.quick_add.choose_label' | t: title: product_title }}"
      >
        {% render 'icon', name: 'plus', class: 'quick-add__icon' %}
        <span class="quick-add__text">{{ 'product.quick_add.choose' | t }}</span>
      </button>
    {%- endif -%}
  </quick-add>
{%- endif -%}

{% stylesheet %}
  .quick-add__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.8125rem 1rem;
    border: 0;
    border-radius: var(--style-border-radius-buttons);
    background-color: color-mix(in srgb, var(--color-background) 92%, transparent);
    backdrop-filter: blur(6px);
    color: var(--color-foreground);
    font-family: var(--font-primary--family);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .quick-add__button:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .quick-add__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .quick-add__button[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }

  .quick-add__button.is-added {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .quick-add__icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  [dir='rtl'] .quick-add__button {
    letter-spacing: 0;
  }

  /* Touch screens: a compact round button that is always visible */
  @media (hover: none) {
    .quick-add__button {
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border-radius: 50%;
    }

    .quick-add__text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .quick-add__icon {
      width: 1.125rem;
      height: 1.125rem;
    }
  }
{% endstylesheet %}
