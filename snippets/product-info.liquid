{% doc %}
  Renders the product layout shared by the product page and featured product
  sections: media gallery, block-driven details and variant syncing.

  @param {section} section - The rendering section, for its id and layout settings
  @param {product} product - The product to show
  @param {string} blocks - The section's rendered blocks (`content_for 'blocks'`)
  @param {boolean} [update_url] - Whether variant changes update the page URL

  @example
  {% capture blocks %}{% content_for 'blocks' %}{% endcapture %}
  {% render 'product-info', section: section, product: product, blocks: blocks, update_url: true %}
{% enddoc %}

{%- liquid
  assign variant = product.selected_or_first_available_variant

  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  assign product_classes = 'product ' | append: section.settings.media_width
  if section.settings.sticky_details
    assign product_classes = product_classes | append: ' product--sticky'
  endif
  assign product_style = section.settings.style
  if product_style == 'theme'
    assign product_style = settings.product_style
  endif
  if product_style != blank
    assign product_classes = product_classes | append: ' ' | append: product_style
  endif

  assign show_captions = false
  if product_style == 'product--catalogue'
    assign show_captions = true
  endif
-%}

<product-info
  class="{{ product_classes }}"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-product-handle="{{ product.handle }}"
  data-variant-id="{{ variant.id }}"
  data-update-url="{{ update_url | default: false }}"
  style="
    --product-padding-top: {{ section.settings.padding_top }}px;
    --product-padding-bottom: {{ section.settings.padding_bottom }}px;
    --product-details-gap: {{ section.settings.details_gap }}px;
  "
>
  <div class="product__media">
    {% render 'product-gallery',
      product: product,
      layout: section.settings.gallery_layout,
      ratio: section.settings.media_ratio,
      loading: loading,
      id: section.id,
      zoom: section.settings.enable_zoom,
      captions: show_captions
    %}
  </div>

  <div class="product__details">
    <div class="product__details-inner">
      {%- if product == blank and request.design_mode -%}
        <p class="product__empty">{{ 'product.select_product' | t }}</p>
      {%- endif -%}
      {%- if product_style == 'product--catalogue' and product != blank -%}
        <p class="product__reference" data-update="reference">
          {%- if product.type != blank -%}
            <span>{{ product.type | escape }}</span>
          {%- endif -%}
          {%- if variant.sku != blank -%}
            <span>{{ 'product.reference' | t: sku: variant.sku | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
      {{ blocks }}
    </div>
  </div>
</product-info>

{% stylesheet %}
  .product {
    --product-media-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    display: grid;
    grid-template-columns: var(--product-media-columns);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
    padding-block: var(--product-padding-top) var(--product-padding-bottom);
  }

  .product--media-half {
    --product-media-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .product--media-wide {
    --product-media-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }

  .product__details-inner {
    display: flex;
    flex-direction: column;
    gap: var(--product-details-gap);
  }

  /* Let blocks be the flex items, so blocks with nothing to show don't add an empty gap */
  .product__details-inner > .shopify-block {
    display: contents;
  }

  .product--sticky .product__details {
    position: sticky;
    top: calc(var(--header-height, 0px) + 1.5rem);
    /* Sticky creates a stacking context that also holds the fixed sticky add to cart bar;
       lift it above later sections (and the footer) but keep it under the header (20) */
    z-index: 19;
  }

  .product[aria-busy='true'] [data-update^='price'],
  .product[aria-busy='true'] [data-update^='buy'] {
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .product__empty {
    padding: 1rem 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--color-foreground) 30%, transparent);
    font-size: 0.875rem;
  }

  @media (max-width: 989px) {
    .product {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .product--sticky .product__details {
      position: static;
    }
  }

  @media (max-width: 749px) {
    /* The gallery bleeds to the screen edges on phones */
    .product__media {
      margin-inline: calc(var(--page-margin) * -1);
    }

    .product {
      padding-block-start: 0;
    }
  }

  /*
    Catalogue style: the product page reads as an entry in a printed
    catalogue. Square plates with numbered figure labels, a reference line
    (type and SKU) above the title, and the product details laid out as
    numbered notes instead of tabs.
  */
  .product--catalogue {
    --style-border-radius-buttons: 0;
    --style-border-radius-inputs: 0;
    --product-media-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
  }

  /* Narrower desktops (or beside the index rail): an even split keeps the buy buttons on one row */
  @media (max-width: 1279px) {
    .product--catalogue {
      --product-media-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .product--catalogue .product__details-inner {
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--color-foreground);
  }

  .product__reference {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
  }

  .product--catalogue .tabs {
    counter-reset: note;
    gap: 0;
  }

  .product--catalogue .tabs .tab {
    counter-increment: note;
    margin: 0;
    padding-block: 1.25rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
  }

  .product--catalogue .tab__heading {
    display: flex;
    gap: 1.25rem;
    margin-block-end: 0.875rem;
  }

  .product--catalogue .tab__heading::before {
    content: counter(note, decimal-leading-zero);
    min-width: 1.5rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
  }

  .product--catalogue .tab__panel {
    padding-inline-start: 2.75rem;
  }

  @media (max-width: 749px) {
    .product--catalogue .tab__panel {
      padding-inline-start: 0;
    }
  }

  /*
    Modern style: soft rounded media, pill-shaped controls, a segmented tab
    switcher and a floating glass add-to-cart bar, matching the glass header.
    Controls go round through the shared button radius variable; content
    boxes that would look wrong as pills get a fixed soft radius instead.
  */
  .product--modern {
    --style-border-radius-buttons: 999px;
    --product-soft-radius: 1.25rem;
  }

  .product--modern .product-gallery__item {
    border-radius: var(--product-soft-radius);
  }

  .product--modern .product-gallery__thumbnail {
    overflow: hidden;
    border-radius: 0.75rem;
  }

  .product--modern :is(.personalization__option, .personalization__summary, .specs--boxed, .bundle) {
    border-radius: 1rem;
  }

  .product--modern .buy-buttons__dynamic {
    --shopify-accelerated-checkout-button-border-radius: 999px;
  }

  .product--modern .delivery {
    padding: 0.875rem 1.125rem;
    border-radius: 1rem;
    background-color: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }

  /* Tabs: a segmented pill switcher */
  .product--modern .tabs__list {
    gap: 0.25rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.25rem;
    border: 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-foreground) 5%, transparent);
  }

  .product--modern .tabs__button {
    padding: 0.625rem 1.125rem;
    border-radius: 999px;
    letter-spacing: 0.12em;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      opacity 0.25s ease;
  }

  .product--modern .tabs__button[aria-selected='true'] {
    background-color: var(--color-background);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 4px 14px rgb(0 0 0 / 0.08);
  }

  .product--modern .tabs__button[aria-selected='true']::after {
    display: none;
  }

  /* Sticky add to cart: a floating glass bubble instead of an edge-to-edge bar */
  .product--modern .sticky-atc {
    inset-inline: max(0.5rem, calc((100vw - var(--page-width)) / 2 + var(--page-margin) - 1.25rem));
    bottom: calc(0.5rem + env(safe-area-inset-bottom));
    padding: 0.625rem 0.75rem 0.625rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-background) 72%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.14);
    transform: translateY(calc(100% + 1rem));
  }

  .product--modern .sticky-atc.is-visible {
    transform: none;
  }

  .product--modern .sticky-atc__image {
    border-radius: 50%;
  }

  /* Desktop: line the bar up with the sticky header bubble */
  @media (min-width: 990px) {
    .product--modern .sticky-atc {
      inset-inline: max(2.5rem, calc((100vw - var(--page-width)) / 2 + var(--page-margin) - 1.25rem));
    }
  }

  @media (max-width: 749px) {
    /* Keep the rounded gallery inside the page margins instead of bleeding to the edges */
    .product--modern .product__media {
      margin-inline: 0;
    }

    .product--modern {
      padding-block-start: 0.5rem;
    }

    .product--modern .sticky-atc {
      border-radius: 1.5rem;
    }
  }
{% endstylesheet %}
