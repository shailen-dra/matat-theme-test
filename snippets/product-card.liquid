{% doc %}
  Renders a product card: image (with an optional second image on hover),
  sale / sold-out badge, quick add button, vendor, title and
  price. Quick add follows the "Product cards" theme settings.

  Without a `product` it renders a placeholder card using a demo image, so
  grids look complete on stores that have no products yet.

  @param {product} [product] - The product to show
  @param {string} [placeholder_image] - Theme asset used when `product` is blank
  @param {string} [ratio] - Image ratio class: `card--portrait` (default), `card--square` or `card--natural`
  @param {boolean} [show_secondary_image] - Shows the second product image on hover
  @param {boolean} [show_vendor] - Shows the vendor above the title
  @param {string} [sizes] - The `sizes` attribute for the image
  @param {string} [loading] - Image loading strategy (default `lazy`)
  @param {string} [heading_tag] - Title element: `h3` (default), or `h2` when the grid sits directly under the page `h1`

  @example
  {% render 'product-card', product: product, show_secondary_image: true %}
  {% render 'product-card', placeholder_image: 'demo-hoops.jpg' %}
{% enddoc %}

{%- liquid
  assign ratio = ratio | default: 'card--portrait'
  assign sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign loading = loading | default: 'lazy'

  if product != blank
    assign image = product.featured_media.preview_image
    assign secondary_image = null
    if show_secondary_image and product.media.size > 1
      assign secondary_image = product.media[1].preview_image
    endif
    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
    endif
    assign price_min = product.price_min | money
    assign from_price = 'product.card.from_price' | t: price: price_min
  endif

  assign ratio_style = ''
  if ratio == 'card--natural' and image != blank
    assign ratio_style = '--card-ratio: ' | append: image.aspect_ratio
  endif
-%}

<article class="card {{ ratio }}{% if secondary_image != blank %} card--has-secondary{% endif %}">
  {%- if product != blank -%}
    <div class="card__media-wrap">
      <a href="{{ product.url }}" class="card__media" style="{{ ratio_style }}" tabindex="-1" aria-hidden="true">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1100
            | image_tag: widths: '300, 450, 600, 750, 900, 1100', sizes: sizes, loading: loading, class: 'card__image', alt: ''
          }}
          {%- if secondary_image != blank -%}
            {{
              secondary_image
              | image_url: width: 1100
              | image_tag: widths: '300, 450, 600, 750, 900, 1100', sizes: sizes, loading: 'lazy', class: 'card__image card__image--secondary', alt: ''
            }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'card__image card__placeholder' }}
        {%- endif -%}
      </a>

      {%- liquid
        # Custom badges: tags like "badge:Bestseller", plus "New" for recently published products
        assign custom_badges = ''
        for tag in product.tags
          assign tag_prefix = tag | slice: 0, 6 | downcase
          if tag_prefix == 'badge:'
            assign badge_text = tag | slice: 6, 60 | strip
            if badge_text != blank
              assign custom_badges = custom_badges | append: badge_text | append: '|'
            endif
          endif
        endfor

        assign show_new = false
        if settings.new_badge_days > 0 and product.published_at != blank
          assign published = product.published_at | date: '%s' | plus: 0
          assign now = 'now' | date: '%s' | plus: 0
          assign age_days = now | minus: published | divided_by: 86400
          if age_days < settings.new_badge_days
            assign show_new = true
          endif
        endif
        assign custom_badges = custom_badges | split: '|' | uniq
      -%}
      <div class="card__badges">
        {%- if product.available == false -%}
          <span class="card__badge">{{ 'product.sold_out' | t }}</span>
        {%- elsif on_sale -%}
          <span class="card__badge card__badge--sale">{{ 'product.price.sale_badge' | t }}</span>
        {%- endif -%}
        {%- if show_new -%}
          <span class="card__badge card__badge--new">{{ 'product.card.new_badge' | t }}</span>
        {%- endif -%}
        {%- for badge in custom_badges limit: 2 -%}
          <span class="card__badge card__badge--custom">{{ badge | escape }}</span>
        {%- endfor -%}
      </div>

      {%- if settings.enable_quick_add -%}
        <div class="card__quick-add">{% render 'quick-add', product: product %}</div>
      {%- endif -%}
    </div>

    <div class="card__info">
      {%- if show_vendor -%}
        <p class="card__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <{{ heading_tag | default: 'h3' }} class="card__title">
        <a href="{{ product.url }}" class="card__link">{{ product.title }}</a>
      </{{ heading_tag | default: 'h3' }}>
      <p class="card__price">
        {%- if on_sale -%}
          <span class="visually-hidden">{{ 'product.price.sale' | t }}</span>
          <span class="card__price-current">
            {%- if product.price_varies -%}
              {{ from_price }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </span>
          <span class="visually-hidden">{{ 'product.price.regular' | t }}</span>
          <s class="card__price-compare">{{ product.compare_at_price | money }}</s>
        {%- elsif product.price_varies -%}
          {{ from_price }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </p>
      {%- assign unit_variant = product.selected_or_first_available_variant -%}
      {%- if unit_variant.unit_price_measurement -%}
        <p class="card__unit-price">
          <span class="visually-hidden">{{ 'product.price.unit' | t }}</span>
          {{ unit_variant.unit_price | unit_price_with_measurement: unit_variant.unit_price_measurement }}
        </p>
      {%- endif -%}

      {%- if settings.card_swatches -%}
        {%- liquid
          assign swatch_option = null
          for option in product.options_with_values
            assign option_name = option.name | downcase
            if option_name contains 'color' or option_name contains 'colour' or option_name contains 'metal' or option_name contains 'צבע' or option_name contains 'מתכת'
              assign swatch_option = option
              break
            endif
          endfor
        -%}
        {%- if swatch_option and swatch_option.values.size > 1 -%}
          <card-swatches class="card__swatches">
            {%- for value in swatch_option.values limit: 5 -%}
              {%- liquid
                assign value_name = value.name | downcase
                assign swatch_color = value.swatch.color
                if swatch_color == blank
                  if value_name contains 'rose'
                    assign swatch_color = '#e3b4a0'
                  elsif value_name contains 'gold' or value_name contains 'זהב'
                    assign swatch_color = '#d4b06a'
                  elsif value_name contains 'silver' or value_name contains 'platinum' or value_name contains 'white' or value_name contains 'כסף'
                    assign swatch_color = '#cfd2d6'
                  elsif value_name contains 'black'
                    assign swatch_color = '#2a2a2a'
                  else
                    assign swatch_color = '#e8e2d8'
                  endif
                endif
                assign swatch_media = value.variant.featured_media.preview_image
              -%}
              <button
                type="button"
                class="card__swatch"
                style="--swatch-color: {{ swatch_color }};{% if value.swatch.image %} --swatch-image: url({{ value.swatch.image | image_url: width: 60 }});{% endif %}"
                aria-label="{{ swatch_option.name | escape }}: {{ value.name | escape }}"
                {% if forloop.first %}
                  aria-pressed="true"
                {% else %}
                  aria-pressed="false"
                {% endif %}
                {% if value.variant %}
                  data-url="{{ value.variant.url }}"
                {% endif %}
                {% if swatch_media %}
                  data-src="{{ swatch_media | image_url: width: 900 }}"
                  data-srcset="{{ swatch_media | image_url: width: 450 }} 450w, {{ swatch_media | image_url: width: 900 }} 900w"
                {% endif %}
              ></button>
            {%- endfor -%}
            {%- if swatch_option.values.size > 5 -%}
              {%- assign more_values = swatch_option.values.size | minus: 5 -%}
              <span class="card__swatch-more">+{{ more_values }}</span>
            {%- endif -%}
          </card-swatches>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="card__media">
      <img
        src="{{ placeholder_image | default: 'demo-ginkgo-set.jpg' | asset_img_url: '600x' }}"
        srcset="{{ placeholder_image | default: 'demo-ginkgo-set.jpg' | asset_img_url: '450x' }} 450w, {{ placeholder_image | default: 'demo-ginkgo-set.jpg' | asset_img_url: '750x' }} 750w"
        sizes="{{ sizes }}"
        width="750"
        height="1000"
        alt=""
        class="card__image"
        loading="{{ loading }}"
      >
    </div>
    <div class="card__info">
      <{{ heading_tag | default: 'h3' }} class="card__title">{{ 'product.card.placeholder_title' | t }}</{{ heading_tag | default: 'h3' }}>
      <p class="card__price">{{ 129000 | money }}</p>
    </div>
  {%- endif -%}
</article>

{% stylesheet %}
  .card {
    --card-ratio: 3 / 4;

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .card--square {
    --card-ratio: 1;
  }

  .card__media-wrap {
    position: relative;
  }

  .card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--card-ratio);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons);
    background-color: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s ease, transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .card__placeholder {
    fill: color-mix(in srgb, var(--color-foreground) 25%, transparent);
  }

  .card__image--secondary {
    opacity: 0;
  }

  .card:hover .card__image {
    transform: scale(1.04);
  }

  .card--has-secondary:hover .card__image--secondary {
    opacity: 1;
  }

  .card__badges {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    pointer-events: none;
  }

  .card__badges:empty {
    display: none;
  }

  .card__badge {
    padding: 0.375rem 0.625rem;
    border-radius: var(--style-border-radius-buttons);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card__quick-add {
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
  }

  /* Pointer devices: the quick add bar slides in on hover / keyboard focus */
  @media (hover: hover) {
    .card__quick-add {
      opacity: 0;
      transform: translateY(0.5rem);
      transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .card:hover .card__quick-add,
    .card__quick-add:focus-within {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: none) {
    .card__quick-add {
      inset-inline-start: auto;
    }
  }

  .card__unit-price {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 75%, transparent);
    font-size: 0.8125rem;
  }

  .card__badge--sale {
    background-color: var(--color-accent);
    color: #fff;
  }

  .card__badge--new {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .card__badge--custom {
    border: 1px solid color-mix(in srgb, var(--color-foreground) 20%, transparent);
  }

  .card__info {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .card__vendor {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1rem, 0.4vw + 0.875rem, 1.1875rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.3;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Whole card is clickable through the title link */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) .card__media {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .card__price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .card__price-current {
    color: var(--color-accent);
  }

  .card__price-compare {
    opacity: 0.75;
  }

  [dir='rtl'] :is(.card__badge, .card__vendor) {
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .card__image {
      transition: none;
    }
  }

  /* Metal / color swatches */
  .card__swatches {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin-block-start: 0.25rem;
  }

  .card__swatch {
    width: 1.375rem;
    height: 1.375rem;
    padding: 0;
    border: 2px solid var(--color-background);
    border-radius: 50%;
    background: var(--swatch-image, none) center / cover, var(--swatch-color);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-foreground) 20%, transparent);
    cursor: pointer;
    transition: box-shadow 0.2s ease;
  }

  .card__swatch[aria-pressed='true'],
  .card__swatch:hover {
    box-shadow: 0 0 0 1px var(--color-foreground);
  }

  .card__swatch:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* While choosing a swatch, show its image rather than the hover image */
  .card--has-secondary:has(.card__swatches:hover) .card__image--secondary {
    opacity: 0;
  }

  .card__swatch-more {
    font-size: 0.75rem;
    opacity: 0.75;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Product card swatches: hovering or picking a metal / color shows that
   * variant's image on the card, and the card links to that variant.
   */
  class CardSwatches extends HTMLElement {
    connectedCallback() {
      this.card = this.closest('.card');
      this.image = this.card?.querySelector('.card__image:not(.card__image--secondary)');
      this.links = this.card ? [...this.card.querySelectorAll('.card__media, .card__link')] : [];
      this.original = this.image && { src: this.image.src, srcset: this.image.srcset };
      this.addEventListener('click', this.onSelect);
      this.addEventListener('pointerover', this.onPreview);
      this.addEventListener('pointerleave', this.onLeave);
    }

    onPreview = (event) => {
      const swatch = event.target.closest('.card__swatch');
      if (swatch && event.pointerType === 'mouse') this.showImage(swatch);
    };

    onLeave = () => {
      const selected = this.querySelector('.card__swatch[aria-pressed="true"]');
      if (selected) this.showImage(selected);
    };

    onSelect = (event) => {
      const swatch = event.target.closest('.card__swatch');
      if (!swatch) return;
      event.preventDefault();
      this.querySelectorAll('.card__swatch').forEach((el) => el.setAttribute('aria-pressed', String(el === swatch)));
      this.showImage(swatch);
      if (swatch.dataset.url) this.links.forEach((link) => (link.href = swatch.dataset.url));
    };

    showImage(swatch) {
      if (!this.image) return;
      if (swatch.dataset.src) {
        this.image.srcset = swatch.dataset.srcset;
        this.image.src = swatch.dataset.src;
      } else if (this.original) {
        this.image.srcset = this.original.srcset;
        this.image.src = this.original.src;
      }
    }
  }

  if (!customElements.get('card-swatches')) {
    customElements.define('card-swatches', CardSwatches);
  }
{% endjavascript %}
