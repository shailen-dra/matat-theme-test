{% doc %}
  Renders a product card: image (with an optional second image on hover),
  sale / sold-out badge, wishlist heart, quick add button, vendor, title and
  price. The wishlist and quick add follow the "Product cards" theme settings.

  Without a `product` it renders a placeholder card using a demo image, so
  grids look complete on stores that have no products yet.

  @param {product} [product] - The product to show
  @param {string} [placeholder_image] - Theme asset used when `product` is blank
  @param {string} [ratio] - Image ratio class: `card--portrait` (default), `card--square` or `card--natural`
  @param {boolean} [show_secondary_image] - Shows the second product image on hover
  @param {boolean} [show_vendor] - Shows the vendor above the title
  @param {string} [sizes] - The `sizes` attribute for the image
  @param {string} [loading] - Image loading strategy (default `lazy`)

  @example
  {% render 'product-card', product: product, show_secondary_image: true %}
  {% render 'product-card', placeholder_image: 'demo-hoops.jpg' %}
{% enddoc %}

{%- liquid
  assign ratio = ratio | default: 'card--portrait'
  assign sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign loading = loading | default: 'lazy'

  if product != blank
    assign image = product.featured_media.preview_image
    assign secondary_image = null
    if show_secondary_image and product.media.size > 1
      assign secondary_image = product.media[1].preview_image
    endif
    assign on_sale = false
    if product.compare_at_price > product.price
      assign on_sale = true
    endif
    assign price_min = product.price_min | money
    assign from_price = 'product.card.from_price' | t: price: price_min
  endif

  assign ratio_style = ''
  if ratio == 'card--natural' and image != blank
    assign ratio_style = '--card-ratio: ' | append: image.aspect_ratio
  endif
-%}

<article class="card {{ ratio }}{% if secondary_image != blank %} card--has-secondary{% endif %}">
  {%- if product != blank -%}
    <div class="card__media-wrap">
      <a href="{{ product.url }}" class="card__media" style="{{ ratio_style }}" tabindex="-1" aria-hidden="true">
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1100
            | image_tag: widths: '300, 450, 600, 750, 900, 1100', sizes: sizes, loading: loading, class: 'card__image', alt: ''
          }}
          {%- if secondary_image != blank -%}
            {{
              secondary_image
              | image_url: width: 1100
              | image_tag: widths: '300, 450, 600, 750, 900, 1100', sizes: sizes, loading: 'lazy', class: 'card__image card__image--secondary', alt: ''
            }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'card__image card__placeholder' }}
        {%- endif -%}
      </a>

      {%- if product.available == false -%}
        <span class="card__badge">{{ 'product.sold_out' | t }}</span>
      {%- elsif on_sale -%}
        <span class="card__badge card__badge--sale">{{ 'product.price.sale_badge' | t }}</span>
      {%- endif -%}

      {%- if settings.enable_wishlist -%}
        <div class="card__wishlist">{% render 'wishlist-button', product: product %}</div>
      {%- endif -%}

      {%- if settings.enable_quick_add -%}
        <div class="card__quick-add">{% render 'quick-add', product: product %}</div>
      {%- endif -%}
    </div>

    <div class="card__info">
      {%- if show_vendor -%}
        <p class="card__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h3 class="card__title">
        <a href="{{ product.url }}" class="card__link">{{ product.title }}</a>
      </h3>
      <p class="card__price">
        {%- if on_sale -%}
          <span class="visually-hidden">{{ 'product.price.sale' | t }}</span>
          <span class="card__price-current">
            {%- if product.price_varies -%}
              {{ from_price }}
            {%- else -%}
              {{ product.price | money }}
            {%- endif -%}
          </span>
          <span class="visually-hidden">{{ 'product.price.regular' | t }}</span>
          <s class="card__price-compare">{{ product.compare_at_price | money }}</s>
        {%- elsif product.price_varies -%}
          {{ from_price }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </p>
    </div>
  {%- else -%}
    <div class="card__media">
      <img
        src="{{ placeholder_image | default: 'demo-ginkgo-set.jpg' | asset_img_url: '600x' }}"
        srcset="{{ placeholder_image | default: 'demo-ginkgo-set.jpg' | asset_img_url: '450x' }} 450w, {{ placeholder_image | default: 'demo-ginkgo-set.jpg' | asset_img_url: '750x' }} 750w"
        sizes="{{ sizes }}"
        width="750"
        height="1000"
        alt=""
        class="card__image"
        loading="{{ loading }}"
      >
    </div>
    <div class="card__info">
      <h3 class="card__title">{{ 'product.card.placeholder_title' | t }}</h3>
      <p class="card__price">{{ 129000 | money }}</p>
    </div>
  {%- endif -%}
</article>

{% stylesheet %}
  .card {
    --card-ratio: 3 / 4;

    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .card--square {
    --card-ratio: 1;
  }

  .card__media-wrap {
    position: relative;
  }

  .card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--card-ratio);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons);
    background-color: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s ease, transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .card__placeholder {
    fill: color-mix(in srgb, var(--color-foreground) 25%, transparent);
  }

  .card__image--secondary {
    opacity: 0;
  }

  .card:hover .card__image {
    transform: scale(1.04);
  }

  .card--has-secondary:hover .card__image--secondary {
    opacity: 1;
  }

  .card__badge {
    position: absolute;
    top: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.375rem 0.625rem;
    border-radius: var(--style-border-radius-buttons);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  .card__wishlist {
    position: absolute;
    top: 0.625rem;
    inset-inline-end: 0.625rem;
    z-index: 2;
  }

  .card__quick-add {
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
  }

  /* Pointer devices: the quick add bar slides in on hover / keyboard focus */
  @media (hover: hover) {
    .card__quick-add {
      opacity: 0;
      transform: translateY(0.5rem);
      transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .card:hover .card__quick-add,
    .card__quick-add:focus-within {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: none) {
    .card__quick-add {
      inset-inline-start: auto;
    }
  }

  .card__badge--sale {
    background-color: var(--color-accent);
    color: #fff;
  }

  .card__info {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .card__vendor {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .card__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1rem, 0.4vw + 0.875rem, 1.1875rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.3;
  }

  .card__link {
    color: inherit;
    text-decoration: none;
  }

  /* Whole card is clickable through the title link */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) .card__media {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .card__price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .card__price-current {
    color: var(--color-accent);
  }

  .card__price-compare {
    opacity: 0.55;
  }

  [dir='rtl'] :is(.card__badge, .card__vendor) {
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .card__image {
      transition: none;
    }
  }
{% endstylesheet %}
