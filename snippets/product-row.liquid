{% doc %}
  Renders a compact horizontal product row: thumbnail, title, price and a
  round quick add button. Used by the shop the look list and the cart drawer
  suggestions. Without a `product` it renders a placeholder row.

  @param {product} [product] - The product to show
  @param {string} [placeholder_image] - Theme asset used when `product` is blank
  @param {string} [id] - Id of the row element
  @param {string} [block_id] - Hotspot block id the row belongs to
  @param {string} [heading_tag] - Title element (default `h3`)

  @example
  {% render 'product-row', product: product %}
  {% render 'product-row', product: block.settings.product, id: 'LookItem-1', block_id: block.id %}
{% enddoc %}

{%- liquid
  assign heading_tag = heading_tag | default: 'h3'
  assign placeholder_image = placeholder_image | default: 'demo-hoops.jpg'
-%}

<div
  class="product-row"
  {% if id != blank %}
    id="{{ id }}"
  {% endif %}
  {% if block_id != blank %}
    data-look-item="{{ block_id }}"
  {% endif %}
>
  {%- if product != blank -%}
    <a href="{{ product.url }}" class="product-row__media" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{
          product.featured_media.preview_image
          | image_url: width: 240
          | image_tag: widths: '80, 160, 240', sizes: '80px', loading: 'lazy', class: 'product-row__image', alt: ''
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-row__image product-row__placeholder' }}
      {%- endif -%}
    </a>

    <div class="product-row__info">
      <{{ heading_tag }} class="product-row__title">
        <a href="{{ product.url }}" class="product-row__link">{{ product.title | escape }}</a>
      </{{ heading_tag }}>
      <p class="product-row__price">
        {%- if product.price_varies -%}
          {%- assign price_min = product.price_min | money -%}
          {{ 'product.card.from_price' | t: price: price_min }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
        {%- if product.compare_at_price > product.price -%}
          <span class="visually-hidden">{{ 'product.price.regular' | t }}</span>
          <s class="product-row__compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </p>
    </div>

    {%- if settings.enable_quick_add -%}
      <div class="product-row__action">{% render 'quick-add', product: product %}</div>
    {%- endif -%}
  {%- else -%}
    <span class="product-row__media">
      <img
        src="{{ placeholder_image | asset_img_url: '240x' }}"
        width="240"
        height="240"
        alt=""
        class="product-row__image"
        loading="lazy"
      >
    </span>
    <div class="product-row__info">
      <{{ heading_tag }} class="product-row__title">{{ 'product.card.placeholder_title' | t }}</{{ heading_tag }}>
      <p class="product-row__price">{{ 1999 | money }}</p>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-row {
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: var(--style-border-radius-buttons);
    background-color: var(--color-background);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .product-row.is-active {
    border-color: var(--color-accent);
    box-shadow: 0 6px 24px color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }

  .product-row__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
    border-radius: calc(var(--style-border-radius-buttons) * 0.75);
    background-color: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .product-row__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-row__placeholder {
    fill: color-mix(in srgb, var(--color-foreground) 25%, transparent);
  }

  .product-row__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .product-row__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.0625rem;
    font-weight: var(--font-heading--weight);
    line-height: 1.3;
  }

  .product-row__link {
    color: inherit;
    text-decoration: none;
  }

  /* The whole row is clickable */
  .product-row__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .product-row__link:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .product-row__link:focus-visible {
    outline: none;
  }

  .product-row:has(.product-row__link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .product-row__price {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .product-row__compare {
    opacity: 0.75;
  }

  .product-row__action {
    position: relative;
    z-index: 1;
  }

  /* Always the compact round button */
  .product-row .quick-add__button {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 15%, transparent);
    border-radius: 50%;
  }

  .product-row .quick-add__text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .product-row .quick-add__icon {
    width: 1rem;
    height: 1rem;
  }
{% endstylesheet %}
