{%- comment -%}
  Predictive search results for the header search dialog. Not added to
  templates: `<predictive-search>` fetches it from `/search/suggest` with
  `section_id=predictive-search` while the shopper types.
{%- endcomment -%}

{%- liquid
  assign resources = predictive_search.resources
  assign terms = predictive_search.terms
  assign escaped_terms = terms | escape
  assign pages_and_articles = resources.pages | concat: resources.articles

  assign total = resources.products.size
  assign total = total | plus: resources.queries.size
  assign total = total | plus: resources.collections.size
  assign total = total | plus: pages_and_articles.size

  if total > 0
    assign status = 'predictive_search.status' | t: count: total, terms: escaped_terms
  else
    assign status = 'predictive_search.no_results' | t: terms: escaped_terms
  endif
-%}

{%- if predictive_search.performed -%}
  <div class="predictive" data-predictive-content data-status="{{ status | escape }}">
    {%- if total > 0 -%}
      <div class="predictive__grid">
        {%- if resources.queries.size > 0 or resources.collections.size > 0 or pages_and_articles.size > 0 -%}
          <div class="predictive__side">
            {%- if resources.queries.size > 0 -%}
              <div class="predictive__group">
                <h2 class="predictive__heading">{{ 'predictive_search.suggestions' | t }}</h2>
                <ul class="predictive__list" role="list">
                  {%- for query in resources.queries -%}
                    <li>
                      <a href="{{ query.url }}" class="predictive__link predictive__query">
                        {{- query.styled_text -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if resources.collections.size > 0 -%}
              <div class="predictive__group">
                <h2 class="predictive__heading">{{ 'predictive_search.collections' | t }}</h2>
                <ul class="predictive__list" role="list">
                  {%- for collection in resources.collections -%}
                    <li>
                      <a href="{{ collection.url }}" class="predictive__link">{{ collection.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            {%- if pages_and_articles.size > 0 -%}
              <div class="predictive__group">
                <h2 class="predictive__heading">{{ 'predictive_search.pages' | t }}</h2>
                <ul class="predictive__list" role="list">
                  {%- for result in pages_and_articles -%}
                    <li>
                      <a href="{{ result.url }}" class="predictive__link">{{ result.title | escape }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if resources.products.size > 0 -%}
          <div class="predictive__group predictive__products">
            <h2 class="predictive__heading">{{ 'predictive_search.products' | t }}</h2>
            <ul class="predictive__list" role="list">
              {%- for product in resources.products -%}
                {%- assign image = product.featured_media.preview_image -%}
                <li>
                  <a href="{{ product.url }}" class="predictive__product">
                    <span class="predictive__media">
                      {%- if image != blank -%}
                        {{
                          image
                          | image_url: width: 160
                          | image_tag: widths: '80, 120, 160', sizes: '64px', loading: 'lazy', class: 'predictive__image', alt: ''
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'predictive__image predictive__placeholder' }}
                      {%- endif -%}
                    </span>
                    <span class="predictive__product-info">
                      <span class="predictive__product-title">{{ product.title | escape }}</span>
                      <span class="predictive__price">
                        {%- if product.available == false -%}
                          {{ 'product.sold_out' | t }}
                        {%- elsif product.price_varies -%}
                          {%- assign price_min = product.price_min | money -%}
                          {{ 'product.card.from_price' | t: price: price_min }}
                        {%- else -%}
                          {{ product.price | money }}
                        {%- endif -%}
                      </span>
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="predictive__empty">{{ status }}</p>
    {%- endif -%}

    <a href="{{ routes.search_url }}?q={{ terms | url_encode }}&options%5Bprefix%5D=last" class="predictive__all">
      <span>{{ 'predictive_search.search_for' | t: terms: escaped_terms }}</span>
      {% render 'icon', name: 'arrow', class: 'predictive__all-icon' %}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  .predictive-search__results {
    max-width: 48rem;
    max-height: calc(100dvh - 8rem);
    margin-inline: auto;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .predictive-search[aria-busy='true'] .predictive-search__results {
    opacity: 0.6;
  }

  .predictive {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 1.5rem 0.5rem;
  }

  .predictive__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
  }

  .predictive__grid > .predictive__products:only-child {
    grid-column: 1 / -1;
  }

  .predictive__side {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .predictive__group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .predictive__heading {
    margin: 0;
    font-family: var(--font-primary--family);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  [dir='rtl'] .predictive__heading {
    letter-spacing: 0;
  }

  .predictive__list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive__link {
    display: block;
    padding-block: 0.3125rem;
    color: inherit;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .predictive__link:hover {
    color: var(--color-accent);
  }

  /* Suggested searches: the typed part is regular, the completion bold */
  .predictive__query mark {
    background: none;
    color: inherit;
    font-weight: 600;
  }

  .predictive__products .predictive__list {
    gap: 0.5rem;
  }

  .predictive__product {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.375rem 0;
    border-radius: var(--style-border-radius-buttons);
    color: inherit;
    text-decoration: none;
  }

  .predictive__product:hover .predictive__product-title {
    color: var(--color-accent);
  }

  .predictive__media {
    flex: none;
    width: 4rem;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons);
    background-color: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .predictive__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .predictive__placeholder {
    fill: color-mix(in srgb, var(--color-foreground) 25%, transparent);
  }

  .predictive__product-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .predictive__product-title {
    font-family: var(--font-heading--family);
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .predictive__price {
    font-size: 0.875rem;
    opacity: 0.75;
  }

  .predictive__empty {
    font-size: 0.9375rem;
    opacity: 0.75;
  }

  .predictive__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
  }

  .predictive__all:hover {
    color: var(--color-accent);
  }

  .predictive__all-icon {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  [dir='rtl'] .predictive__all-icon {
    transform: scaleX(-1);
  }

  :is(.predictive__link, .predictive__product, .predictive__all):focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (max-width: 749px) {
    .predictive__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .predictive__products {
      order: -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.predictive_search.name",
  "settings": []
}
{% endschema %}
