{% comment %}
  This section is used in the list-collections template to render every
  collection with its image, title and product count, either as a grid of
  image cards or as a numbered contents list. In the contents layout each row
  is ruled like the collection index view, and on desktop the collection's
  photo follows the cursor (`collections-index` in assets/product-components.js).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/list-collections
{% endcomment %}

{%- liquid
  assign is_index = false
  assign root_tag = 'div'
  if section.settings.layout == 'collections-list--index'
    assign is_index = true
    assign root_tag = 'collections-index'
  endif
-%}

<{{ root_tag }}
  class="collections-list section {{ section.settings.layout }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --collections-columns: {{ section.settings.columns_desktop }};
    --collections-columns-mobile: {{ section.settings.columns_mobile }};
  "
>
  {%- liquid
    assign title = section.settings.title
    if title == blank
      assign title = 'collections.title' | t
    endif
    assign eager_count = section.settings.columns_desktop | plus: 0
  -%}
  {% render 'section-heading',
    eyebrow: section.settings.eyebrow,
    title: title,
    subtitle: section.settings.subtitle,
    title_style: 'heading--h1',
    title_tag: 'h1'
  %}

  {%- paginate collections by 24 -%}
    <ul class="collections-list__grid {{ section.settings.image_ratio }}" role="list">
      {%- for collection in collections -%}
        <li>
          <a href="{{ collection.url }}" class="collection-card">
            <span class="collection-card__media">
              {%- if collection.featured_image -%}
                {%- liquid
                  if forloop.index <= eager_count
                    assign loading = 'eager'
                  else
                    assign loading = 'lazy'
                  endif
                -%}
                {{
                  collection.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '300, 450, 600, 800, 1000, 1200',
                    sizes: '(min-width: 990px) calc(100vw / 3), 50vw',
                    loading: loading,
                    class: 'collection-card__image',
                    alt: ''
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
              {%- endif -%}
            </span>
            <span class="collection-card__label">
              {%- if is_index -%}
                {%- liquid
                  assign row_number = paginate.current_offset | plus: forloop.index
                  if row_number < 10
                    assign row_number = '0' | append: row_number
                  endif
                -%}
                <span class="collection-card__number">{{ 'product.card.number' | t: number: row_number }}</span>
              {%- endif -%}
              <span class="collection-card__title">{{ collection.title | escape }}</span>
              {%- if section.settings.show_count -%}
                <span class="collection-card__count">
                  {{- 'collections.product_count' | t: count: collection.all_products_count -}}
                </span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
  {%- if is_index -%}
    <div class="index-preview" aria-hidden="true"></div>
  {%- endif -%}
</{{ root_tag }}>

{% stylesheet %}
  .collections-list__grid {
    --collection-ratio: 3 / 4;

    display: grid;
    grid-template-columns: repeat(var(--collections-columns), minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collections-list__grid.collections-list--square {
    --collection-ratio: 1;
  }

  .collections-list__grid.collections-list--landscape {
    --collection-ratio: 4 / 3;
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .collection-card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--collection-ratio);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons);
    background-color: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .collection-card__image,
  .collection-card__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .collection-card__placeholder {
    fill: color-mix(in srgb, var(--color-foreground) 25%, transparent);
  }

  .collection-card:hover :is(.collection-card__image, .collection-card__placeholder) {
    transform: scale(1.04);
  }

  .collection-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .collection-card__label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .collection-card__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.125rem, 0.75vw + 0.9rem, 1.375rem);
    font-weight: var(--font-heading--weight);
    line-height: 1.25;
  }

  .collection-card__count {
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  @media (max-width: 989px) {
    .collections-list__grid {
      grid-template-columns: repeat(min(var(--collections-columns), 3), minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .collections-list__grid {
      grid-template-columns: repeat(var(--collections-columns-mobile), minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-card__image,
    .collection-card__placeholder {
      transition: none;
    }
  }

  /*
    Contents list: the collections as a numbered table of contents. Ruled
    rows carry the number, the title and the product count; phones show a
    small plate on each row, and desktop drops it for the photo that follows
    the cursor.
  */
  .collections-list--index .collections-list__grid {
    display: block;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
  }

  .collections-list--index .collections-list__grid > li {
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
  }

  .collections-list--index .collection-card {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .collections-list--index .collection-card__media {
    aspect-ratio: 1;
    border-radius: 0;
  }

  .collections-list--index .collection-card__label {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'number number'
      'title count';
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .collection-card__number {
    grid-area: number;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .collections-list--index .collection-card__title {
    grid-area: title;
  }

  .collections-list--index .collection-card__count {
    grid-area: count;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    opacity: 0.72;
  }

  .collections-list--index .collection-card:hover .collection-card__title {
    color: var(--color-accent);
  }

  @media (min-width: 750px) {
    .collections-list--index .collection-card {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 1.125rem;
      transition: padding-inline 0.3s ease;
    }

    .collections-list--index .collection-card__media {
      display: none;
    }

    .collections-list--index .collection-card__label {
      grid-template-columns: 5rem minmax(0, 1fr) auto;
      grid-template-areas: 'number title count';
    }

    .collections-list--index .collection-card__title {
      font-size: clamp(1.25rem, 2vw, 1.875rem);
    }

    .collections-list--index .collection-card:hover,
    .collections-list--index .collection-card:focus-visible {
      padding-inline-start: 0.75rem;
    }
  }

  [dir='rtl'] :is(.collection-card__number, .collections-list--index .collection-card__count) {
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .collections-list--index .collection-card {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:labels.heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:labels.subtitle"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "collections-list--grid", "label": "t:sections.collections_list.layout_grid" },
        { "value": "collections-list--index", "label": "t:sections.collections_list.layout_index" }
      ],
      "default": "collections-list--grid"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "visible_if": "{{ section.settings.layout == 'collections-list--grid' }}",
      "label": "t:labels.columns_desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "visible_if": "{{ section.settings.layout == 'collections-list--grid' }}",
      "label": "t:labels.columns_mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "collections-list--portrait", "label": "t:options.ratio.portrait" },
        { "value": "collections-list--square", "label": "t:options.ratio.square" },
        { "value": "collections-list--landscape", "label": "t:options.ratio.landscape" }
      ],
      "default": "collections-list--portrait"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.collections_list.show_count",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
