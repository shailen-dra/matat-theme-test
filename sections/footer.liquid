{%- liquid
  assign current_year = 'now' | date: '%Y'

  assign block_count = section.blocks.size
  if block_count < 1
    assign block_count = 1
  endif
-%}

<footer
  class="footer full-width{% if section.settings.first_column_wide %} footer--first-wide{% endif %}"
  style="
    --color-background: {{ section.settings.background_color }};
    --color-foreground: {{ section.settings.text_color }};
    --footer-columns: {{ block_count }};
    --footer-padding-top: {{ section.settings.padding_top }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="footer__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <footer-wordmark class="footer__wordmark" aria-hidden="true">
        <span class="footer__wordmark-text">{{ shop.name }}</span>
      </footer-wordmark>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__legal">
        <p class="footer__copyright">
          {{ 'footer.copyright' | t: year: current_year, shop: shop.name }}
          {%- if section.settings.show_powered_by %}
            · {{ powered_by_link }}
          {%- endif -%}
        </p>

        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__utilities">
        {%- if section.settings.show_language -%}
          {% render 'language-switcher' %}
        {%- endif -%}

        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <ul class="footer__payment" role="list">
            <li class="visually-hidden">{{ 'footer.payment_methods' | t }}</li>
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    padding-block: var(--footer-padding-top) var(--footer-padding-bottom);
    background-color: var(--color-background);
    color: var(--color-foreground);
    container-type: inline-size;
  }

  .footer__inner {
    display: grid;
    gap: 3.5rem;
    width: var(--content-width);
    margin-inline: auto;
  }

  .footer__blocks {
    display: grid;
    grid-template-columns: repeat(var(--footer-columns), minmax(0, 1fr));
    gap: 3rem 2.5rem;
  }

  .footer--first-wide .footer__blocks {
    grid-template-columns: minmax(0, 1.75fr) repeat(calc(var(--footer-columns) - 1), minmax(0, 1fr));
  }

  /* Small screens: menu columns pair up, everything else spans the full width */
  @media (max-width: 989px) {
    .footer .footer__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__blocks > :not(.menu-block) {
      grid-column: 1 / -1;
    }
  }

  .footer__wordmark {
    display: block;
    overflow: hidden;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
    line-height: 0.85;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.9;
    user-select: none;
  }

  .footer__wordmark-text {
    display: inline-block;
    font-size: var(--wordmark-size, 12cqi);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block-start: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    font-size: 0.8125rem;
  }

  .footer__legal,
  .footer__utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .footer__copyright a,
  .footer__policies a {
    color: inherit;
    text-decoration: none;
  }

  .footer__copyright a:hover,
  .footer__policies a:hover {
    color: var(--color-foreground);
  }

  .footer__policies,
  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__payment {
    gap: 0.375rem;
  }

  .footer__payment-icon {
    width: 2.125rem;
    height: auto;
  }
{% endstylesheet %}

{% javascript %}
  /** Scales the wordmark so the store name fills the footer width exactly. */
  class FooterWordmark extends HTMLElement {
    connectedCallback() {
      this.text = this.querySelector('.footer__wordmark-text');
      if (!this.text) return;
      this.resizeObserver = new ResizeObserver(() => this.fit());
      this.resizeObserver.observe(this);
      document.fonts?.ready.then(() => this.fit());
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
    }

    fit() {
      const probeSize = 100;
      this.text.style.setProperty('--wordmark-size', `${probeSize}px`);
      const ratio = this.clientWidth / this.text.scrollWidth;
      this.text.style.setProperty('--wordmark-size', `${Math.floor(probeSize * ratio)}px`);
    }
  }

  if (!customElements.get('footer-wordmark')) {
    customElements.define('footer-wordmark', FooterWordmark);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "div",
  "class": "footer-section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#141312"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#ede8df"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "checkbox",
      "id": "first_column_wide",
      "label": "t:sections.footer.first_column_wide",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "t:sections.footer.show_wordmark",
      "info": "t:sections.footer.show_wordmark_info",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:sections.footer.bottom_bar"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:sections.footer.show_policies",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:sections.header.show_language",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:sections.footer.show_powered_by",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        {
          "type": "group",
          "settings": { "layout_direction": "group--vertical", "gap": 20 },
          "blocks": [
            { "type": "heading", "settings": { "text": "Fine jewelry, made to be <em>kept</em>.", "style": "heading--h3", "tag": "p" } },
            { "type": "text", "settings": { "text": "<p>Recycled gold and ethically sourced stones, crafted in small batches.</p>", "size": "text--small", "muted": true, "max_width": 40 } },
            { "type": "social-links" }
          ]
        },
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "Help", "menu": "footer" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
