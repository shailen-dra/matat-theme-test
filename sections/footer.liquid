{%- liquid
  assign current_year = 'now' | date: '%Y'

  assign block_count = section.blocks.size
  if block_count < 1
    assign block_count = 1
  endif

  # On a dark footer the accent is lightened so accent text stays readable
  assign footer_accent = settings.body_color_scheme.settings.accent
  assign footer_brightness = section.settings.background_color | color_brightness
  if footer_brightness < 128
    assign footer_accent = footer_accent | color_lighten: 22
  endif

  assign footer_style = section.settings.style
  if footer_style == 'theme'
    assign footer_style = settings.footer_style
  endif
-%}

<footer
  class="footer full-width {{ footer_style }}{% if section.settings.first_column_wide %} footer--first-wide{% endif %}"
  style="
    --color-background: {{ section.settings.background_color }};
    --color-foreground: {{ section.settings.text_color }};
    --color-accent: {{ footer_accent }};
    --footer-columns: {{ block_count }};
    --footer-padding-top: {{ section.settings.padding_top }}px;
    --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="footer__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <footer-wordmark class="footer__wordmark" aria-hidden="true">
        <span class="footer__wordmark-text">{{ shop.name }}</span>
      </footer-wordmark>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__legal">
        <p class="footer__copyright">
          {{ 'footer.copyright' | t: year: current_year, shop: shop.name }}
          {%- if section.settings.show_powered_by %}
            · {{ powered_by_link }}
          {%- endif -%}
        </p>

        {%- if footer_style == 'footer--colophon' -%}
          {%- liquid
            assign heading_family = settings.type_heading_font.family
            assign body_family = settings.type_primary_font.family
          -%}
          <p class="footer__colophon">
            {%- if heading_family == body_family -%}
              {{- 'footer.colophon_single' | t: font: heading_family -}}
            {%- else -%}
              {{- 'footer.colophon' | t: heading: heading_family, body: body_family -}}
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul class="footer__policies" role="list">
            {%- for policy in shop.policies -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="footer__utilities">
        {%- if section.settings.show_country -%}
          {%- assign country_id = 'FooterCountry-' | append: section.id -%}
          {% render 'country-selector', id: country_id %}
        {%- endif -%}

        {%- if section.settings.show_language -%}
          {%- assign language_id = 'FooterLanguage-' | append: section.id -%}
          {% render 'language-switcher', id: language_id %}
        {%- endif -%}

        {%- if section.settings.show_follow_on_shop and request.page_type != 'password' -%}
          {%- # Renders only when Shop Pay is active; branded colors must stay as Shopify ships them -%}
          <div class="footer__follow">{{ shop | login_button: action: 'follow' }}</div>
        {%- endif -%}

        {%- liquid
          # Payment methods active in Settings > Payments
          assign payment_types = shop.enabled_payment_types
        -%}
        {%- if section.settings.show_payment_icons and payment_types.size > 0 -%}
          <ul class="footer__payment" role="list">
            <li class="visually-hidden">{{ 'footer.payment_methods' | t }}</li>
            {%- for type in payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer {
    padding-block: var(--footer-padding-top) var(--footer-padding-bottom);
    background-color: var(--color-background);
    color: var(--color-foreground);
    container-type: inline-size;
  }

  .footer__inner {
    display: grid;
    gap: 3.5rem;
    width: var(--content-width);
    margin-inline: auto;
  }

  .footer__blocks {
    display: grid;
    grid-template-columns: repeat(var(--footer-columns), minmax(0, 1fr));
    gap: 3rem 2.5rem;
  }

  .footer--first-wide .footer__blocks {
    grid-template-columns: minmax(0, 1.75fr) repeat(calc(var(--footer-columns) - 1), minmax(0, 1fr));
  }

  /* Small screens: menu columns pair up, everything else spans the full width */
  @media (max-width: 989px) {
    .footer .footer__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__blocks > :not(.menu-block) {
      grid-column: 1 / -1;
    }
  }

  /* Beside the desktop index rail the page is narrower, so keep the paired layout a little longer */
  @media (min-width: 990px) and (max-width: 1279px) {
    body:has(.header--rail) .footer .footer__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    body:has(.header--rail) .footer__blocks > :not(.menu-block) {
      grid-column: 1 / -1;
    }
  }

  .footer__wordmark {
    display: block;
    overflow: hidden;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
    line-height: 0.85;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.9;
    user-select: none;
  }

  .footer__wordmark-text {
    display: inline-block;
    font-size: var(--wordmark-size, 12cqi);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block-start: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
    font-size: 0.8125rem;
  }

  .footer__legal,
  .footer__utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .footer__copyright a,
  .footer__policies a {
    color: inherit;
    text-decoration: none;
  }

  .footer__copyright a:hover,
  .footer__policies a:hover {
    color: var(--color-foreground);
  }

  .footer__policies,
  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__payment {
    gap: 0.375rem;
  }

  .footer__payment-icon {
    width: 2.125rem;
    height: auto;
  }

  /*
    Colophon style: the footer as the back page of a printed catalogue. A
    heavy rule opens it, columns are divided by hairline rules, menu headings
    are numbered like the index rail, and the bottom line names the typefaces.
  */
  .footer--colophon {
    counter-reset: colophon;
  }

  .footer--colophon .footer__inner {
    gap: clamp(2.5rem, 4vw, 3.5rem);
    padding-block-start: clamp(1.75rem, 3vw, 2.5rem);
    border-block-start: 2px solid var(--color-foreground);
  }

  .footer--colophon .footer__blocks {
    column-gap: 0;
  }

  .footer--colophon .footer__blocks > * {
    padding-inline: clamp(1rem, 2vw, 1.75rem);
    border-inline-start: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
  }

  .footer--colophon .footer__blocks > :first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }

  .footer--colophon .footer__blocks > :last-child {
    padding-inline-end: 0;
  }

  .footer--colophon .menu-block {
    counter-increment: colophon;
  }

  .footer--colophon .menu-block__heading::before {
    content: counter(colophon, decimal-leading-zero);
    margin-inline-end: 0.75rem;
    font-variant-numeric: tabular-nums;
    opacity: 0.72;
  }

  .footer--colophon .footer__bottom {
    border-top-color: var(--color-foreground);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__colophon {
    margin: 0;
  }

  [dir='rtl'] .footer--colophon .footer__bottom {
    letter-spacing: 0;
  }

  /* Where columns pair up or stack, rules run across instead of down */
  @media (max-width: 989px) {
    .footer--colophon .footer__blocks {
      row-gap: 0;
    }

    .footer--colophon .footer__blocks > * {
      padding: 1.5rem 0;
      border-inline-start: 0;
      border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    }

    .footer--colophon .footer__blocks > :first-child {
      padding-block-start: 0;
      border-block-start: 0;
    }

    .footer--colophon .footer__blocks > .menu-block + .menu-block {
      padding-inline-start: 1rem;
      border-inline-start: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    }
  }

  @media (min-width: 990px) and (max-width: 1279px) {
    body:has(.header--rail) .footer--colophon .footer__blocks {
      row-gap: 0;
    }

    body:has(.header--rail) .footer--colophon .footer__blocks > * {
      padding: 1.5rem 0;
      border-inline-start: 0;
      border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    }

    body:has(.header--rail) .footer--colophon .footer__blocks > :first-child {
      padding-block-start: 0;
      border-block-start: 0;
    }

    body:has(.header--rail) .footer--colophon .footer__blocks > .menu-block + .menu-block {
      padding-inline-start: 1rem;
      border-inline-start: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    }
  }

  /*
    Floating card style: the footer is a rounded panel inset from the page edges
    (lined up with the glass bubble header), with a soft accent glow, a glass
    newsletter card, round social buttons and animated link underlines.
  */
  .footer--card {
    --footer-card-radius: 2rem;

    margin: 0.5rem max(0.5rem, calc((100% - var(--content-width)) / 2 - 1.25rem));
    border-radius: var(--footer-card-radius);
    background-image: radial-gradient(
      ellipse 60% 70% at 100% 0%,
      color-mix(in srgb, var(--color-accent) 16%, transparent),
      transparent 70%
    );
  }

  .footer--card .footer__inner {
    width: min(var(--content-width), calc(100% - 5rem));
  }

  .footer--card .footer__bottom {
    border-top-color: color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .footer--card .newsletter {
    padding: 1.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    border-radius: 1.5rem;
    background-color: color-mix(in srgb, var(--color-foreground) 5%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .footer--card .newsletter--boxed .newsletter__input,
  .footer--card .newsletter--boxed .button {
    border-radius: 999px;
  }

  .footer--card .newsletter--boxed .newsletter__input {
    padding-inline: 1.25rem;
  }

  .footer--card .social-links {
    gap: 0.625rem;
    margin-inline-start: 0;
  }

  .footer--card .social-links__link {
    border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
    border-radius: 50%;
    transition:
      color 0.25s ease,
      background-color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .footer--card .social-links__link:hover {
    border-color: var(--color-foreground);
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .footer--card .menu-block__link {
    background-image: linear-gradient(currentcolor, currentcolor);
    background-position: left 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition:
      color 0.2s ease,
      background-size 0.3s ease;
  }

  [dir='rtl'] .footer--card .menu-block__link {
    background-position: right 100%;
  }

  .footer--card .menu-block__link:hover {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer--card .social-links__link:hover {
      transform: translateY(-2px);
    }
  }

  @media (max-width: 749px) {
    .footer--card {
      --footer-card-radius: 1.5rem;
    }

    .footer--card .footer__inner {
      width: calc(100% - 2.5rem);
    }

    .footer--card .newsletter {
      padding: 1.25rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  /** Scales the wordmark so the store name fills the footer width exactly. */
  class FooterWordmark extends HTMLElement {
    connectedCallback() {
      this.text = this.querySelector('.footer__wordmark-text');
      if (!this.text) return;
      this.resizeObserver = new ResizeObserver(() => this.fit());
      this.resizeObserver.observe(this);
      document.fonts?.ready.then(() => this.fit());
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
    }

    fit() {
      const probeSize = 100;
      this.text.style.setProperty('--wordmark-size', `${probeSize}px`);
      const ratio = this.clientWidth / this.text.scrollWidth;
      this.text.style.setProperty('--wordmark-size', `${Math.floor(probeSize * ratio)}px`);
    }
  }

  if (!customElements.get('footer-wordmark')) {
    customElements.define('footer-wordmark', FooterWordmark);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "tag": "div",
  "class": "footer-section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.footer.style",
      "options": [
        { "value": "theme", "label": "t:settings.style.use_theme" },
        { "value": "footer--classic", "label": "t:sections.footer.style_classic" },
        { "value": "footer--card", "label": "t:sections.footer.style_card" },
        { "value": "footer--colophon", "label": "t:sections.footer.style_colophon" }
      ],
      "default": "theme"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#141312"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#ede8df"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "checkbox",
      "id": "first_column_wide",
      "label": "t:sections.footer.first_column_wide",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "t:sections.footer.show_wordmark",
      "info": "t:sections.footer.show_wordmark_info",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:sections.footer.bottom_bar"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:sections.footer.show_policies",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:sections.footer.show_follow_on_shop",
      "info": "t:sections.footer.show_follow_on_shop_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "t:sections.header.show_country",
      "info": "t:sections.header.show_country_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:sections.header.show_language",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:sections.footer.show_powered_by",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        {
          "type": "group",
          "settings": { "layout_direction": "group--vertical", "gap": 20 },
          "blocks": [
            { "type": "heading", "settings": { "text": "Tell customers <em>about your brand</em>.", "style": "heading--h3", "tag": "p" } },
            { "type": "text", "settings": { "text": "<p>Share a short description of your store, your values or what makes your products special.</p>", "size": "text--small", "muted": true, "max_width": 40 } },
            { "type": "social-links" }
          ]
        },
        { "type": "menu", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "menu", "settings": { "heading": "Help", "menu": "footer" } },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
