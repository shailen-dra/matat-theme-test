{% comment %}
  Collection page: intro with optional image, filters (sidebar on desktop,
  drawer on mobile), sorting, active filter pills, product grid and
  pagination. Filtering and sorting re-render the section in place with the
  Section Rendering API, and the page still works as plain links/forms
  without JavaScript.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- liquid
  assign form_id = 'FacetsForm-' | append: section.id
  assign panel_id = 'Facets-' | append: section.id
  assign grid_id = 'ProductGrid-' | append: section.id

  assign show_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif

  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign active_filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    else
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif
  endfor

  assign columns = section.settings.columns_desktop
  assign grid_share = 100
  if show_filters
    assign grid_share = 75
  endif
  assign desktop_width = grid_share | divided_by: columns
  capture sizes
    echo '(min-width: 990px) ' | append: desktop_width | append: 'vw, '
    if section.settings.columns_mobile == '1'
      echo '100vw'
    else
      echo '50vw'
    endif
  endcapture

  assign show_image = false
  if section.settings.show_image and collection.image != blank
    assign show_image = true
  endif
-%}

<collection-facets
  class="collection section full-width"
  data-section-id="{{ section.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <header class="collection__intro{% if show_image %} collection__intro--image{% endif %}">
    <div class="collection__intro-text">
      <p class="heading heading--eyebrow heading--accent">{{ 'collections.eyebrow' | t }}</p>
      <h1 class="heading heading--h1 collection__title">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="rte collection__description">{{ collection.description }}</div>
      {%- endif -%}
    </div>
    {%- if show_image -%}
      <div class="collection__intro-media">
        {{
          collection.image
          | image_url: width: 1400
          | image_tag:
            widths: '450, 700, 1000, 1400',
            sizes: '(min-width: 990px) 40vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'collection__intro-image'
        }}
      </div>
    {%- endif -%}
  </header>

  <div class="collection__toolbar">
    <div class="collection__toolbar-start">
      {%- if show_filters -%}
        <button
          type="button"
          class="collection__filter-toggle"
          aria-controls="{{ panel_id }}"
          aria-expanded="false"
          data-facets-open
        >
          {% render 'icon', name: 'filter', class: 'collection__filter-icon' %}
          <span>{{ 'collections.filters.title' | t }}</span>
          <span class="facet__count{% if active_filter_count == 0 %} collection__hidden{% endif %}" data-facets-active-count>
            {{- active_filter_count -}}
          </span>
        </button>
      {%- endif -%}
      <p class="collection__count" data-facets-results-count role="status">
        {{- 'collections.product_count' | t: count: collection.products_count -}}
      </p>
    </div>

    {%- if section.settings.enable_sorting -%}
      <div class="collection__sort">
        <label for="SortBy-{{ section.id }}" class="collection__sort-label">{{ 'collections.sort.label' | t }}</label>
        <div class="collection__select">
          <select
            id="SortBy-{{ section.id }}"
            name="sort_by"
            form="{{ form_id }}"
            data-facets-sort
          >
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == sort_by %}
                  selected
                {% endif %}
              >
                {{- option.name | escape -}}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', name: 'chevron-down', class: 'collection__select-icon' %}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="collection__layout{% if show_filters %} collection__layout--filters{% endif %}">
    {%- if show_filters -%}
      <div class="collection__backdrop" data-facets-close hidden></div>
      <aside
        id="{{ panel_id }}"
        class="facets"
        aria-label="{{ 'collections.filters.title' | t }}"
        tabindex="-1"
        data-facets-panel
      >
        <div class="facets__header">
          <p class="facets__title">{{ 'collections.filters.title' | t }}</p>
          <button type="button" class="facets__close" data-facets-close>
            {% render 'icon', name: 'close' %}
            <span class="visually-hidden">{{ 'collections.filters.close' | t }}</span>
          </button>
        </div>

        <div class="facets__content" data-facets-form-wrapper>
          {%- liquid
            assign hidden_sort = ''
            unless section.settings.enable_sorting
              assign hidden_sort = collection.sort_by
            endunless
            render 'facets', results: collection, form_id: form_id, url: collection.url, sort_by: hidden_sort
          -%}
        </div>

        <div class="facets__footer">
          <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="button button--outline button--sm" data-facets-link>
            {{- 'collections.filters.clear_all' | t -}}
          </a>
          <button type="button" class="button button--primary button--sm" data-facets-close data-facets-view-results>
            {{- 'collections.filters.view_results' | t: count: collection.products_count -}}
          </button>
        </div>
      </aside>
    {%- elsif section.settings.enable_sorting -%}
      {%- # The sort select needs a form to submit without JavaScript -%}
      <form id="{{ form_id }}" action="{{ collection.url }}" method="get" data-facets-form></form>
    {%- endif -%}

    <div class="collection__results" data-facets-results>
      {%- if active_filter_count > 0 -%}
        <ul class="collection__pills" role="list" aria-label="{{ 'collections.filters.active' | t }}">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                {%- liquid
                  assign min_price = filter.min_value.value | default: 0 | money
                  assign max_price = filter.max_value.value | default: filter.range_max | money
                -%}
                <li>
                  <a href="{{ filter.url_to_remove }}" class="collection__pill" data-facets-link>
                    {{- min_price }} – {{ max_price -}}
                    {% render 'icon', name: 'close', class: 'collection__pill-icon' %}
                    <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- else -%}
              {%- for value in filter.active_values -%}
                <li>
                  <a href="{{ value.url_to_remove }}" class="collection__pill" data-facets-link>
                    {{- value.label | escape -}}
                    {% render 'icon', name: 'close', class: 'collection__pill-icon' %}
                    <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          <li>
            <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="collection__clear" data-facets-link>
              {{- 'collections.filters.clear_all' | t -}}
            </a>
          </li>
        </ul>
      {%- endif -%}

      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size > 0 -%}
          <ul
            id="{{ grid_id }}"
            class="product-grid collection__grid"
            role="list"
            style="
              --grid-columns: {{ columns }};
              --grid-columns-mobile: {{ section.settings.columns_mobile }};
            "
          >
            {%- for product in collection.products -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.index <= columns
                  assign loading = 'eager'
                endif
              -%}
              <li class="product-grid__item">
                {% render 'product-card',
                  product: product,
                  ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  sizes: sizes,
                  loading: loading
                %}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'pagination', paginate: paginate, anchor: '' %}
        {%- else -%}
          <div class="collection__empty">
            {%- if active_filter_count > 0 -%}
              <p class="heading heading--h3">{{ 'collections.empty.filtered_title' | t }}</p>
              <p class="collection__empty-text">{{ 'collections.empty.filtered_text' | t }}</p>
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="button button--outline" data-facets-link>
                {{- 'collections.filters.clear_all' | t -}}
              </a>
            {%- else -%}
              <p class="heading heading--h3">{{ 'collections.empty.title' | t }}</p>
              <p class="collection__empty-text">{{ 'collections.empty.text' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
                {{- 'collections.empty.button' | t -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</collection-facets>

{% stylesheet %}
  .collection {
    row-gap: 0;
  }

  /* Intro */
  .collection__intro {
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .collection__intro--image {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
  }

  .collection__intro-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 44rem;
  }

  .collection__description {
    font-size: clamp(1rem, 0.3vw + 0.9rem, 1.125rem);
    line-height: 1.7;
    opacity: 0.8;
  }

  .collection__intro-media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--style-border-radius-buttons);
  }

  .collection__intro-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Toolbar */
  .collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-block: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .collection__toolbar-start {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .collection__filter-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .collection__filter-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .collection__filter-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .collection__hidden {
    display: none;
  }

  .collection__count {
    font-size: 0.875rem;
    opacity: 0.65;
  }

  .collection__sort {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .collection__sort-label {
    font-size: 0.875rem;
    opacity: 0.65;
  }

  .collection__select {
    position: relative;
    display: flex;
    align-items: center;
  }

  .collection__select select {
    padding: 0.5rem 1.75rem 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    appearance: none;
  }

  [dir='rtl'] .collection__select select {
    padding: 0.5rem 0 0.5rem 1.75rem;
  }

  .collection__select select:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .collection__select-icon {
    position: absolute;
    inset-inline-end: 0;
    width: 1rem;
    height: 1rem;
    pointer-events: none;
  }

  /* Layout */
  .collection__layout {
    padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
  }

  .collection__layout--filters {
    display: grid;
    grid-template-columns: minmax(13rem, 16rem) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .collection__results {
    min-width: 0;
    transition: opacity 0.25s ease;
  }

  .collection[aria-busy='true'] .collection__results {
    opacity: 0.45;
    pointer-events: none;
  }

  /* Filter panel: a sticky sidebar on desktop */
  .facets {
    position: sticky;
    top: calc(var(--header-height, 0px) + 1.5rem);
    max-height: calc(100vh - var(--header-height, 0px) - 3rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
  }

  .facets:focus {
    outline: none;
  }

  .facets__header,
  .facets__footer,
  .collection__backdrop {
    display: none;
  }

  .facets__content .facet:first-child .facet__summary {
    padding-block-start: 0;
  }

  /* Active filter pills */
  .collection__pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }

  .collection__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 20%, transparent);
    border-radius: 999px;
    color: inherit;
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .collection__pill:hover {
    border-color: var(--color-foreground);
  }

  .collection__pill-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .collection__clear {
    margin-inline-start: 0.25rem;
    color: inherit;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
  }

  .collection__pill:focus-visible,
  .collection__clear:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Empty state */
  .collection__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(3rem, 8vw, 6rem) 1rem;
    text-align: center;
  }

  .collection__empty-text {
    max-width: 28rem;
    margin-block-end: 0.75rem;
    opacity: 0.7;
  }

  @media (max-width: 989px) {
    .collection__intro--image {
      grid-template-columns: minmax(0, 1fr);
    }

    .collection__layout--filters {
      display: block;
    }

    .collection__filter-toggle {
      display: inline-flex;
    }

    /* Filter panel becomes an off-canvas drawer */
    .facets {
      --facets-from: -100%;

      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 60;
      display: flex;
      flex-direction: column;
      width: min(26rem, 88vw);
      max-height: none;
      overflow: hidden;
      background-color: var(--color-background);
      color: var(--color-foreground);
      transform: translateX(var(--facets-from));
      visibility: hidden;
      transition: transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1), visibility 0s linear 0.35s;
    }

    [dir='rtl'] .facets {
      --facets-from: 100%;
    }

    .facets.is-open {
      transform: none;
      visibility: visible;
      transition: transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .facets__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem var(--page-margin);
      border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    }

    .facets__title {
      font-family: var(--font-heading--family);
      font-size: 1.125rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    [dir='rtl'] .facets__title {
      letter-spacing: 0;
    }

    .facets__close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      margin-inline-end: -0.75rem;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      cursor: pointer;
    }

    .facets__close .icon {
      width: 1.25rem;
      height: 1.25rem;
    }

    .facets__content {
      flex: 1;
      overflow-y: auto;
      padding: 0.5rem var(--page-margin);
    }

    .facets__content .facet:first-child .facet__summary {
      padding-block-start: 1.125rem;
    }

    .facets__footer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      padding: 1rem var(--page-margin);
      border-top: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    }

    .facets__footer .button {
      --button-pad-x: 0.75rem;
    }

    .collection__backdrop:not([hidden]) {
      position: fixed;
      inset: 0;
      z-index: 59;
      display: block;
      background-color: rgb(0 0 0 / 0.35);
    }
  }

  @media (max-width: 749px) {
    .collection__toolbar {
      flex-wrap: wrap;
      row-gap: 0.25rem;
    }

    .collection__sort-label {
      display: none;
    }

    .collection__count {
      font-size: 0.8125rem;
    }

    /* The drawer's "View N results" button carries the count instead */
    .collection__filter-toggle ~ .collection__count {
      display: none;
    }

    .collection__toolbar-start {
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .facets,
    .facets.is-open {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Filtering and sorting for the collection page. Form changes re-render the
   * section through the Section Rendering API and swap the results and the
   * filter form, keeping the URL in sync so results can be shared and the
   * back button works. On mobile the filter panel is an off-canvas drawer.
   */
  class CollectionFacets extends HTMLElement {
    connectedCallback() {
      this.sectionId = this.dataset.sectionId;
      this.addEventListener('change', this.onChange);
      this.addEventListener('input', this.onInput);
      this.addEventListener('submit', this.onSubmit);
      this.addEventListener('click', this.onClick);
      this.addEventListener('keydown', this.onKeydown);
      window.addEventListener('popstate', this.onPopState);
    }

    disconnectedCallback() {
      window.removeEventListener('popstate', this.onPopState);
      this.abortController?.abort();
      document.documentElement.style.removeProperty('overflow');
    }

    get form() {
      return this.querySelector('[data-facets-form]');
    }

    get panel() {
      return this.querySelector('[data-facets-panel]');
    }

    onChange = (event) => {
      if (event.target.matches('[data-facets-price]')) return;
      if (!event.target.closest('[data-facets-form], [data-facets-sort]')) return;
      this.submitForm();
    };

    /** Price fields update while typing, after a short pause */
    onInput = (event) => {
      if (!event.target.matches('[data-facets-price]')) return;
      clearTimeout(this.priceTimer);
      this.pricePending = true;
      this.priceTimer = setTimeout(() => this.submitForm(), 600);
    };

    onSubmit = (event) => {
      if (!event.target.matches('[data-facets-form]')) return;
      event.preventDefault();
      this.submitForm();
    };

    onClick = (event) => {
      const link = event.target.closest('a[data-facets-link]');
      if (link) {
        event.preventDefault();
        this.render(new URL(link.href, window.location.origin).searchParams.toString());
        return;
      }

      if (event.target.closest('[data-facets-open]')) this.openPanel();
      else if (event.target.closest('[data-facets-close]')) this.closePanel();
    };

    onKeydown = (event) => {
      if (event.key === 'Escape' && this.panel?.classList.contains('is-open')) this.closePanel();
    };

    onPopState = () => {
      this.render(window.location.search.slice(1), { updateHistory: false });
    };

    submitForm() {
      this.pricePending = false;
      const form = this.form;
      if (!form) return;
      const params = new URLSearchParams();
      for (const [key, value] of new FormData(form)) {
        if (value !== '') params.append(key, value);
      }
      this.render(params.toString());
    }

    async render(searchParams, { updateHistory = true } = {}) {
      this.abortController?.abort();
      this.abortController = new AbortController();
      this.setAttribute('aria-busy', 'true');

      const focusedId = this.contains(document.activeElement) ? document.activeElement.id : null;
      const priceValues = new Map(
        [...this.querySelectorAll('[data-facets-price]')].map((input) => [input.id, input.value])
      );
      const openFacets = new Set([...this.querySelectorAll('details.facet')].filter((d) => d.open).map((d) => d.id));
      const closedFacets = new Set([...this.querySelectorAll('details.facet')].filter((d) => !d.open).map((d) => d.id));

      try {
        const params = new URLSearchParams(searchParams);
        params.set('section_id', this.sectionId);
        const response = await fetch(`${window.location.pathname}?${params}`, {
          signal: this.abortController.signal,
        });
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const fresh = html.querySelector('collection-facets');
        if (!fresh) return;

        // Swap results, counts and the filter form; keep the panel itself so the drawer stays open
        [
          '[data-facets-results]',
          '[data-facets-results-count]',
          '[data-facets-active-count]',
          '[data-facets-form-wrapper]',
          '[data-facets-view-results]',
        ].forEach((selector) => {
          const current = this.querySelector(selector);
          const next = fresh.querySelector(selector);
          if (current && next) current.replaceWith(next);
        });

        // Keep the clear-all link pointing at the current sort order
        const clearLink = this.querySelector('.facets__footer [data-facets-link]');
        const freshClear = fresh.querySelector('.facets__footer [data-facets-link]');
        if (clearLink && freshClear) clearLink.href = freshClear.href;

        this.querySelectorAll('details.facet').forEach((details) => {
          if (openFacets.has(details.id)) details.open = true;
          if (closedFacets.has(details.id)) details.open = false;
        });

        // Don't overwrite a price the shopper is still typing
        if (this.pricePending) {
          this.querySelectorAll('[data-facets-price]').forEach((input) => {
            if (priceValues.has(input.id)) input.value = priceValues.get(input.id);
          });
        }

        if (focusedId) document.getElementById(focusedId)?.focus({ preventScroll: true });

        if (updateHistory) {
          const url = searchParams ? `${window.location.pathname}?${searchParams}` : window.location.pathname;
          window.history.pushState({}, '', url);
        }
      } catch (error) {
        if (error.name !== 'AbortError') {
