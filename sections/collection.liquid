{% comment %}
  Collection page: intro with optional image, filters (sidebar on desktop,
  drawer on mobile), sorting, active filter pills, product grid and
  pagination. Filtering and sorting re-render the section in place with the
  Section Rendering API, and the page still works as plain links/forms
  without JavaScript.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{%- liquid
  assign form_id = 'FacetsForm-' | append: section.id
  assign panel_id = 'Facets-' | append: section.id
  assign grid_id = 'ProductGrid-' | append: section.id

  assign show_filters = false
  if section.settings.enable_filtering and collection.filters.size > 0
    assign show_filters = true
  endif

  assign sort_by = collection.sort_by | default: collection.default_sort_by

  assign active_filter_count = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != null or filter.max_value.value != null
        assign active_filter_count = active_filter_count | plus: 1
      endif
    else
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif
  endfor

  assign filters_sidebar = false
  if show_filters and section.settings.filter_layout == 'sidebar'
    assign filters_sidebar = true
  endif

  assign columns = section.settings.columns_desktop
  assign grid_share = 100
  if filters_sidebar
    assign grid_share = 75
  endif
  assign desktop_width = grid_share | divided_by: columns
  capture sizes
    echo '(min-width: 990px) ' | append: desktop_width | append: 'vw, '
    # Mobile: subtract the page margins (and the gap between two columns)
    if section.settings.columns_mobile == '1'
      echo 'calc(100vw - 40px)'
    else
      echo 'calc(50vw - 28px)'
    endif
  endcapture

  assign show_image = false
  if section.settings.show_image and collection.image != blank
    assign show_image = true
  endif

  # Banner layout: the collection's own image, or the section's fallback image
  assign banner_image = collection.image | default: section.settings.banner_image
  assign show_banner = false
  if section.settings.intro_layout == 'banner' and banner_image != blank
    assign show_banner = true
    assign banner_image_style = 'object-position: ' | append: banner_image.presentation.focal_point
  endif
-%}

<collection-facets
  class="collection section full-width{% if show_banner %} collection--banner{% endif %}{% if filters_sidebar %} collection--filters-sidebar{% endif %}"
  data-section-id="{{ section.id }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if show_banner -%}
    <header
      class="collection__intro collection__banner {{ section.settings.banner_height }} {{ section.settings.banner_position_x }} {{ section.settings.banner_position_y }}"
      style="
        --banner-overlay: {{ section.settings.banner_overlay_opacity | divided_by: 100.0 }};
        --banner-text: {{ section.settings.banner_text_color }};
      "
    >
      <div class="collection__banner-media">
        {{
          banner_image
          | image_url: width: 3000
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2500, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'collection__banner-image',
            style: banner_image_style,
            alt: ''
        }}
      </div>
      <div class="collection__banner-overlay" aria-hidden="true"></div>
      <div class="collection__intro-text collection__banner-content">
        <p class="heading heading--eyebrow">{{ 'collections.eyebrow' | t }}</p>
        <h1 class="heading heading--h1 collection__title">{{ collection.title | escape }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="rte collection__description">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </header>
  {%- else -%}
  <header class="collection__intro{% if show_image %} collection__intro--image{% endif %}">
    <div class="collection__intro-text">
      <p class="heading heading--eyebrow heading--accent">{{ 'collections.eyebrow' | t }}</p>
      <h1 class="heading heading--h1 collection__title">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="rte collection__description">{{ collection.description }}</div>
      {%- endif -%}
    </div>
    {%- if show_image -%}
      <div class="collection__intro-media">
        {{
          collection.image
          | image_url: width: 1400
          | image_tag:
            widths: '450, 700, 1000, 1400',
            sizes: '(min-width: 990px) 40vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'collection__intro-image'
        }}
      </div>
    {%- endif -%}
  </header>
  {%- endif -%}

  <div class="collection__toolbar">
    <div class="collection__toolbar-start">
      {%- if show_filters -%}
        <button
          type="button"
          class="collection__filter-toggle"
          aria-controls="{{ panel_id }}"
          aria-expanded="false"
          data-facets-open
        >
          {% render 'icon', name: 'filter', class: 'collection__filter-icon' %}
          <span>{{ 'collections.filters.title' | t }}</span>
          <span class="facet__count{% if active_filter_count == 0 %} collection__hidden{% endif %}" data-facets-active-count>
            {{- active_filter_count -}}
          </span>
        </button>
      {%- endif -%}
      <p class="collection__count" data-facets-results-count role="status">
        {{- 'collections.product_count' | t: count: collection.products_count -}}
      </p>
    </div>

    {%- if section.settings.enable_sorting -%}
      <div class="collection__sort">
        <label for="SortBy-{{ section.id }}" class="collection__sort-label">{{ 'collections.sort.label' | t }}</label>
        <div class="collection__select">
          <select
            id="SortBy-{{ section.id }}"
            name="sort_by"
            form="{{ form_id }}"
            data-facets-sort
          >
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == sort_by %}
                  selected
                {% endif %}
              >
                {{- option.name | escape -}}
              </option>
            {%- endfor -%}
          </select>
          {% render 'icon', name: 'chevron-down', class: 'collection__select-icon' %}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="collection__layout{% if show_filters %} collection__layout--filters{% endif %}">
    {%- if show_filters -%}
      <div class="collection__backdrop" data-facets-close hidden></div>
      <aside
        id="{{ panel_id }}"
        class="facets"
        aria-label="{{ 'collections.filters.title' | t }}"
        tabindex="-1"
        data-facets-panel
      >
        <div class="facets__header">
          <p class="facets__title">{{ 'collections.filters.title' | t }}</p>
          <button type="button" class="facets__close" data-facets-close>
            {% render 'icon', name: 'close' %}
            <span class="visually-hidden">{{ 'collections.filters.close' | t }}</span>
          </button>
        </div>

        <div class="facets__content" data-facets-form-wrapper>
          {%- liquid
            assign hidden_sort = ''
            unless section.settings.enable_sorting
              assign hidden_sort = collection.sort_by
            endunless
            render 'facets', results: collection, form_id: form_id, url: collection.url, sort_by: hidden_sort
          -%}
        </div>

        <div class="facets__footer">
          <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="button button--outline button--sm" data-facets-link>
            {{- 'collections.filters.clear_all' | t -}}
          </a>
          <button type="button" class="button button--primary button--sm" data-facets-close data-facets-view-results>
            {{- 'collections.filters.view_results' | t: count: collection.products_count -}}
          </button>
        </div>
      </aside>
    {%- elsif section.settings.enable_sorting -%}
      {%- # The sort select needs a form to submit without JavaScript -%}
      <form id="{{ form_id }}" action="{{ collection.url }}" method="get" data-facets-form></form>
    {%- endif -%}

    <div class="collection__results" data-facets-results>
      {%- if active_filter_count > 0 -%}
        <ul class="collection__pills" role="list" aria-label="{{ 'collections.filters.active' | t }}">
          {%- for filter in collection.filters -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                {%- liquid
                  assign min_price = filter.min_value.value | default: 0 | money
                  assign max_price = filter.max_value.value | default: filter.range_max | money
                -%}
                <li>
                  <a href="{{ filter.url_to_remove }}" class="collection__pill" data-facets-link>
                    {{- min_price }} – {{ max_price -}}
                    {% render 'icon', name: 'close', class: 'collection__pill-icon' %}
                    <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- else -%}
              {%- for value in filter.active_values -%}
                <li>
                  <a href="{{ value.url_to_remove }}" class="collection__pill" data-facets-link>
                    {{- value.label | escape -}}
                    {% render 'icon', name: 'close', class: 'collection__pill-icon' %}
                    <span class="visually-hidden">{{ 'collections.filters.remove' | t }}</span>
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
          <li>
            <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="collection__clear" data-facets-link>
              {{- 'collections.filters.clear_all' | t -}}
            </a>
          </li>
        </ul>
      {%- endif -%}

      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size > 0 -%}
          <ul
            id="{{ grid_id }}"
            class="product-grid collection__grid"
            role="list"
            style="
              --grid-columns: {{ columns }};
              --grid-columns-mobile: {{ section.settings.columns_mobile }};
            "
          >
            {%- liquid
              assign show_promo = false
              if section.settings.promo_enabled and paginate.current_page == 1
                assign show_promo = true
              endif
              assign promo_position = section.settings.promo_position | at_most: collection.products.size
            -%}
            {%- for product in collection.products -%}
              {%- if show_promo and forloop.index == promo_position -%}
                <li class="product-grid__item product-grid__item--promo{% if section.settings.promo_wide %} product-grid__item--promo-wide{% endif %}">
                  {% render 'promo-tile', promo: section.settings %}
                </li>
              {%- endif -%}
              {%- liquid
                assign loading = 'lazy'
                if forloop.index <= columns
                  assign loading = 'eager'
                endif
              -%}
              <li class="product-grid__item">
                {% render 'product-card',
                  product: product,
                  ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  sizes: sizes,
                  loading: loading,
                  heading_tag: 'h2'
                %}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'pagination', paginate: paginate, anchor: '' %}
        {%- else -%}
          <div class="collection__empty">
            {%- if active_filter_count > 0 -%}
              <p class="heading heading--h3">{{ 'collections.empty.filtered_title' | t }}</p>
              <p class="collection__empty-text">{{ 'collections.empty.filtered_text' | t }}</p>
              <a href="{{ collection.url }}?sort_by={{ sort_by }}" class="button button--outline" data-facets-link>
                {{- 'collections.filters.clear_all' | t -}}
              </a>
            {%- else -%}
              <p class="heading heading--h3">{{ 'collections.empty.title' | t }}</p>
              <p class="collection__empty-text">{{ 'collections.empty.text' | t }}</p>
              <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
                {{- 'collections.empty.button' | t -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</collection-facets>

{% stylesheet %}
  .collection {
    row-gap: 0;
  }

  /* Intro */
  .collection__intro {
    display: grid;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .collection__intro--image {
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
  }

  .collection__intro-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 44rem;
  }

  .collection__intro-media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--style-border-radius-buttons);
  }

  .collection__intro-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Banner: full-width image with the intro on top, directly below the header */
  .collection--banner {
    padding-block-start: 0;
  }

  .collection__banner {
    grid-column: 1 / -1;
    grid-template-columns: var(--content-grid);
    gap: 0;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
    padding-block: 0;
    isolation: isolate;
    color: var(--banner-text);
  }

  .collection__banner-media,
  .collection__banner-overlay {
    grid-area: 1 / 1 / 2 / -1;
    align-self: stretch;
  }

  .collection__banner-media {
    position: relative;
    z-index: -2;
    background-color: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
  }

  .collection__banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection__banner-overlay {
    z-index: -1;
    background-color: #000000;
    opacity: var(--banner-overlay);
  }

  .collection__banner-content {
    grid-area: 1 / 2;
    max-width: 40rem;
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .collection__banner .heading,
  .collection__banner .rte,
  .collection__banner .rte a {
    color: inherit;
  }

  .collection__banner .collection__description {
    opacity: 0.9;
  }

  .collection__banner--small {
    min-height: 40svh;
  }

  .collection__banner--medium {
    min-height: 55svh;
  }

  .collection__banner--large {
    min-height: 75svh;
  }

  .collection__banner--x-left .collection__banner-content {
    justify-self: start;
    text-align: start;
  }

  .collection__banner--x-center .collection__banner-content {
    justify-self: center;
    align-items: center;
    text-align: center;
  }

  .collection__banner--x-right .collection__banner-content {
    justify-self: end;
    text-align: end;
  }

  .collection__banner--y-top .collection__banner-content {
    align-self: start;
  }

  .collection__banner--y-center .collection__banner-content {
    align-self: center;
  }

  .collection__banner--y-bottom .collection__banner-content {
    align-self: end;
  }

  /* Toolbar */
  .collection__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-block: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .collection__toolbar-start {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .collection__filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .collection__filter-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .collection__filter-icon {
    width: 1.125rem;
    height: 1.125rem;
  }

  .collection .collection__hidden {
    display: none;
  }

  .collection__count {
    font-size: 0.875rem;
    opacity: 0.75;
  }

  .collection__sort {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .collection__sort-label {
    font-size: 0.875rem;
    opacity: 0.75;
  }

  .collection__select {
    position: relative;
    display: flex;
    align-items: center;
  }

  .collection__select select {
    padding: 0.5rem 1.75rem 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    appearance: none;
  }

  [dir='rtl'] .collection__select select {
    padding: 0.5rem 0 0.5rem 1.75rem;
  }

  .collection__select select:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .collection__select-icon {
    position: absolute;
    inset-inline-end: 0;
    width: 1rem;
    height: 1rem;
    pointer-events: none;
  }

  /* Layout */
  .collection__layout {
    padding-block-start: clamp(1.5rem, 3vw, 2.5rem);
  }

  .collection__results {
    min-width: 0;
    transition: opacity 0.25s ease;
  }

  .collection[aria-busy='true'] .collection__results {
    opacity: 0.45;
    pointer-events: none;
  }

  /* Active filter pills */
  .collection__pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }

  .collection__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4375rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 20%, transparent);
    border-radius: 999px;
    color: inherit;
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .collection__pill:hover {
    border-color: var(--color-foreground);
  }

  .collection__pill-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  .collection__clear {
    margin-inline-start: 0.25rem;
    color: inherit;
    font-size: 0.8125rem;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
  }

  .collection__pill:focus-visible,
  .collection__clear:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Empty state */
  .collection__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: clamp(3rem, 8vw, 6rem) 1rem;
    text-align: center;
  }

  .collection__empty-text {
    max-width: 28rem;
    margin-block-end: 0.75rem;
    opacity: 0.7;
  }

  /* Filter panel: an off-canvas drawer (all screens, or small screens with the sidebar layout) */
  .facets {
    --facets-from: -100%;

    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    width: min(26rem, 88vw);
    max-height: none;
    overflow: hidden;
    background-color: var(--color-background);
    color: var(--color-foreground);
    transform: translateX(var(--facets-from));
    visibility: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1), visibility 0s linear 0.35s;
  }

  [dir='rtl'] .facets {
    --facets-from: 100%;
  }

  .facets.is-open {
    transform: none;
    visibility: visible;
    transition: transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .facets__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem var(--page-margin);
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .facets__title {
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  [dir='rtl'] .facets__title {
    letter-spacing: 0;
  }

  .facets__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: -0.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .facets__close .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .facets__content {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem var(--page-margin);
  }

  .facets__content .facet:first-child .facet__summary {
    padding-block-start: 1.125rem;
  }

  .facets__footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding: 1rem var(--page-margin);
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .facets__footer .button {
    --button-pad-x: 0.75rem;
  }

  .collection__backdrop:not([hidden]) {
    position: fixed;
    inset: 0;
    z-index: 59;
    display: block;
    background-color: rgb(0 0 0 / 0.35);
  }

  .facets:focus {
    outline: none;
  }

  /* Sidebar layout: a sticky column beside the products on large screens */
  @media (min-width: 990px) {
    .collection--filters-sidebar .collection__layout--filters {
      display: grid;
      grid-template-columns: minmax(13rem, 16rem) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }

    .collection--filters-sidebar .collection__filter-toggle {
      display: none;
    }

    .collection--filters-sidebar .facets {
      position: sticky;
      inset: auto;
      top: calc(var(--header-height, 0px) + 1.5rem);
      z-index: auto;
      display: block;
      width: auto;
      max-height: calc(100vh - var(--header-height, 0px) - 3rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: transparent;
      transform: none;
      visibility: visible;
      transition: none;
      scrollbar-width: thin;
    }

    .collection--filters-sidebar .facets__header,
    .collection--filters-sidebar .facets__footer,
    .collection--filters-sidebar .collection__backdrop:not([hidden]) {
      display: none;
    }

    .collection--filters-sidebar .facets__content {
      overflow: visible;
      padding: 0;
    }

    .collection--filters-sidebar .facets__content .facet:first-child .facet__summary {
      padding-block-start: 0;
    }
  }

  @media (max-width: 989px) {
    .collection__intro--image {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 749px) {
    .collection__toolbar {
      flex-wrap: wrap;
      row-gap: 0.25rem;
    }

    .collection__sort-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .collection__count {
      font-size: 0.8125rem;
    }

    /* The drawer's "View N results" button carries the count instead */
    .collection__filter-toggle ~ .collection__count {
      display: none;
    }

    .collection__toolbar-start {
      gap: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .facets,
    .facets.is-open {
      transition: none;
    }
  }
{% endstylesheet %}

