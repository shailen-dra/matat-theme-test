{%- liquid
  assign region_label = section.settings.title | strip_html
  if region_label == blank
    assign region_label = 'sections.testimonials.label' | t
  endif
-%}

<div
  class="section full-width color-scheme color-{{ section.settings.color_scheme }}{% if section.settings.tinted %} section--tinted{% endif %}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% render 'section-heading',
    eyebrow: section.settings.eyebrow,
    title: section.settings.title,
    subtitle: section.settings.subtitle,
    alignment: 'center'
  %}

  <testimonial-slider
    class="testimonials {{ section.settings.layout }}"
    style="--testimonials-columns: {{ section.settings.columns_desktop }};"
  >
    <div
      class="testimonials__track"
      data-track
      tabindex="0"
      role="region"
      aria-label="{{ region_label | escape }}"
    >
      {% content_for 'blocks' %}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="testimonials__nav" data-nav>
        <button type="button" class="testimonials__arrow" data-prev aria-label="{{ 'sections.slideshow.previous' | t | escape }}">
          {% render 'icon', name: 'chevron-left' %}
        </button>
        <button type="button" class="testimonials__arrow" data-next aria-label="{{ 'sections.slideshow.next' | t | escape }}">
          {% render 'icon', name: 'chevron-right' %}
        </button>
      </div>
    {%- endif -%}
  </testimonial-slider>
</div>

{% stylesheet %}
  .testimonials {
    --testimonials-gap: clamp(1rem, 2vw, 1.5rem);

    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .testimonials__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(
      (100% - var(--testimonials-gap) * (var(--testimonials-columns) - 1)) / var(--testimonials-columns)
    );
    gap: var(--testimonials-gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__track:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .testimonials__track {
      scroll-behavior: smooth;
    }
  }

  .testimonials__track > * {
    scroll-snap-align: start;
  }

  .testimonials__nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  /* Arrows only when there is something to scroll to */
  .testimonials:not(.is-scrollable) .testimonials__nav {
    display: none;
  }

  .testimonials__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: 50%;
    background: var(--color-background);
    color: inherit;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      opacity 0.2s ease;
  }

  .testimonials__arrow:hover:not(:disabled) {
    border-color: var(--color-foreground);
  }

  .testimonials__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .testimonials__arrow:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .testimonials__arrow .icon {
    width: 1rem;
    height: 1rem;
  }

  [dir='rtl'] .testimonials__arrow .icon {
    transform: scaleX(-1);
  }

  @media (max-width: 989px) {
    .testimonials {
      --testimonials-columns: 2 !important;
    }
  }

  @media (max-width: 749px) {
    /* One card and a peek of the next */
    .testimonials__track {
      grid-auto-columns: 85%;
    }
  }

  /*
    Auto-scrolling row: the script duplicates the cards (hidden from assistive
    tech) and the track slides by exactly half its width, so the loop is
    seamless. The trailing padding makes both halves the same width. Falls
    back to the plain slider for reduced motion and in the theme editor.
  */
  .testimonials--marquee:has(.is-looping) {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  }

  .testimonials__track.is-looping {
    grid-auto-columns: clamp(17rem, 28vw, 24rem);
    width: max-content;
    padding-inline-end: var(--testimonials-gap);
    overflow: visible;
    scroll-snap-type: none;
    animation: testimonials-loop var(--testimonials-loop-duration, 40s) linear infinite;
  }

  [dir='rtl'] .testimonials__track.is-looping {
    animation-name: testimonials-loop-rtl;
  }

  .testimonials--marquee:is(:hover, :focus-within) .testimonials__track.is-looping {
    animation-play-state: paused;
  }

  .testimonials__track.is-looping .testimonial {
    border-color: color-mix(in srgb, var(--color-foreground) 8%, transparent);
    border-radius: 1.5rem;
    background-color: color-mix(in srgb, var(--color-background) 70%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 14px 36px -20px rgb(0 0 0 / 0.25);
  }

  .testimonials:has(.is-looping) .testimonials__nav {
    display: none;
  }

  @keyframes testimonials-loop {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes testimonials-loop-rtl {
    to {
      transform: translateX(50%);
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Testimonials row: native horizontal scroll with snap points, plus
   * previous / next buttons that page by one card and disable at the ends.
   */
  class TestimonialSlider extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('[data-track]');
      this.prev = this.querySelector('[data-prev]');
      this.next = this.querySelector('[data-next]');
      this.prev?.addEventListener('click', () => this.page(-1));
      this.next?.addEventListener('click', () => this.page(1));
      this.track.addEventListener('scroll', this.update, { passive: true });
      this.resizeObserver = new ResizeObserver(this.update);
      this.resizeObserver.observe(this.track);
      this.addEventListener('shopify:block:select', (event) => {
        event.target.scrollIntoView({ block: 'nearest', inline: 'start' });
      });
      if (this.classList.contains('testimonials--marquee')) this.startLoop();
      this.update();
    }

    /** Auto-scrolling row: duplicate the cards so the row can loop seamlessly */
    startLoop() {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cards = [...this.track.children];
      if (reducedMotion || window.Shopify?.designMode || cards.length < 2) return;
      cards.forEach((card) => {
        const clone = card.cloneNode(true);
        clone.setAttribute('aria-hidden', 'true');
        clone.inert = true;
        clone.removeAttribute('id');
        clone.querySelectorAll('[id]').forEach((el) => el.removeAttribute('id'));
        this.track.append(clone);
      });
      // Roughly 7 seconds per card keeps the pace calm whatever the count
      this.style.setProperty('--testimonials-loop-duration', `${cards.length * 7}s`);
      this.track.classList.add('is-looping');
      this.track.removeAttribute('tabindex');
    }

    disconnectedCallback() {
      this.resizeObserver?.disconnect();
    }

    get isRtl() {
      return getComputedStyle(this).direction === 'rtl';
    }

    /** Scrolls by one card in the reading direction */
    page(direction) {
      const card = this.track.firstElementChild;
      if (!card) return;
      const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
      const step = (card.getBoundingClientRect().width + gap) * direction * (this.isRtl ? -1 : 1);
      this.track.scrollBy({ left: step });
    }

    update = () => {
      const max = this.track.scrollWidth - this.track.clientWidth;
      // RTL scroll positions run from 0 to -max
      const position = Math.abs(this.track.scrollLeft);
      this.classList.toggle('is-scrollable', max > 1);
      if (this.prev) this.prev.disabled = position <= 1;
      if (this.next) this.next.disabled = position >= max - 1;
    };
  }

  if (!customElements.get('testimonial-slider')) {
    customElements.define('testimonial-slider', TestimonialSlider);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "testimonials-section",
  "blocks": [{ "type": "_testimonial" }],
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Testimonials"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:labels.heading",
      "default": "What customers <em>are saying</em>"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:labels.subtitle"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:general.layout",
      "info": "t:sections.testimonials.layout_info",
      "options": [
        { "value": "testimonials--slider", "label": "t:sections.testimonials.layout_slider" },
        { "value": "testimonials--marquee", "label": "t:sections.testimonials.layout_marquee" }
      ],
      "default": "testimonials--slider"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "visible_if": "{{ section.settings.layout == 'testimonials--slider' }}",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "tinted",
      "label": "t:labels.tinted_background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.name",
      "category": "t:general.trust",
      "blocks": [
        {
          "type": "_testimonial",
          "settings": {
            "quote": "<p>Share a review from a customer, in their own words.</p>",
            "author": "Customer name",
            "detail": "Product or location"
          }
        },
        {
          "type": "_testimonial",
          "settings": {
            "quote": "<p>Share a review from a customer, in their own words.</p>",
            "author": "Customer name",
            "detail": "Product or location"
          }
        },
        {
          "type": "_testimonial",
          "settings": {
            "quote": "<p>Share a review from a customer, in their own words.</p>",
            "author": "Customer name",
            "detail": "Product or location"
          }
        },
        {
          "type": "_testimonial",
          "settings": {
            "quote": "<p>Share a review from a customer, in their own words.</p>",
            "author": "Customer name",
            "detail": "Product or location"
          }
        }
      ]
    }
  ]
}
{% endschema %}
