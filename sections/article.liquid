{% comment %}
  Article template section: the full blog post in a readable column, with its
  featured image, tags and, when the blog allows them, comments.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{%- assign field_id = 'Comment-' | append: section.id -%}

<div
  class="article section"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <article class="article__inner">
    <header class="article__header">
      <a href="{{ blog.url }}" class="article__back">
        {% render 'icon', name: 'chevron-left', class: 'article__back-icon' %}
        {{- 'blog.back_to_blog' | t: title: blog.title -}}
      </a>

      {%- if section.settings.show_date or section.settings.show_author -%}
        <p class="article__meta">
          {%- if section.settings.show_date -%}
            {{- article.published_at | time_tag: format: 'date' -}}
          {%- endif -%}
          {%- if section.settings.show_author -%}
            <span>{{ 'blog.by_author' | t: author: article.author }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      <h1 class="heading heading--h1 article__title">{{ article.title | escape }}</h1>
    </header>

    {%- if section.settings.show_image and article.image -%}
      <div class="article__media">
        {{
          article.image
          | image_url: width: 2000
          | image_tag:
            widths: '600, 900, 1200, 1500, 2000',
            sizes: '(min-width: 1200px) 1100px, calc(100vw - 2 * var(--page-margin))',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'article__image'
        }}
      </div>
    {%- endif -%}

    <div class="rte article__body">{{ article.content }}</div>

    {%- if article.tags.size > 0 -%}
      <footer class="article__footer">
        <p class="article__tags-label">{{ 'blog.tagged' | t }}</p>
        <ul class="article__tags" role="list">
          {%- for tag in article.tags -%}
            <li>
              <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog__tag">{{ tag | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </footer>
    {%- endif -%}
  </article>

  {%- if blog.comments_enabled? -%}
    <section class="article__comments" id="comments" aria-labelledby="{{ field_id }}-heading">
      <h2 id="{{ field_id }}-heading" class="heading heading--h3">
        {{- 'blog.comments_count' | t: count: article.comments_count -}}
      </h2>

      {%- paginate article.comments by 10 -%}
        {%- if article.comments.size > 0 -%}
          <ol class="comment-list" role="list">
            {%- for comment in article.comments -%}
              <li class="comment">
                <p class="comment__meta">
                  <span class="comment__author">{{ comment.author | escape }}</span>
                  {{ comment.created_at | time_tag: format: 'date' }}
                </p>
                <div class="rte comment__body">{{ comment.content }}</div>
              </li>
            {%- endfor -%}
          </ol>

          {% render 'pagination', paginate: paginate, anchor: '#comments' %}
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article, class: 'comment-form' -%}
        <h3 class="heading heading--h3">{{ 'blog.comment_form_title' | t }}</h3>

        {%- if form.posted_successfully? -%}
          <p class="comment-form__status comment-form__status--success" role="status">
            {%- if blog.moderated? -%}
              {{ 'blog.comment_moderated' | t }}
            {%- else -%}
              {{ 'blog.comment_posted' | t }}
            {%- endif -%}
          </p>
        {%- elsif form.errors -%}
          <div class="comment-form__status comment-form__status--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="comment-form__row">
          <div class="field">
            <label for="{{ field_id }}-author" class="field__label">{{ 'blog.comment_form_name' | t }}</label>
            <input
              type="text"
              name="comment[author]"
              id="{{ field_id }}-author"
              class="field__input"
              value="{{ form.author | escape }}"
              autocomplete="name"
              required
              aria-required="true"
            >
          </div>
          <div class="field">
            <label for="{{ field_id }}-email" class="field__label">{{ 'blog.comment_form_email' | t }}</label>
            <input
              type="email"
              name="comment[email]"
              id="{{ field_id }}-email"
              class="field__input"
              value="{{ form.email | escape }}"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              aria-required="true"
            >
          </div>
        </div>

        <div class="field">
          <label for="{{ field_id }}-body" class="field__label">{{ 'blog.comment_form_body' | t }}</label>
          <textarea
            name="comment[body]"
            id="{{ field_id }}-body"
            class="field__input field__input--textarea"
            rows="5"
            required
            aria-required="true"
          >
            {{- form.body -}}
          </textarea>
        </div>

        <div class="comment-form__actions">
          {%- assign submit_label = 'blog.comment_form_submit' | t -%}
          {% render 'button', label: submit_label, type: 'submit' %}
          {%- if blog.moderated? -%}
            <p class="comment-form__note">{{ 'blog.moderated_note' | t }}</p>
          {%- endif -%}
        </div>
      {%- endform -%}
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .article__inner,
  .article__comments {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  /* Text keeps a readable column; the image is allowed to be wider */
  .article__inner > *,
  .article__comments {
    width: 100%;
    max-width: 46rem;
    margin-inline: auto;
  }

  .article__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--color-foreground);
    font-size: 0.875rem;
    text-decoration: none;
    opacity: 0.75;
  }

  .article__back:hover {
    opacity: 1;
  }

  .article__back-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  [dir='rtl'] .article__back-icon {
    transform: scaleX(-1);
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 1rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .article__inner > .article__media {
    max-width: 1100px;
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons);
  }

  /* Cropped to a landscape frame so tall photos don't push the text off screen */
  .article__image {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  @media (max-width: 749px) {
    .article__image {
      aspect-ratio: 4 / 3;
    }
  }

  .article__body {
    font-size: 1.0625rem;
  }

  .article__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-block-start: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .article__tags-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article__comments {
    margin-block-start: clamp(3.5rem, 7vw, 5.5rem);
    padding-block-start: clamp(2.5rem, 5vw, 3.5rem);
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .comment-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .comment {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .comment:first-child {
    padding-block-start: 0;
  }

  .comment__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .comment__author {
    font-weight: 600;
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .comment-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .comment-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .comment-form__note {
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  .comment-form__status {
    padding: 1rem 1.25rem;
    border-radius: var(--style-border-radius-inputs);
    font-size: 0.9375rem;
  }

  .comment-form__status--success {
    background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-background));
  }

  .comment-form__status--error {
    border: 1px solid #b42318;
    color: #b42318;
  }

  .comment-form__status--error ul {
    margin: 0;
    padding-inline-start: 1.25rem;
  }

  @media (max-width: 749px) {
    .comment-form__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.blog.show_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.blog.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.blog.show_author",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
