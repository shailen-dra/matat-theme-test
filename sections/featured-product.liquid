{%- comment -%}
  Shows a merchant-picked product anywhere in the store. Blocks read it
  through `closest.product`, which resolves to this section's product setting.
{%- endcomment -%}

{%- capture blocks -%}{% content_for 'blocks' %}{%- endcapture -%}
{% render 'product-info', section: section, product: section.settings.product, blocks: blocks %}

{% schema %}
{
  "name": "t:sections.featured_product.name",
  "class": "product-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:general.product",
      "info": "t:sections.featured_product.product_info"
    },
    {
      "type": "header",
      "content": "t:sections.product.gallery"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:general.layout",
      "options": [
        {
          "value": "product-gallery--stacked",
          "label": "t:options.gallery_layout.stacked"
        },
        {
          "value": "product-gallery--grid",
          "label": "t:options.gallery_layout.grid"
        },
        {
          "value": "product-gallery--carousel",
          "label": "t:options.gallery_layout.carousel"
        },
        {
          "value": "product-gallery--thumbnails",
          "label": "t:options.gallery_layout.thumbnails"
        }
      ],
      "default": "product-gallery--grid"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.product.media_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.size.adapt_to_image"
        },
        {
          "value": "portrait",
          "label": "t:options.ratio.portrait"
        },
        {
          "value": "square",
          "label": "t:options.ratio.square"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:sections.product.media_width",
      "options": [
        {
          "value": "product--media-half",
          "label": "t:options.media_width.half"
        },
        {
          "value": "product--media-default",
          "label": "t:options.media_width.default"
        },
        {
          "value": "product--media-wide",
          "label": "t:options.media_width.wide"
        }
      ],
      "default": "product--media-default"
    },
    {
      "type": "header",
      "content": "t:sections.product.details"
    },
    {
      "type": "checkbox",
      "id": "sticky_details",
      "label": "t:sections.product.sticky_details",
      "default": true
    },
    {
      "type": "range",
      "id": "details_gap",
      "label": "t:labels.gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product.name",
      "category": "t:general.product",
      "settings": {
        "gallery_layout": "product-gallery--carousel",
        "sticky_details": false
      },
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "{{ closest.product.vendor }}",
            "style": "heading--eyebrow heading--accent",
            "tag": "p"
          }
        },
        {
          "type": "heading",
          "settings": {
            "text": "{{ closest.product.title }}",
            "style": "heading--h2",
            "tag": "h2"
          }
        },
        {
          "type": "price"
        },
        {
          "type": "variant-picker"
        },
        {
          "type": "buy-buttons"
        },
        {
          "type": "button",
          "settings": {
            "label": "View full details",
            "link": "{{ closest.product.url }}",
            "style": "link"
          }
        }
      ]
    }
  ]
}
{% endschema %}
