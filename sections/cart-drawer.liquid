{%- comment -%}
  Mini cart drawer, rendered once per page from the layout when Theme
  settings → Cart → Cart type is "Drawer". Opens from the header bag and
  after products are added. Line item updates and re-rendering are handled
  by `cart-items` and `ThemeCart` in assets/product-components.js; this
  section is re-rendered with the Section Rendering API (`cart-drawer`).

  Also holds the `.side-drawer` styles.
{%- endcomment -%}

{%- liquid
  assign form_id = 'CartDrawerForm'
-%}

<side-drawer id="CartDrawer">
  <dialog class="side-drawer" aria-labelledby="CartDrawerTitle" scroll-lock>
    <cart-items class="cart-drawer" data-section-id="{{ section.id }}">
      <div class="side-drawer__inner" data-cart-content>
        <div class="side-drawer__header">
          <h2 id="CartDrawerTitle" class="side-drawer__title">
            {{- 'cart.title' | t -}}
            {%- if cart.item_count > 0 %}
              <span class="side-drawer__count" data-cart-count>({{ cart.item_count }})</span>
            {%- endif -%}
          </h2>
          <button type="button" class="side-drawer__close" data-drawer-close>
            {% render 'icon', name: 'close' %}
            <span class="visually-hidden">{{ 'cart.drawer.close' | t }}</span>
          </button>
        </div>

        {%- if cart.item_count > 0 -%}
          <ul class="side-drawer__body drawer-items" role="list" data-cart-items>
            {%- for item in cart.items -%}
              <li class="drawer-item" data-line="{{ forloop.index }}">
                <a href="{{ item.url }}" class="drawer-item__media" tabindex="-1" aria-hidden="true">
                  {%- if item.image != blank -%}
                    {{
                      item.image
                      | image_url: width: 240
                      | image_tag: widths: '96, 160, 240', sizes: '96px', loading: 'lazy', class: 'drawer-item__image', alt: ''
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'drawer-item__image drawer-item__placeholder' }}
                  {%- endif -%}
                </a>

                <div class="drawer-item__info">
                  <div class="drawer-item__top">
                    <h3 class="drawer-item__title">
                      <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                    </h3>
                    <p class="drawer-item__price">
                      {%- if item.original_line_price > item.final_line_price -%}
                        <s class="drawer-item__compare">{{ item.original_line_price | money }}</s>
                      {%- endif -%}
                      <span>{{ item.final_line_price | money }}</span>
                    </p>
                  </div>

                  {%- unless item.product.has_only_default_variant -%}
                    <p class="drawer-item__options">
                      {%- for option in item.options_with_values -%}
                        {{ option.value | escape }}
                        {%- unless forloop.last %} · {% endunless -%}
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}

                  {%- for discount in item.line_level_discount_allocations -%}
                    <p class="drawer-item__discount">
                      {{- discount.discount_application.title | escape }} (−{{ discount.amount | money -}})
                    </p>
                  {%- endfor -%}

                  <div class="drawer-item__actions">
                    {%- assign quantity_id = 'CartDrawer-Quantity-' | append: forloop.index -%}
                    {% render 'quantity-input',
                      id: quantity_id,
                      name: 'updates[]',
                      value: item.quantity,
                      min: 0,
                      form: form_id
                    %}
                    <a
                      href="{{ item.url_to_remove }}"
                      class="drawer-item__remove"
                      data-cart-remove
                      aria-label="{{ 'cart.remove_item' | t: title: item.product.title | escape }}"
                    >
                      {{- 'cart.remove' | t -}}
                    </a>
                  </div>

                  <p
                    class="drawer-item__error"
                    role="alert"
                    data-cart-error
                    data-fallback="{{ 'cart.errors.generic' | t | escape }}"
                    data-stock-message="{{ 'cart.errors.stock' | t | escape }}"
                    hidden
                  ></p>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <div class="side-drawer__footer" data-cart-totals>
            {%- for discount in cart.cart_level_discount_applications -%}
              <p class="cart-drawer__row cart-drawer__row--discount">
                <span>{{ discount.title | escape }}</span>
                <span>−{{ discount.total_allocated_amount | money }}</span>
              </p>
            {%- endfor -%}
            <p class="cart-drawer__row cart-drawer__row--total">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span>{{ cart.total_price | money_with_currency }}</span>
            </p>
            <p class="cart-drawer__note">
              {%- if cart.taxes_included -%}
                {{ 'cart.taxes_included' | t }}
              {%- else -%}
                {{ 'cart.taxes_excluded' | t }}
              {%- endif -%}
            </p>

            <form id="{{ form_id }}" action="{{ routes.cart_url }}" method="post" class="cart-drawer__buttons">
              <button type="submit" name="checkout" class="button button--primary button--lg button--full">
                {%- render 'icon', name: 'shield', class: 'cart__checkout-icon' -%}
                {{- 'cart.checkout' | t -}}
              </button>
              <a href="{{ routes.cart_url }}" class="button button--outline button--full">
                {{- 'cart.drawer.view_cart' | t -}}
              </a>
            </form>
          </div>
        {%- else -%}
          <div class="side-drawer__body side-drawer__empty">
            <span class="side-drawer__empty-icon">{% render 'icon', name: 'cart' %}</span>
            <p class="heading heading--h3">{{ 'cart.empty.title' | t }}</p>
            <p class="side-drawer__empty-text">{{ 'cart.empty.text' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="button button--primary">
              {{- 'cart.continue_shopping' | t -}}
            </a>
          </div>
        {%- endif -%}

        <p class="visually-hidden" role="status" data-cart-status></p>
      </div>
    </cart-items>
  </dialog>
</side-drawer>

{% stylesheet %}
  /* Side drawer shell */
  .side-drawer {
    --side-drawer-from: 100%;

    inset-block: 0;
    inset-inline-start: auto;
    inset-inline-end: 0;
    width: min(28rem, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
  }

  [dir='rtl'] .side-drawer {
    --side-drawer-from: -100%;
  }

  .side-drawer[open] {
    animation: side-drawer-in 0.35s cubic-bezier(0.2, 0.6, 0.2, 1) both;
  }

  .side-drawer::backdrop {
    background-color: rgb(0 0 0 / 0.35);
  }

  @keyframes side-drawer-in {
    from {
      transform: translateX(var(--side-drawer-from));
    }
  }

  .side-drawer > *,
  .side-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .side-drawer__header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1.25rem, 3vw, 1.75rem);
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  .side-drawer__title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: var(--font-heading--weight);
  }

  .side-drawer__count {
    font-family: var(--font-primary--family);
    font-size: 0.9375rem;
    opacity: 0.6;
  }

  .side-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-end: -0.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .side-drawer__close .icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .side-drawer__close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .side-drawer__body {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0 clamp(1.25rem, 3vw, 1.75rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .side-drawer__footer {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem clamp(1.25rem, 3vw, 1.75rem);
    border-top: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    background-color: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background));
  }

  .side-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
  }

  .side-drawer__empty-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin-block-end: 0.25rem;
    border-radius: 50%;
    background-color: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
    color: var(--color-accent);
  }

  .side-drawer__empty-icon .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .side-drawer__empty-text {
    max-width: 20rem;
    margin-block-end: 0.5rem;
    opacity: 0.7;
  }

  /* Drawer rows */
  .drawer-items {
    list-style: none;
  }

  .drawer-item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    transition: opacity 0.3s ease;
  }

  .drawer-item:last-child {
    border-bottom: 0;
  }

  .drawer-item.is-removing {
    opacity: 0;
  }

  .drawer-item__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: var(--style-border-radius-buttons);
    background-color: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
  }

  .drawer-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .drawer-item__placeholder {
    fill: color-mix(in srgb, var(--color-foreground) 25%, transparent);
  }

  .drawer-item__info {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  .drawer-item__top {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .drawer-item__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 1.0625rem;
    font-weight: var(--font-heading--weight);
    line-height: 1.3;
  }

  .drawer-item__title a {
    color: inherit;
    text-decoration: none;
  }

  .drawer-item__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.2em;
  }

  .drawer-item__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .drawer-item__compare {
    font-size: 0.8125rem;
    opacity: 0.5;
  }

  .drawer-item__options,
  .drawer-item__discount {
    font-size: 0.8125rem;
    opacity: 0.65;
  }

  .drawer-item__discount {
    color: var(--color-accent);
    opacity: 1;
  }

  .drawer-item__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-block-start: auto;
    padding-block-start: 0.5rem;
  }

  .drawer-item__actions .quantity {
    height: 2.5rem;
  }

  .drawer-item__actions .quantity__button,
  .drawer-item__actions .quantity__input {
    width: 2.375rem;
  }

  .drawer-item__remove {
    color: inherit;
    font-size: 0.8125rem;
    opacity: 0.65;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .drawer-item__remove:hover {
    opacity: 1;
  }

  .drawer-item__error {
    color: #b3261e;
    font-size: 0.8125rem;
  }

  .cart-drawer[aria-busy='true'] :is([data-cart-items], [data-cart-totals]) {
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }

  /* Cart drawer totals */
  .cart-drawer__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .cart-drawer__row--discount {
    color: var(--color-accent);
  }

  .cart-drawer__row--total {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .cart-drawer__note {
    margin-block-start: -0.25rem;
    font-size: 0.8125rem;
    opacity: 0.65;
  }

  .cart-drawer__buttons {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-block-start: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .side-drawer[open] {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
