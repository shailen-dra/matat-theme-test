{%- comment -%}
  Main product page section. It has no product setting on purpose: an empty
  section-level product setting would capture `closest.product` and leave
  every block blank, so blocks resolve straight to the page's product.
{%- endcomment -%}

{%- capture blocks -%}{% content_for 'blocks' %}{%- endcapture -%}
{% render 'product-info', section: section, product: product, blocks: blocks, update_url: true %}

{%- # Product structured data is output once, in snippets/meta-tags.liquid -%}

{% javascript %}
  /* Remember this product for the recently viewed section (newest first, max 12) */
  {
  const rememberProduct = () => {
    const info = document.querySelector('product-info[data-update-url="true"][data-product-handle]');
    const handle = info?.dataset.productHandle;
    if (!handle) return;
    const key = 'theme:recently-viewed';
    try {
      const list = JSON.parse(localStorage.getItem(key)) || [];
      const next = [handle, ...list.filter((item) => item !== handle)].slice(0, 12);
      localStorage.setItem(key, JSON.stringify(next));
    } catch {
      /* Storage unavailable (private mode or blocked): nothing to remember */
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', rememberProduct);
  } else {
    rememberProduct();
  }
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product.name",
  "class": "product-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.product.gallery"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:general.layout",
      "options": [
        {
          "value": "product-gallery--stacked",
          "label": "t:options.gallery_layout.stacked"
        },
        {
          "value": "product-gallery--grid",
          "label": "t:options.gallery_layout.grid"
        },
        {
          "value": "product-gallery--carousel",
          "label": "t:options.gallery_layout.carousel"
        },
        {
          "value": "product-gallery--thumbnails",
          "label": "t:options.gallery_layout.thumbnails"
        }
      ],
      "default": "product-gallery--grid"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.product.media_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.size.adapt_to_image"
        },
        {
          "value": "portrait",
          "label": "t:options.ratio.portrait"
        },
        {
          "value": "square",
          "label": "t:options.ratio.square"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:sections.product.media_width",
      "options": [
        {
          "value": "product--media-half",
          "label": "t:options.media_width.half"
        },
        {
          "value": "product--media-default",
          "label": "t:options.media_width.default"
        },
        {
          "value": "product--media-wide",
          "label": "t:options.media_width.wide"
        }
      ],
      "default": "product--media-default"
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "t:sections.product.enable_zoom",
      "info": "t:sections.product.enable_zoom_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.product.details"
    },
    {
      "type": "checkbox",
      "id": "sticky_details",
      "label": "t:sections.product.sticky_details",
      "default": true
    },
    {
      "type": "range",
      "id": "details_gap",
      "label": "t:labels.gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
