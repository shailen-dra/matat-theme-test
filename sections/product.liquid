{%- liquid
  # Works on the product template (uses the page's product) or anywhere else
  # as a "Featured product" when a product is picked in the settings.
  # Blocks read the product through `closest.product`, so they follow along.
  if section.settings.product != blank
    assign product = section.settings.product
  endif

  assign variant = product.selected_or_first_available_variant

  assign update_url = false
  if template.name == 'product' and section.settings.product == blank
    assign update_url = true
  endif

  assign loading = 'lazy'
  if section.index == 1
    assign loading = 'eager'
  endif

  assign product_classes = 'product ' | append: section.settings.media_width
  if section.settings.sticky_details
    assign product_classes = product_classes | append: ' product--sticky'
  endif
-%}

<product-info
  class="{{ product_classes }}"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-variant-id="{{ variant.id }}"
  data-update-url="{{ update_url }}"
  style="
    --product-padding-top: {{ section.settings.padding_top }}px;
    --product-padding-bottom: {{ section.settings.padding_bottom }}px;
    --product-details-gap: {{ section.settings.details_gap }}px;
  "
>
  <div class="product__media">
    {% render 'product-gallery',
      product: product,
      layout: section.settings.gallery_layout,
      ratio: section.settings.media_ratio,
      loading: loading,
      id: section.id
    %}
  </div>

  <div class="product__details">
    <div class="product__details-inner">
      {%- if product == blank and request.design_mode -%}
        <p class="product__empty">{{ 'product.select_product' | t }}</p>
      {%- endif -%}
      {% content_for 'blocks' %}
    </div>
  </div>
</product-info>

{%- if product != blank -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
{%- endif -%}

{% stylesheet %}
  .product {
    --product-media-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    display: grid;
    grid-template-columns: var(--product-media-columns);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
    padding-block: var(--product-padding-top) var(--product-padding-bottom);
  }

  .product--media-half {
    --product-media-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .product--media-wide {
    --product-media-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  }

  .product__details-inner {
    display: flex;
    flex-direction: column;
    gap: var(--product-details-gap);
  }

  .product--sticky .product__details {
    position: sticky;
    top: calc(var(--header-height, 0px) + 1.5rem);
  }

  .product[aria-busy='true'] [data-update^='price'],
  .product[aria-busy='true'] [data-update^='buy'] {
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .product__empty {
    padding: 1rem 1.25rem;
    border: 1px dashed color-mix(in srgb, var(--color-foreground) 30%, transparent);
    font-size: 0.875rem;
  }

  @media (max-width: 989px) {
    .product {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .product--sticky .product__details {
      position: static;
    }
  }

  @media (max-width: 749px) {
    /* The gallery bleeds to the screen edges on phones */
    .product__media {
      margin-inline: calc(var(--page-margin) * -1);
    }

    .product {
      padding-block-start: 0;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Keeps the product section in sync with the selected variant: re-renders
   * the section for the chosen option values and swaps every element marked
   * with `data-update`, so price, stock and buy buttons stay server-rendered.
   */
  class ProductInfo extends HTMLElement {
    connectedCallback() {
      this.addEventListener('change', this.onOptionChange);
    }

    disconnectedCallback() {
      this.removeEventListener('change', this.onOptionChange);
      this.abortController?.abort();
    }

    onOptionChange = (event) => {
      const picker = event.target.closest('[data-variant-picker]');
      if (!picker) return;

      const selected = [...picker.querySelectorAll('input:checked, select')].map((input) =>
        input.tagName === 'SELECT' ? input.selectedOptions[0] : input
      );

      // Combined listings: a value may belong to a sibling product
      const targetUrl = event.target.tagName === 'SELECT'
        ? event.target.selectedOptions[0]?.dataset.productUrl
        : event.target.dataset.productUrl;
      if (targetUrl && targetUrl !== this.dataset.productUrl) {
        window.location.href = targetUrl;
        return;
      }

      const optionValues = selected.map((el) => el.dataset.optionValueId).join(',');
      this.renderVariant(optionValues, event.target.id);
    };

    async renderVariant(optionValues, focusId) {
      this.abortController?.abort();
      this.abortController = new AbortController();
      this.setAttribute('aria-busy', 'true');

      try {
        const params = new URLSearchParams({ option_values: optionValues, section_id: this.dataset.sectionId });
        const response = await fetch(`${this.dataset.productUrl}?${params}`, {
          signal: this.abortController.signal,
        });
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const next = html.querySelector(`product-info[data-section-id="${this.dataset.sectionId}"]`);
        if (!next) return;

        this.querySelectorAll('[data-update]').forEach((current) => {
          const fresh = next.querySelector(`[data-update="${current.dataset.update}"]`);
          if (!fresh) return;
          // Only swap the gallery when the variant actually shows different media
          if (current.dataset.featuredMediaId && current.dataset.featuredMediaId === fresh.dataset.featuredMediaId) return;
          current.replaceWith(fresh);
        });

        if (focusId) document.getElementById(focusId)?.focus({ preventScroll: true });

        const variantId = next.dataset.variantId;
        this.dataset.variantId = variantId;
        if (variantId && this.dataset.updateUrl === 'true') {
          window.history.replaceState({}, '', `${this.dataset.productUrl}?variant=${variantId}`);
        }

        this.dispatchEvent(new CustomEvent('variant:change', { bubbles: true, detail: { variantId } }));
      } catch (error) {
        if (error.name !== 'AbortError') console.error(error);
      } finally {
        this.removeAttribute('aria-busy');
      }
    }
  }

  if (!customElements.get('product-info')) {
    customElements.define('product-info', ProductInfo);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.product.name",
  "class": "product-section",
  "blocks": [{ "type": "@theme" }],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:general.product",
      "info": "t:sections.product.product_info"
    },
    {
      "type": "header",
      "content": "t:sections.product.gallery"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:general.layout",
      "options": [
        { "value": "product-gallery--stacked", "label": "t:options.gallery_layout.stacked" },
        { "value": "product-gallery--grid", "label": "t:options.gallery_layout.grid" },
        { "value": "product-gallery--carousel", "label": "t:options.gallery_layout.carousel" },
        { "value": "product-gallery--thumbnails", "label": "t:options.gallery_layout.thumbnails" }
      ],
      "default": "product-gallery--grid"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "t:sections.product.media_ratio",
      "options": [
        { "value": "adapt", "label": "t:options.size.adapt_to_image" },
        { "value": "portrait", "label": "t:options.ratio.portrait" },
        { "value": "square", "label": "t:options.ratio.square" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:sections.product.media_width",
      "options": [
        { "value": "product--media-half", "label": "t:options.media_width.half" },
        { "value": "product--media-default", "label": "t:options.media_width.default" },
        { "value": "product--media-wide", "label": "t:options.media_width.wide" }
      ],
      "default": "product--media-default"
    },
    {
      "type": "header",
      "content": "t:sections.product.details"
    },
    {
      "type": "checkbox",
      "id": "sticky_details",
      "label": "t:sections.product.sticky_details",
      "default": true
    },
    {
      "type": "range",
      "id": "details_gap",
      "label": "t:labels.gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "t:sections.product.featured_preset",
      "category": "t:general.product",
      "settings": { "gallery_layout": "product-gallery--carousel", "sticky_details": false },
      "blocks": [
        { "type": "heading", "settings": { "text": "{{ closest.product.vendor }}", "style": "heading--eyebrow heading--accent", "tag": "p" } },
        { "type": "heading", "settings": { "text": "{{ closest.product.title }}", "style": "heading--h2", "tag": "h2" } },
        { "type": "price" },
        { "type": "variant-picker" },
        { "type": "buy-buttons" },
        { "type": "button", "settings": { "label": "View full details", "link": "{{ closest.product.url }}", "style": "link" } }
      ]
    }
  ]
}
{% endschema %}
