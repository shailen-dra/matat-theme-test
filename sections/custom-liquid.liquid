{% comment %}
  Custom Liquid section: lets merchants paste Liquid, HTML or app snippets
  anywhere a section can go. Also an insertion point for apps that don't
  ship app blocks.
{% endcomment %}

<div
  class="custom-liquid section{% if section.settings.full_width %} full-width{% endif %}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div>{{ section.settings.custom_liquid }}</div>
</div>

{% schema %}
{
  "name": "t:sections.custom_liquid.name",
  "tag": "section",
  "class": "custom-liquid-section",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom_liquid.liquid",
      "info": "t:sections.custom_liquid.liquid_info"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.custom_liquid.full_width",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_liquid.name"
    }
  ]
}
{% endschema %}
