{% comment %}
  This section is used in the password template to render the landing page
  shown when password protection is applied to a store: the logo, an opening
  message, an email signup and a password form for invited visitors.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{%- liquid
  assign signup_id = 'PasswordSignup-' | append: section.id
  assign password_id = 'PasswordForm-' | append: section.id
  assign signup_label = 'password.signup_submit' | t
  assign enter_label = 'password.enter' | t
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'password.title' | t
  endif
-%}

<div class="password">
  <header class="password__brand">
    {%- if settings.logo -%}
      {{
        settings.logo
        | image_url: width: 400
        | image_tag:
          widths: '160, 240, 320, 400',
          sizes: '160px',
          class: 'password__logo',
          alt: shop.name,
          loading: 'eager'
      }}
    {%- else -%}
      <p class="password__shop-name">{{ shop.name | escape }}</p>
    {%- endif -%}
  </header>

  <main id="MainContent" class="password__main">
    <h1 class="heading heading--h1">{{ heading }}</h1>

    {%- if shop.password_message != blank -%}
      <p class="heading heading--subtitle">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if section.settings.show_signup -%}
      {%- form 'customer', id: signup_id, class: 'password__signup' -%}
        <input type="hidden" name="contact[tags]" value="password page">
        {%- if form.posted_successfully? -%}
          <p class="password__message password__message--success" role="status">
            {%- render 'icon', name: 'check' -%}
            {{ 'password.signup_success' | t }}
          </p>
        {%- else -%}
          <p class="password__signup-heading">{{ 'password.signup_heading' | t }}</p>
          <div class="password__field">
            <label for="{{ signup_id }}-email" class="visually-hidden">{{ 'newsletter.email_label' | t }}</label>
            <input
              id="{{ signup_id }}-email"
              class="field__input"
              type="email"
              name="contact[email]"
              value="{{ form.email | escape }}"
              placeholder="{{ 'newsletter.email_placeholder' | t }}"
              autocomplete="email"
              autocapitalize="off"
              spellcheck="false"
              required
              aria-required="true"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="{{ signup_id }}-error"
              {% endif %}
            >
            {% render 'button', label: signup_label, type: 'submit' %}
          </div>
          {%- if form.errors -%}
            <p id="{{ signup_id }}-error" class="password__message password__message--error" role="alert">
              {{ 'newsletter.error' | t }}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- form 'storefront_password', id: password_id, class: 'password__login' -%}
      <details class="password__details"{% if form.errors %} open{% endif %}>
        <summary class="password__toggle">{{ 'password.enter_using_password' | t }}</summary>
        <div class="password__field">
          <label for="{{ password_id }}-input" class="visually-hidden">{{ 'password.password' | t }}</label>
          <input
            id="{{ password_id }}-input"
            class="field__input"
            type="password"
            name="password"
            placeholder="{{ 'password.password' | t }}"
            autocomplete="current-password"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="{{ password_id }}-error"
            {% endif %}
          >
          {% render 'button', label: enter_label, type: 'submit', style: 'outline' %}
        </div>
        {%- if form.errors -%}
          <p id="{{ password_id }}-error" class="password__message password__message--error" role="alert">
            {{ form.errors.messages.form }}
          </p>
        {%- endif -%}
      </details>
    {%- endform -%}
  </main>

  <footer class="password__footer">
    <p>{{ 'password.admin_link_html' | t }}</p>
    <p>{{ powered_by_link }}</p>
  </footer>
</div>

{% stylesheet %}
  .password {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2.5rem, 6vh, 4rem);
    min-height: 100svh;
    padding: clamp(2rem, 6vh, 3.5rem) var(--page-margin);
    text-align: center;
  }

  .password__brand {
    display: flex;
    justify-content: center;
  }

  .password__logo {
    width: 160px;
    height: auto;
  }

  .password__shop-name {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: var(--font-heading--weight);
    letter-spacing: 0.04em;
  }

  .password__main {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 34rem;
  }

  .password__signup,
  .password__login {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: 100%;
  }

  .password__signup {
    margin-block-start: 1rem;
  }

  .password__signup-heading {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .password__field {
    display: flex;
    gap: 0.5rem;
  }

  .password__field .field__input {
    flex: 1;
    min-width: 0;
  }

  .password__message {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
  }

  .password__message .icon {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-accent);
  }

  .password__message--error {
    color: #b42318;
  }

  .password__details {
    width: 100%;
  }

  .password__details > .password__field,
  .password__details > .password__message {
    margin-block-start: 0.875rem;
  }

  .password__toggle {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-foreground);
    font-size: 0.875rem;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.25em;
    cursor: pointer;
    list-style: none;
  }

  .password__toggle::-webkit-details-marker {
    display: none;
  }

  .password__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .password__footer {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8125rem;
    opacity: 0.75;
  }

  .password__footer a {
    color: inherit;
  }

  @media (max-width: 479px) {
    .password__field {
      flex-direction: column;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Opening soon"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:sections.password.show_signup",
      "default": true
    }
  ]
}
{% endschema %}
