<announcement-bar
  class="announcement-bar color-scheme color-{{ section.settings.color_scheme }}"
  data-speed="{{ section.settings.speed | times: 1000 }}"
  role="region"
  aria-label="{{ 'sections.announcement_bar.label' | t | escape }}"
>
  <div class="announcement-bar__inner">
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="announcement-bar__arrow" data-prev aria-label="{{ 'sections.slideshow.previous' | t | escape }}">
        {% render 'icon', name: 'chevron-left' %}
      </button>
    {%- endif -%}

    <div class="announcement-bar__track" data-track aria-live="off">
      {% content_for 'blocks' %}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="announcement-bar__arrow" data-next aria-label="{{ 'sections.slideshow.next' | t | escape }}">
        {% render 'icon', name: 'chevron-right' %}
      </button>
    {%- endif -%}
  </div>
</announcement-bar>

{% stylesheet %}
  /* A transparent header overlays the page from the top: keep it below the bar until scrolled */
  body:has(.announcement-bar) .header-section:has(> .header--transparent:not([data-scrolled])) {
    top: var(--announcement-height, 0px);
  }

  .announcement-bar {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  [dir='rtl'] .announcement-bar {
    letter-spacing: 0;
  }

  .announcement-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .announcement-bar__track {
    display: grid;
    flex: 1;
    min-width: 0;
    text-align: center;
  }

  /* Messages share one cell and cross-fade */
  .announcement {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding-block: 0.5rem;
  }

  announcement-bar.is-ready .announcement:not(.is-active) {
    visibility: hidden;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    announcement-bar.is-ready .announcement {
      transition:
        opacity 0.4s ease,
        visibility 0.4s;
    }
  }

  .announcement__text {
    margin: 0;
    color: inherit;
  }

  .announcement__link {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentcolor 40%, transparent);
    text-underline-offset: 0.25em;
  }

  .announcement__link:hover {
    text-decoration-color: currentcolor;
  }

  .announcement__link:focus-visible,
  .announcement-bar__arrow:focus-visible {
    outline: 2px solid currentcolor;
    outline-offset: 2px;
  }

  .announcement-bar__arrow {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.7;
  }

  .announcement-bar__arrow:hover {
    opacity: 1;
  }

  .announcement-bar__arrow .icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  [dir='rtl'] .announcement-bar__arrow .icon {
    transform: scaleX(-1);
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Announcement bar: one message at a time with arrows. Rotates on a timer
   * that pauses on hover and keyboard focus, and doesn't run for shoppers
   * who prefer reduced motion.
   */
  class AnnouncementBar extends HTMLElement {
    connectedCallback() {
      this.resizeObserver = new ResizeObserver(() => {
        document.documentElement.style.setProperty('--announcement-height', `${this.offsetHeight}px`);
      });
      this.resizeObserver.observe(this);

      this.items = [...this.querySelectorAll('[data-announcement]')];
      if (this.items.length < 2) return;
      this.index = 0;
      this.speed = Number(this.dataset.speed) || 5000;
      this.autoplay = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.querySelector('[data-prev]')?.addEventListener('click', () => this.show(this.index - 1));
      this.querySelector('[data-next]')?.addEventListener('click', () => this.show(this.index + 1));
      this.addEventListener('mouseenter', () => this.pause(true));
      this.addEventListener('mouseleave', () => this.pause(false));
      this.addEventListener('focusin', () => this.pause(true));
      this.addEventListener('focusout', () => this.pause(false));
      this.addEventListener('shopify:block:select', (event) => {
        this.editorPaused = true;
        this.show(this.items.indexOf(event.target));
      });
      this.addEventListener('shopify:block:deselect', () => {
        this.editorPaused = false;
        this.schedule();
      });

      this.show(0);
      this.classList.add('is-ready');
    }

    disconnectedCallback() {
      clearTimeout(this.timer);
      this.resizeObserver?.disconnect();
      document.documentElement.style.removeProperty('--announcement-height');
    }

    show(index) {
      const count = this.items.length;
      this.index = ((index % count) + count) % count;
      this.items.forEach((item, i) => {
        const active = i === this.index;
        item.classList.toggle('is-active', active);
        item.inert = !active;
        item.setAttribute('aria-hidden', String(!active));
      });
      this.schedule();
    }

    pause(paused) {
      this.paused = paused;
      this.schedule();
    }

    schedule() {
      clearTimeout(this.timer);
      if (!this.autoplay || this.paused || this.editorPaused) return;
      this.timer = setTimeout(() => this.show(this.index + 1), this.speed);
    }
  }

  if (!customElements.get('announcement-bar')) {
    customElements.define('announcement-bar', AnnouncementBar);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "aside",
  "class": "announcement-bar-section",
  "blocks": [{ "type": "_announcement" }],
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:sections.announcement_bar.speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.name",
      "blocks": [
        { "type": "_announcement", "settings": { "text": "Free insured shipping on orders over $150" } },
        { "type": "_announcement", "settings": { "text": "Free engraving on every piece" } }
      ]
    }
  ]
}
{% endschema %}
