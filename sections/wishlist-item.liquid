{%- comment -%}
  One wishlist product card. Not added to templates: the wishlist page
  fetches it per saved product with `/products/<handle>?section_id=wishlist-item`.
{%- endcomment -%}

<li class="product-grid__item" data-wishlist-item="{{ product.handle }}">
  {% render 'product-card',
    product: product,
    show_secondary_image: true,
    sizes: '(min-width: 990px) 25vw, 50vw'
  %}
</li>

{% schema %}
{
  "name": "t:sections.wishlist.item",
  "settings": []
}
{% endschema %}
